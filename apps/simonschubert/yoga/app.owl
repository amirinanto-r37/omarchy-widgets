app "yoga" {
  meta { owl: 8; description: "Guided, spoken yoga sessions with a timer for every pose: 26 sessions, 48 poses with how-tos and benefits, a daily streak and levels. No account needed."; version: "1.0"; license: "MIT"; category: "home" }
  title: "yoga"
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="24" cy="13" r="3.5"/>
    <path d="M22 3.5L13 13l11 7 11-7-9-9.5"/>
    <path d="M24 20v25M24 31l9 4-8 4"/>
  </svg>"""

  // A port of YogaBase (github.com/SimonSchubert/YogaBase), with its voice.
  source now = clock every 1s

  // Progress, kept by the launcher: finished session ids, the daily streak and XP.
  state done = [] persist
  state streak = 0 persist
  state lastDay = "" persist
  state xp = 0 persist
  state pace = 1 persist
  state voice = true persist

  state view = "menu"
  state tab = "sessions"
  state sid = 1
  state pid = 1
  // A session runs intro → hold → gap → hold … → finish; at endsAt moves it on.
  state phase = "intro"
  state step = ""
  state idx = 0
  state endsAt = 0
  state paused = false
  state left = 0
  state quitting = false
  state gained = 0

  // Generated from YogaBase's poses.json and categories.json.
  let poses = [
    {id: 1, name: "Boat", sanskrit: "Nāvāsana", plain: "Navasana", translation: "nāva = boat, āsana = posture", description: "Sit with legs extended. Exhale, lift legs to 45 degrees, lean back slightly. Extend arms forward, palms facing. Balance on sit bones, engage core. Gaze at toes, breathe.", benefits: "Strengthens the abdomen, hip flexors, and spine. Stimulates the kidneys, thyroid and prostate glands, and intestines. Helps relieve stress. Improves digestion.", level: "intermediate", time: 45, sides: false},
    {id: 2, name: "Half Boat", sanskrit: "Ardha Nāvāsana", plain: "Ardha Navasana", translation: "ardha = half, nāva = boat, āsana = posture", description: "Sit, knees bent, feet lifted. Lean back slightly, hold behind thighs or extend arms. Balance, engage core, gaze forward, breathe.", benefits: "Strengthens the abdomen, hip flexors and spine. Stimulates the kidneys, thyroid, prostate glands and intestines. Helps relieve stress. Improves digestion.", level: "intermediate", time: 45, sides: false},
    {id: 3, name: "Bow", sanskrit: "Dhanurāsana", plain: "Dhanurasana", translation: "dhanur = bow, āsana = posture", description: "Lie on stomach. Bend knees, grab ankles. Inhale, lift chest and thighs, press feet into hands. Gaze forward, breathe.", benefits: "Stretches the entire front of the body, ankles, thighs and groins, abdomen and chest, and throat, and deep hip flexors (psoas). Strengthens the back muscles. Improves posture. Stimulates the organs of the abdomen and neck.", level: "intermediate", time: 45, sides: false},
    {id: 4, name: "Bridge", sanskrit: "Setu Bandha Sarvāṅgāsana", plain: "Setu Bandha Sarvangasana", translation: "setu = bridge, bandha = lock, sarva = all, āṅga = limb, āsana = posture", description: "Lie on back, knees bent, feet hip-width. Inhale, lift hips, clasp hands under back. Roll shoulders under, lift chest. Gaze up, breathe.", benefits: "Stretches the chest, neck, and spine. Stimulates abdominal organs, lungs, and thyroids. Rejuvenates tired legs. Improves digestion. Helps relieve the symptoms of menopause. Relieves menstrual discomfort when done supported. Reduces anxiety, fatigue, backache, headache, and insomnia. Therapeutic for asthma, high blood pressure, osteoporosis, and sinusitis.", level: "beginner", time: 60, sides: false},
    {id: 5, name: "Butterfly", sanskrit: "Baddha Koṇāsana", plain: "Baddha Konasana", translation: "baddha = bound, koṇa = angle, āsana = posture", description: "Sit with soles together, knees out. Hold feet, sit tall. Relax shoulders, breathe deeply.", benefits: "Opens the hips and groins. Stretches the shoulders, rib cage and back. Stimulates the abdominal organs, lungs and heart.", level: "beginner", time: 60, sides: false},
    {id: 6, name: "Camel", sanskrit: "Uṣṭrāsana", plain: "Ustrasana", translation: "uṣṭra = camel, āsana = posture", description: "Kneel, hands on lower back. Inhale, lift chest, reach for heels if comfortable. Keep neck neutral, gaze forward, breathe.", benefits: "Stretches the entire front of the body, the ankles, thighs and groins, abdomen and chest, and throat. Stretches the deep hip flexors (psoas). Strengthens back muscles. Improves posture. Stimulates the organs of the abdomen and neck.", level: "intermediate", time: 45, sides: false},
    {id: 7, name: "Cat", sanskrit: "Marjaryāsana", plain: "Marjaryasana", translation: "marjarya = cat, āsana = posture", description: "On hands and knees. Exhale, round spine up, tuck chin. Engage core, gaze at belly, breathe.", benefits: "Relieves the spine and neck. Energizes the body.", level: "beginner", time: 60, sides: false},
    {id: 8, name: "Cow", sanskrit: "Bitilāsana", plain: "Bitilasana", translation: "bitil = cow, āsana = posture", description: "On hands and knees. Inhale, arch spine down, lift tailbone and chest. Gaze up, breathe.", benefits: "Removes fatigue. Improves breathing and the circulation of blood to the brain. Rejuvenates the entire body.", level: "beginner", time: 60, sides: false},
    {id: 9, name: "Chair", sanskrit: "Utkaṭāsana", plain: "Utkatasana", translation: "utkaṭa = fierce, āsana = posture", description: "Stand, feet together. Inhale, bend knees as if sitting, lift arms overhead. Weight in heels, gaze forward, breathe.", benefits: "Strengthens the ankles, thighs, calves, and spine. Stretches shoulders and chest. Stimulates the abdominal organs, diaphragm, and heart. Reduces flat feet. Energizes the entire body.", level: "beginner", time: 60, sides: false},
    {id: 10, name: "Child's Pose", sanskrit: "Balāsana", plain: "Balasana", translation: "bala = child, āsana = posture", description: "Kneel, toes together, knees apart. Exhale, fold forward, arms extended. Forehead on mat, relax, breathe.", benefits: "Gently stretches the hips, thighs, and ankles. Calms the brain and helps relieve stress and fatigue. Relieves back and neck pain when done with head and torso supported.", level: "beginner", time: 60, sides: false},
    {id: 11, name: "Corpse", sanskrit: "Śavāsana", plain: "Sivasana", translation: "śava = corpse, āsana = posture", description: "Lie on back, legs extended, arms by sides, palms up. Close eyes, relax completely, breathe deeply.", benefits: "Calms the brain and helps relieve stress and mild depression. Relaxes the body. Reduces headache, fatigue, and insomnia. Helps to lower blood pressure.", level: "beginner", time: 60, sides: false},
    {id: 12, name: "Crescent Lunge", sanskrit: "Ashta Chandrāsana", plain: "Alanasana", translation: "ashta = side, chandra = moon, āsana = posture", description: "Step one foot forward, lunge. Back knee down or lifted. Inhale, lift arms overhead. Sink hips, gaze forward, breathe.", benefits: "Stretches the rib cage, arms and torso. Tones the oblique muscles.", level: "beginner", time: 120, sides: true},
    {id: 13, name: "Crow", sanskrit: "Bakāsana", plain: "Bakasana", translation: "baka = crane, āsana = posture", description: "Squat, hands on mat, shoulder-width. Knees on upper arms. Exhale, shift forward, lift feet. Balance, gaze forward, breathe.", benefits: "Strengthens arms and wrists. Stretches the upper back. Strengthens the abdominal muscles. Opens the groin. Tones the abdominal organs.", level: "advanced", time: 30, sides: false},
    {id: 14, name: "Dolphin", sanskrit: "Pīñcha Mayūrāsana", plain: "Ardha Pincha Mayurasana", translation: "pīñcha = feather, mayūra = peacock, āsana = posture", description: "From Downward Dog, lower to forearms, elbows under shoulders. Lift hips, press heels down. Engage core, gaze between hands, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Energizes the body. Stretches the shoulders, hamstrings, calves, arches, and hands. Strengthens the arms and legs. Helps relieve the symptoms of menopause. Relieves menstrual discomfort when done with the head supported. Helps prevent osteoporosis. Improves digestion. Relieves headache, insomnia, back pain, and fatigue. Therapeutic for high blood pressure, asthma, flat feet, sciatica, and sinusitis. Warms up the ankles and the toes.", level: "intermediate", time: 45, sides: false},
    {id: 15, name: "Downward-Facing Dog", sanskrit: "Parivṛtta Adho Mukha Śvānāsana", plain: "Adho Mukha Svanasana", translation: "parivṛtta = revolved, adho = downward, mukha = facing, śvāna = dog, āsana = posture", description: "Hands and knees. Exhale, lift hips up and back. Straighten legs, press heels down. Lengthen spine, gaze between legs, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Energizes the body. Stretches the shoulders, neck, hamstrings, calves, arches, and hands. Strengthens the arms and legs. Helps relieve the symptoms of menopause. Relieves menstrual discomfort when done with the head supported. Helps prevent osteoporosis. Improves digestion. Relieves headache, insomnia, back pain, and fatigue. Therapeutic for high blood pressure, asthma, flat feet, sciatica, and sinusitis.", level: "beginner", time: 60, sides: false},
    {id: 16, name: "Eagle", sanskrit: "Garuḍāsana", plain: "Garudasana", translation: "garuḍa = eagle, āsana = posture", description: "Stand, cross right leg over left, hook foot behind calf. Cross left arm over right, press palms. Lift elbows, gaze forward, breathe.", benefits: "Strengthens and stretches the ankles and calves. Stretches the thighs, hips, shoulders, and upper back. Improves concentration. Improves sense of balance.", level: "intermediate", time: 90, sides: true},
    {id: 17, name: "Extended Hand to Toe", sanskrit: "Utthita Hasta Pādāṅguṣṭhāsana", plain: "Utthita Hasta Padangusthasana", translation: "utthita = extended, hasta = hand, pādāṅguṣṭha = big toe, āsana = posture", description: "Stand, lift right leg, hold big toe with right hand. Extend leg forward, hips squared. Gaze forward, breathe.", benefits: "Opens the hips and groins. Stretches the hamstrings, IT bands and legs. Improves balance.", level: "intermediate", time: 90, sides: true},
    {id: 18, name: "Extended Side Angle", sanskrit: "Utthita Pārśvakoṇāsana", plain: "Utthita Parsvakonasana", translation: "utthita = extended, pārśva = side, koṇa = angle, āsana = posture", description: "From Warrior II, bend front knee deeper. Reach front arm overhead, back hand on leg or floor. Open chest, gaze up, breathe.", benefits: "Strengthens and stretches the legs, knees, and ankles. Stretches the groin, spine, waist, chest, lungs, and shoulders. Stimulates abdominal organs. Increases stamina.", level: "intermediate", time: 90, sides: true},
    {id: 19, name: "Forearm Stand", sanskrit: "Pīñcha Mayūrāsana", plain: "Pincha Mayurasana", translation: "pīñcha = feather, mayūra = peacock, āsana = posture", description: "From Dolphin, walk feet closer. Exhale, lift legs one at a time, balance on forearms. Engage core, gaze forward, breathe.", benefits: "Strengthens arms and shoulders. Improves focus and balance. Stretches the upper and lower back. Strengthens the abdominal muscles. Tones the abdominal area.", level: "advanced", time: 30, sides: false},
    {id: 20, name: "Forward Bend with Shoulder Opener", sanskrit: "Uttānāsana", plain: "Uttanasana", translation: "uttāna = stretch out, āsana = posture", description: "Stand, fold forward, interlace hands behind back. Lift arms gently, relax head. Gaze down, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stimulates the liver and kidneys. Stretches the hamstrings, calves, and hips. Strengthens the thighs and knees. Improves digestion. Helps relieve the symptoms of menopause. Reduces fatigue and anxiety. Relieves headache and insomnia. Opens the shoulders.", level: "intermediate", time: 45, sides: false},
    {id: 21, name: "Half-Moon", sanskrit: "Ardha Chandrāsana", plain: "Ardha Chandrasana", translation: "ardha = half, chandra = moon, āsana = posture", description: "From Warrior III, hand on floor beside front foot. Lift back leg parallel, extend opposite arm up. Open hips, gaze up or down, breathe.", benefits: "Strengthens the abdomen, ankles, thighs, buttocks and spine. Stretches the groins, hamstrings, calves, shoulders, chest and spine. Improves coordination and sense of balance. Helps relieve stress. Improves digestion.", level: "intermediate", time: 90, sides: true},
    {id: 22, name: "Handstand", sanskrit: "Adho Mukha Vṛkṣāsana", plain: "Adho Mukha Vrksasana", translation: "adho = downward, mukha = facing, vṛkṣa = tree, āsana = posture", description: "From Downward Dog, walk feet closer. Shift weight, kick legs up, straighten. Engage core, gaze forward, breathe.", benefits: "Strengthens the shoulders, arms and wrists. Stretches the belly. Improves sense of balance. Calms the brain and helps relieve stress and mild depression.", level: "advanced", time: 30, sides: false},
    {id: 23, name: "Low Lunge", sanskrit: "Aṅjaneyāsana", plain: "Anjaneyasana", translation: "aṅjaneya = praise, āsana = posture", description: "Step right foot forward, lunge. Lower left knee, hands on thigh or overhead. Sink hips, gaze forward, breathe.", benefits: "Stretches the chest, lungs, neck, belly and groin (psoas). Strengthens the shoulders, arms and back muscles. Strengthens and stretches the thighs, calves and ankles.", level: "beginner", time: 120, sides: true},
    {id: 24, name: "Pigeon", sanskrit: "Supta Kapotāsana", plain: "Supta Kapotasana", translation: "supta = supine, kapota = pigeon, āsana = posture", description: "Lie on back, cross right ankle over left knee. Pull left knee to chest. Keep back grounded, gaze up, breathe.", benefits: "Stretches the hamstrings and quads. If the elbow is used to push the thigh, it opens the hips as well.", level: "intermediate", time: 90, sides: true},
    {id: 25, name: "King Pigeon", sanskrit: "Eka Pāda Rājakapotāsana", plain: "Eka Pada Rajakapotasana", translation: "eka = one, pāda = foot or leg, rāja = king, kapota = pigeon, āsana = posture", description: "From Pigeon, bend back knee, grab foot with hand. Lift chest, open heart. Gaze forward, breathe.", benefits: "Stretches the thighs, groins (psoas), abdomen, chest, shoulders and neck. Stimulates the abdominal organs. Opens the shoulders and chest.", level: "advanced", time: 60, sides: true},
    {id: 26, name: "Plank", sanskrit: "Phalakāsana", plain: "Phalakasana", translation: "phalaka = plank, āsana = posture", description: "Hands and knees, step feet back. Body straight, hands under shoulders. Engage core, gaze down, breathe.", benefits: "Strengthens the arms, wrists, and spine. Tones the abdomen.", level: "beginner", time: 60, sides: false},
    {id: 27, name: "Plow", sanskrit: "Halāsana", plain: "Halasana", translation: "hala = plow, āsana = posture", description: "Lie on back. Exhale, lift legs over head, toes to floor behind. Support back or clasp hands. Gaze inward, breathe.", benefits: "Calms the brain. Stimulates the abdominal organs and the thyroid glands. Stretches the shoulders and spine. Helps relieve the symptoms of menopause. Reduces stress and fatigue. Therapeutic for backache, headache, infertility, insomnia, and sinusitis.", level: "advanced", time: 30, sides: false},
    {id: 28, name: "Pyramid", sanskrit: "Pārśvottānāsana", plain: "Parsvottanasana", translation: "pārśva = side, uttāna = stretch out, āsana = posture", description: "Step right foot forward, left back. Hinge at hips, fold over front leg. Hands on floor or blocks. Gaze down, breathe.", benefits: "Calms the brain. Stretches the spine, the shoulders, the hips and the hamstrings. Strengthens the legs. Stimulates the abdominal organs. Improves posture and sense of balance. Improves digestion.", level: "intermediate", time: 90, sides: true},
    {id: 29, name: "Reverse Warrior", sanskrit: "Pārśva Vīrabhadrāsana", plain: "Parsva Virabhadrasana", translation: "pārśva = side, vīrabhadra = warrior, āsana = posture", description: "From Warrior II, reach front arm overhead and back. Slide back hand down leg. Open chest, gaze up, breathe.", benefits: "Strengthens and stretches the legs, knees, and ankles. Stretches the groin, spine, waist, chest, lungs, and shoulders. Stimulates abdominal organs. Increases stamina. Relieves backaches, especially through second trimester of pregnancy. Therapeutic for carpal tunnel syndrome, flat feet, infertility, osteoporosis, and sciatica.", level: "intermediate", time: 90, sides: true},
    {id: 30, name: "Seated Forward Bend", sanskrit: "Paśchimottānāsana", plain: "Paschimottanasana", translation: "paśchima = back, uttāna = stretch out, āsana = posture", description: "Sit, legs extended. Inhale, lengthen spine. Exhale, fold forward, reach for feet or shins. Keep spine long, gaze forward, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stretches the spine, shoulders and hamstrings. Stimulates the liver, kidneys, ovaries and uterus. Improves digestion. Helps relieve the symptoms of menopause and menstrual discomfort. Soothes headache and anxiety. Reduces fatigue. Therapeutic for high blood pressure, infertility, insomnia and sinusitis. Traditional texts say that Paschimottanasana increases appetite, reduces obesity and cures diseases.", level: "intermediate", time: 45, sides: false},
    {id: 31, name: "Lotus", sanskrit: "Padmāsana", plain: "Padmasana", translation: "padma = lotus, āsana = posture", description: "Sit, place right foot on left thigh, left foot on right. Hands on knees, sit tall, breathe.", benefits: "Opens the hips, groin and stretches the knees, ankles and thighs. Strengthens the back and calms the mind, reduces stress and anxiety. Improves circulation and blood flow in the pelvis.", level: "intermediate", time: 45, sides: false},
    {id: 32, name: "Half Lord of the Fishes", sanskrit: "Ardhā Matsyendrāsana", plain: "Ardha Matsyendrasana", translation: "ardha = half, matsya = fish, indra = king", description: "Sit, cross right knee over left, twist right. Left elbow outside right knee, right hand behind. Gaze over shoulder, breathe.", benefits: "Stretches the shoulders, the chest, the thighs, the groins, and the abdomen. Strengthens the legs and the ankles. Improves balance.", level: "intermediate", time: 90, sides: true},
    {id: 33, name: "Shoulder Stand", sanskrit: "Sālamba Sarvāṅgāsana", plain: "Salamba Sarvangasana", translation: "sa = with, ālamba = support, sarvāṅga = all limb, āsana = posture", description: "Lie on back. Exhale, lift legs and hips up, support back with hands. Straighten legs, gaze inward, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stimulates the thyroid and prostate glands and abdominal organs. Stretches the shoulders and neck. Tones the legs and buttocks. Improves digestion. Helps relieve the symptoms of menopause. Reduces fatigue and alleviates insomnia. Therapeutic for asthma, infertility, and sinusitis.", level: "advanced", time: 30, sides: false},
    {id: 34, name: "Side Plank", sanskrit: "Vasiṣṭhāsana", plain: "Vasisthasana", translation: "vasiṣṭha = name of a sage, āsana = posture", description: "From Plank, roll onto outer right foot. Stack feet, lift left arm up. Engage core, gaze up, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stretches the shoulders, hamstrings, calves, and arches. Strengthens the arms and legs. Helps relieve the symptoms of menopause. Helps prevent osteoporosis. Improves digestion. Relieves headache, insomnia, back pain, and fatigue. Therapeutic for high blood pressure, asthma, flat feet, sciatica.", level: "intermediate", time: 90, sides: true},
    {id: 35, name: "Sphinx", sanskrit: "Sālamba Bhujaṅgāsana", plain: "Salamba Bhujangasana", translation: "sālamba = supported, bhujaṅga = serpent, āsana = posture", description: "Lie on stomach, forearms on mat, elbows under shoulders. Inhale, lift chest, press shoulders down. Gaze forward, breathe.", benefits: "Strengthens the spine. Stretches the chest, the lungs, the shoulders and the abdomen. Stimulates the abdominal organs. Opens the heart and the lungs.", level: "beginner", time: 60, sides: false},
    {id: 36, name: "Splits", sanskrit: "Hanumānāsana", plain: "Hanumanasana", translation: "hanumān = monkey deity, āsana = posture", description: "From Lunge, slide front foot forward, back foot back. Lower hips, keep squared. Hands on floor or blocks. Gaze forward, breathe.", benefits: "Stretches the thighs, hamstrings, and groin. Stimulates the abdominal organs.", level: "advanced", time: 60, sides: true},
    {id: 37, name: "Garland Pose", sanskrit: "Mālāsana", plain: "Malasana", translation: "mālā = garland or necklace, āsana = posture", description: "Squat, feet together or apart. Elbows inside knees, palms at heart. Push knees out, sink hips, gaze forward, breathe.", benefits: "Stretches the ankles, groins and back torso. Tones the belly.", level: "intermediate", time: 45, sides: false},
    {id: 38, name: "Standing Forward Bend", sanskrit: "Uttānāsana", plain: "Uttanasana", translation: "uttāna = stretch out, āsana = posture", description: "Stand, fold forward, hands to floor or shins. Keep spine long, head heavy. Gaze down, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stimulates the liver and kidneys. Stretches the hamstrings, calves, and hips. Strengthens the thighs and knees. Improves digestion. Helps relieve the symptoms of menopause. Reduces fatigue and anxiety. Relieves headache and insomnia.", level: "beginner", time: 60, sides: false},
    {id: 39, name: "Crescent Moon", sanskrit: "Ashta Chandrāsana", plain: "Ashta Chandrasana", translation: "ashta = side, chandra = moon, āsana = posture", description: "Stand, clasp hands overhead. Inhale, lean to one side, stretch opposite side. Gaze up, breathe.", benefits: "Stretches the rib cage, arms and torso. Tones the oblique muscles.", level: "intermediate", time: 90, sides: true},
    {id: 40, name: "Side Splits", sanskrit: "Upaviṣṭha Koṇāsana", plain: "Upavistha Konasana", translation: "upaviṣṭha = seated, koṇa = angle, āsana = posture", description: "Sit, legs wide. Exhale, walk hands forward, lower torso. Keep spine long, gaze down, breathe.", benefits: "Stretches the insides and backs of the legs. Stimulates the abdominal organs. Strengthens the spine. Calms the brain. Releases groin.", level: "advanced", time: 30, sides: false},
    {id: 41, name: "Tree", sanskrit: "Vṛkṣāsana", plain: "Vrksasana", translation: "vṛkṣa = tree, āsana = posture", description: "Stand, place right foot on left thigh or calf. Palms together overhead or at chest. Balance, gaze forward, breathe.", benefits: "Strengthens the legs, ankles, and feet. Improves flexibility in the hips and knees. Improves balance.", level: "beginner", time: 120, sides: true},
    {id: 42, name: "Triangle", sanskrit: "Trikoṇāsana", plain: "Trikonasana", translation: "trikoṇa = triangle, āsana = posture", description: "Stand wide, turn right foot out. Reach right hand down to shin or floor, left arm up. Open chest, gaze up, breathe.", benefits: "Stretches and strengthens the thighs, knees, and ankles. Stretches the hips, groin, hamstrings, calves, shoulders, chest, and spine. Stimulates the abdominal organs. Helps relieve stress. Improves digestion. Helps relieve the symptoms of menopause. Relieves backache, especially through second trimester of pregnancy. Therapeutic for anxiety, flat feet, infertility, neck pain, osteoporosis, and sciatica.", level: "beginner", time: 120, sides: true},
    {id: 43, name: "Upward-Facing Dog", sanskrit: "Ūrdhva Mukha Śvānāsana", plain: "Urdhva Mukha Svsnssana", translation: "ūrdhva = upward, mukha = facing, śvāna = dog, āsana = posture", description: "Lie on stomach, hands by shoulders. Inhale, lift chest and thighs, roll shoulders back. Gaze forward, breathe.", benefits: "Improves posture. Strengthens the spine, arms, and wrists. Stretches the chest, lungs, shoulders, and abdomen. Firms the buttocks. Stimulates abdominal organs. Helps relieve mild depression, fatigue, and sciatica. Therapeutic for asthma.", level: "beginner", time: 60, sides: false},
    {id: 44, name: "Warrior One", sanskrit: "Vīrabhadrāsana I", plain: "Virabhadrasana One", translation: "vīrabhadra = warrior, āsana = posture", description: "Step left foot back, bend right knee to 90 degrees. Lift arms overhead, sink hips. Gaze forward, breathe.", benefits: "Stretches the chest, lungs, shoulders, neck, belly and groin (psoas). Strengthens the shoulders, arms and back muscles. Strengthens and stretches the thighs, calves and ankles.", level: "beginner", time: 120, sides: true},
    {id: 45, name: "Warrior Two", sanskrit: "Vīrabhadrāsana II", plain: "Virabhadrasana Two", translation: "vīrabhadra = warrior, āsana = posture", description: "Step left foot back, bend right knee to 90 degrees. Arms parallel, sink hips. Gaze over right hand, breathe.", benefits: "Strengthens and stretches the legs and ankles. Stretches the groin, chest, lungs, and shoulders. Stimulates abdominal organs. Increases stamina. Relieves backaches, especially through second trimester of pregnancy. Therapeutic for carpal tunnel syndrome, flat feet, infertility, osteoporosis, and sciatica.", level: "beginner", time: 120, sides: true},
    {id: 46, name: "Warrior Three", sanskrit: "Vīrabhadrāsana III", plain: "Virabhadrasana Three", translation: "vīrabhadra = warrior, āsana = posture", description: "Stand, shift to right leg. Lift left leg back parallel, arms forward or sides. Balance, gaze down, breathe.", benefits: "Strengthens the ankles and legs. Strengthens the shoulders and muscles of the back. Tones the abdomen. Improves balance and posture.", level: "intermediate", time: 90, sides: true},
    {id: 47, name: "Wheel", sanskrit: "Ūrdhva Dhanurāsana", plain: "Urdhva Dhanurasana", translation: "ūrdhva = upward, dhanu = bow, āsana = posture", description: "Lie on your back with knees bent and hands placed by your ears. Exhale, then lift your hips and chest to form an arch. Gaze upward and breathe steadily.", benefits: "Strengthens the arms, wrists, legs, buttocks, abs, and spine. Stimulates the thyroid and pituitary glands. Boosts energy, helps counteract depression, and offers therapeutic benefits for asthma, back pain, infertility, and osteoporosis.", level: "advanced", time: 30, sides: false},
    {id: 48, name: "Wild Thing", sanskrit: "Camatkārāsana", plain: "Camatkarasana", translation: "camatkāra = struck with wonder, āsana = posture", description: "Start in Downward Dog, then lift your right leg and open your hips. Place your right hand beside your front foot, lift your left arm, arch your back, gaze upward, and breathe deeply.", benefits: "Stretches the chest, shoulders, back, and throat. Strengthens and opens the hips, hip flexors, and thighs.", level: "advanced", time: 60, sides: true}
  ]
  let sessions = [
    {id: 1, name: "Gentle Beginner Flow", description: "A soothing sequence for beginners to ease into yoga with foundational poses and breath focus.", level: "beginner", poses: [4, 7, 10, 11, 35]},
    {id: 2, name: "Morning Wake-Up", description: "A beginner-friendly sequence to energize and stretch the body for the day ahead.", level: "beginner", poses: [5, 12, 15, 38, 41, 43, 45]},
    {id: 3, name: "Restful Basics", description: "A calming beginner sequence to relax and restore with gentle poses.", level: "beginner", poses: [10, 11, 24]},
    {id: 26, name: "Beginner's Blissful Flow", description: "A comprehensive beginner sequence that flows harmoniously through warm-up, standing strength and balance poses, gentle backbends, forward folds, hip openers, and restorative poses to build a well-rounded foundation.", level: "beginner", poses: [11, 7, 8, 15, 26, 43, 23, 12, 44, 45, 42, 9, 41, 43, 4, 35, 5, 10, 11]},
    {id: 4, name: "Balanced Foundations", description: "A beginner sequence to build balance and strength with standing and seated poses.", level: "beginner", poses: [9, 12, 26, 41, 42, 44, 45, 7, 8]},
    {id: 5, name: "Core and Stretch", description: "A beginner sequence to strengthen the core and improve flexibility with simple poses.", level: "beginner", poses: [4, 7, 8, 26, 35, 43]},
    {id: 6, name: "Intermediate Core Strength", description: "A dynamic intermediate sequence to build core stability and strength.", level: "intermediate", poses: [1, 2, 14, 34, 46]},
    {id: 7, name: "Hip Opening Flow", description: "An intermediate sequence to deeply stretch and open the hips for greater flexibility.", level: "intermediate", poses: [5, 17, 24, 31, 37, 20, 28, 30, 32]},
    {id: 8, name: "Twist and Energize", description: "An intermediate twisting sequence to detoxify and boost energy levels.", level: "intermediate", poses: [6, 14, 18, 29, 32]},
    {id: 9, name: "Balance Challenge", description: "An intermediate sequence to enhance balance and coordination with standing poses.", level: "intermediate", poses: [16, 17, 21, 28, 46, 34, 1]},
    {id: 10, name: "Vigorous Flow", description: "A high-energy intermediate flow to build endurance and strength through dynamic transitions.", level: "intermediate", poses: [14, 18, 20, 29, 30, 34, 46, 6, 16, 21]},
    {id: 11, name: "Heart Opening Sequence", description: "An intermediate sequence to open the chest and strengthen the back with backbends.", level: "intermediate", poses: [6, 14, 18, 20, 29]},
    {id: 12, name: "Core and Stability", description: "An intermediate sequence blending core work and balancing poses for overall stability.", level: "intermediate", poses: [1, 2, 16, 21, 34, 46, 17, 28]},
    {id: 13, name: "Seated Flexibility", description: "An intermediate sequence of seated poses to deepen hip and hamstring flexibility.", level: "intermediate", poses: [5, 24, 30, 31, 32, 37]},
    {id: 14, name: "Warrior Power", description: "An intermediate sequence focusing on warrior poses to build strength and confidence.", level: "intermediate", poses: [18, 29, 46, 21, 16, 34]},
    {id: 15, name: "Energy and Balance", description: "An energizing intermediate sequence to boost vitality and improve balance.", level: "intermediate", poses: [6, 16, 17, 21, 28, 29, 34, 46, 1, 14]},
    {id: 16, name: "Advanced Core Intensive", description: "An advanced sequence to intensely target core strength with challenging poses.", level: "advanced", poses: [1, 13, 19, 22, 33]},
    {id: 17, name: "Inversion Exploration", description: "An advanced sequence to master inversions, building strength and control.", level: "advanced", poses: [13, 19, 22, 27, 33, 47, 48]},
    {id: 18, name: "Flexibility Extreme", description: "An advanced sequence to push flexibility boundaries with deep stretches and splits.", level: "advanced", poses: [25, 36, 40, 27, 33, 24, 31]},
    {id: 19, name: "Arm Balance Mastery", description: "An advanced sequence focusing on arm balances to strengthen the upper body.", level: "advanced", poses: [13, 19, 22, 34, 47, 48]},
    {id: 20, name: "Deep Backbends", description: "An advanced sequence to deepen backbends, opening the chest and spine.", level: "advanced", poses: [6, 25, 47, 48, 27, 33, 19, 13, 22]},
    {id: 21, name: "Ultimate Flow", description: "A comprehensive advanced flow combining strength, balance, and flexibility.", level: "advanced", poses: [13, 19, 22, 25, 36, 40, 47, 48, 27, 33]},
    {id: 22, name: "Precision and Power", description: "An advanced sequence emphasizing precise alignment and powerful poses.", level: "advanced", poses: [13, 19, 22, 27, 33, 36]},
    {id: 23, name: "Hip and Heart Intensive", description: "An advanced sequence to deeply open hips and heart for flexibility and emotional release.", level: "advanced", poses: [25, 36, 40, 47, 48, 24]},
    {id: 24, name: "Strength and Control", description: "An advanced sequence to build strength and control with challenging poses.", level: "advanced", poses: [13, 19, 22, 34, 46, 47, 48, 1, 27]},
    {id: 25, name: "Yoga Mastery", description: "An advanced sequence to challenge strength, balance, and flexibility for seasoned practitioners.", level: "advanced", poses: [13, 19, 22, 25, 27, 33, 36, 47, 48]}
  ]
  // YogaBase's pose art as SVGs, at a fixed commit so later changes there can't break this app.
  let art = "https://raw.githubusercontent.com/SimonSchubert/YogaBase/8a50380bb6843a7db39d8916b8bfef2eaaa2bb85/media/poses/pose_"
  // Its voice: N.mp3 reads pose N, plus start_01-03, switch_side and congratulations.
  let voiceUrl = "https://raw.githubusercontent.com/SimonSchubert/YogaBase/8a50380bb6843a7db39d8916b8bfef2eaaa2bb85/composeApp/src/commonMain/composeResources/files/audio/"

  let today = fmtTime(now ?? 0, "yyyy-MM-dd")
  let yesterday = fmtTime((now ?? 0) - 86400, "yyyy-MM-dd")
  let days = lastDay == today || lastDay == yesterday ? streak : 0
  let level = floor(sqrt(xp / 50)) + 1
  let rank = level >= 50 ? "Master" : level >= 30 ? "Teacher" : level >= 20 ? "Devotee" : level >= 10 ? "Adept" : level >= 5 ? "Practitioner" : "Novice"
  let floorXp = 50 * (level - 1) * (level - 1)
  let ceilXp = 50 * level * level
  let paces = [{name: "swift", v: 0.5}, {name: "balanced", v: 1}, {name: "endurance", v: 2}]
  let order = ["beginner", "intermediate", "advanced"]

  let session = sessions.find(c => c.id == sid) ?? sessions[0]
  let run = session.poses
  let shown = phase == "gap" ? idx + 1 : idx
  let pose = poses[run[shown] - 1]
  let dur = round(pose.time * pace)
  let remaining = phase == "gap" ? dur : paused ? left : max(0, endsAt - (now ?? 0))
  let total = sum(run.map(id => round(poses[id - 1].time * pace))) + len(run) - 1
  let flipped = pose.sides && phase == "hold" && remaining <= dur / 2

  at endsAt {
    step = phase == "intro" || phase == "gap" ? "hold" : idx >= len(run) - 1 ? "finish" : "gap"
    endsAt = step == "finish" ? 0 : step == "gap" ? now + 1 : now + round(poses[run[phase == "gap" ? idx + 1 : idx] - 1].time * pace)
    idx = phase == "gap" ? idx + 1 : idx
    gained = step == "finish" && lastDay != today ? 50 : 0
    streak = step != "finish" || lastDay == today ? streak : lastDay == yesterday ? streak + 1 : 1
    xp = xp + gained
    lastDay = step == "finish" ? today : lastDay
    done = step == "finish" && !contains(done, sid) ? done + [sid] : done
    view = step == "finish" ? "finish" : view
    phase = step
    haptic()
    // The next pose read out, or congratulations; nothing between poses.
    sound(!voice ? null : step == "hold" ? "${voiceUrl}${run[idx]}.mp3" : step == "finish" ? "${voiceUrl}congratulations.mp3" : null)
  }
  // Halfway through a pose held on both sides: switch.
  when flipped {
    haptic()
    sound(voice ? "${voiceUrl}switch_side.mp3" : null)
  }

  // A pose as big as fits, mirrored for the second side.
  component Pose(id, mirror = false, cap = 1000) {
    Canvas {
      fill: true
      let s = min(min(width, height), cap)
      scale(mirror ? -1 : 1, 1, width / 2, height / 2) { image("${art}${id}.svg", (width - s) / 2, (height - s) / 2, s, s) }
    }
  }
  component Thumb(id, s = 40) {
    Box { size: s; Pose { id: id } }
  }
  component Tab(name) {
    Button { text: name; color: tab == name ? accent : muted; onTap: tab = name }
  }
  component Clock(secs, size = 56) {
    Text { text: "${floor(secs / 60)}:${pad(str(secs % 60), 2, "0")}"; fontSize: size; bold: true; font: mono; align: center }
  }

  Column {
    fill: true
    gap: 12
    if view == "menu" {
      if xp > 0 {
        Column {
          gap: 6
          padding: 12
          border: 1
          radius: 8 * corners
          Row {
            Text { text: "level ${level} · ${rank}"; bold: true; weight: 1 }
            Text { text: days == 1 ? "1 day streak" : "${days} day streak"; color: days > 0 ? accent : muted; width: 120; align: end }
          }
          Progress { value: xp - floorXp; max: ceilXp - floorXp }
          Text { text: "${xp} xp · ${ceilXp - xp} to level ${level + 1}"; style: small; color: muted }
        }
      }
      Row { gap: 4; Tab { name: "sessions" }  Tab { name: "poses" } }
      Column {
        scroll: true
        weight: 1
        gap: 10
        if tab == "sessions" {
          for c in sessions.sortBy(c => indexOf(order, c.level) * 100 + c.id) key c.id {
            Column {
              gap: 6
              padding: 12
              border: 1
              borderColor: contains(done, c.id) ? alpha(accent, 0.6) : border
              radius: 8 * corners
              onTap: { sid = c.id; view = "session"; phase = "intro"; idx = 0; paused = false; quitting = false; endsAt = now + 10; sound(voice ? "${voiceUrl}start_0${now % 3 + 1}.mp3" : null) }
              Row {
                Text { text: c.name; bold: true; weight: 1 }
                if contains(done, c.id) { Text { text: "done"; style: small; color: accent; width: 40; align: end } }
              }
              Text { text: c.description; style: small; color: muted; maxLines: 2 }
              Row {
                gap: 6
                height: 40
                for id in c.poses.take(7) { Thumb { id: id } }
                if len(c.poses) > 7 { Text { text: "+${len(c.poses) - 7}"; style: small; color: muted; width: 32 } }
              }
              Text { text: "${c.level} · ${len(c.poses)} poses · ${fmtDuration(sum(c.poses.map(id => round(poses[id - 1].time * pace))) + len(c.poses) - 1)}"; style: small; color: accent }
            }
          }
        } else {
          Grid {
            columns: 3
            gap: 10
            for p in poses.sortBy(p => p.name) key p.id {
              Column {
                gap: 2
                align: center
                onTap: { pid = p.id; view = "pose" }
                Thumb { id: p.id; s: 84 }
                Text { text: p.name; style: small; align: center; maxLines: 2 }
              }
            }
          }
        }
      }
    } else if view == "pose" {
      let p = poses[pid - 1]
      Row { Button { text: "← poses"; color: muted; onTap: view = "menu" } }
      Column {
        scroll: true
        weight: 1
        gap: 10
        Box { height: 220; fill: width; Pose { id: p.id } }
        Text { text: p.name; style: title; align: center }
        Text { text: p.sanskrit; italic: true; align: center }
        Text { text: p.translation; style: small; color: muted; align: center }
        Text { text: "${p.level} · hold ${replace(fmtDuration(round(p.time * pace)), " 0s", "")}${p.sides ? " · both sides" : ""}"; color: accent; align: center }
        Text { text: "how"; style: label; color: accent }
        Text { text: p.description }
        Text { text: "benefits"; style: label; color: accent }
        Text { text: p.benefits }
        let inSessions = sessions.filter(c => contains(c.poses, p.id))
        if len(inSessions) > 0 {
          Text { text: "in sessions"; style: label; color: accent }
          for c in inSessions key c.id {
            Row {
              onTap: { sid = c.id; view = "session"; phase = "intro"; idx = 0; paused = false; quitting = false; endsAt = now + 10; sound(voice ? "${voiceUrl}start_0${now % 3 + 1}.mp3" : null) }
              Text { text: c.name; weight: 1 }
              Text { text: "start ›"; color: accent; width: 60; align: end }
            }
          }
        }
      }
    } else if view == "session" && phase == "intro" {
      Column {
        weight: 1
        gap: 10
        align: center
        justify: center
        Text { text: "get ready"; style: label; color: muted; align: center }
        Text { text: session.name; style: title; align: center }
        Text { text: session.description; color: muted; align: center }
        Box { height: 200; fill: width; Pose { id: run[0] } }
        Text { text: "first: ${poses[run[0] - 1].name}"; style: small; color: muted; align: center }
        Text { text: "${max(0, endsAt - (now ?? 0))}"; fontSize: 64; bold: true; font: mono; color: accent; align: center }
        Row {
          gap: 6
          for pc in paces {
            Button { text: pc.name; color: pace == pc.v ? accent : muted; onTap: pace = pc.v }
          }
        }
        Text { text: "${len(run)} poses · ${fmtDuration(total)} at this pace"; style: small; color: muted; align: center }
      }
      Row {
        gap: 8
        Button { text: "back"; color: muted; onTap: { endsAt = 0; view = "menu"; sound("stop") } }
        Spacer { weight: 1 }
        Button { text: "start now"; onTap: endsAt = now }
      }
    } else if view == "session" {
      Row {
        Text { text: "${shown + 1} / ${len(run)} · ${session.name}"; style: small; color: muted; weight: 1; maxLines: 1 }
        Button { text: voice ? "voice on" : "voice off"; color: voice ? accent : muted; onTap: { voice = !voice; sound("stop") } }
      }
      Progress { value: phase == "gap" ? shown : shown + (dur - remaining) / max(dur, 1); max: len(run) }
      Box {
        weight: 1
        fill: width
        Box { fill: true; opacity: phase == "gap" ? 0.5 : 1; Pose { id: pose.id; mirror: flipped; cap: 300 } }
      }
      Text { text: pose.name; style: title; align: center }
      Text { text: pose.plain; color: muted; align: center; maxLines: 1 }
      Clock { secs: remaining }
      Text {
        text: phase == "gap" ? "next pose" : paused ? "paused" : remaining <= 3 && shown < len(run) - 1 ? "get ready for the next pose…" : pose.sides ? (flipped ? "second side" : "first side") : " "
        color: paused ? yellow : muted
        align: center
      }
      let upcoming = run.drop(shown + 1).take(6)
      Row {
        gap: 6
        height: 36
        fill: width
        justify: center
        if len(upcoming) == 0 { Text { text: "last pose"; style: small; color: muted; align: center } }
        for id, i in upcoming { Box { opacity: i == 0 ? 1 : 0.5; Thumb { id: id; s: 36 } } }
      }
      if quitting {
        Row {
          gap: 8
          Text { text: "quit this session?"; weight: 1 }
          Button { text: "keep going"; onTap: quitting = false }
          Button { text: "quit"; color: red; onTap: { endsAt = 0; paused = false; quitting = false; view = "menu"; sound("stop") } }
        }
      } else {
        Row {
          gap: 8
          Button { text: "quit"; color: muted; onTap: quitting = true }
          Spacer { weight: 1 }
          Button { text: paused ? "resume" : "pause"; onTap: { left = paused ? left : remaining; endsAt = paused ? now + left : 0; paused = !paused; sound(paused ? "stop" : null) } }
          Button { text: "skip"; onTap: { paused = false; endsAt = now } }
        }
      }
    } else {
      Column {
        weight: 1
        gap: 10
        align: center
        justify: center
        Box { height: 180; fill: width; Pose { id: run[len(run) - 1] } }
        Text { text: "great job"; style: huge; align: center }
        Text { text: session.name; color: muted; align: center }
        Text { text: days == 1 ? "1 day streak" : "${days} day streak"; style: title; color: accent; align: center }
        if gained > 0 { Text { text: "+${gained} xp"; bold: true; color: accent; align: center } }
        if gained > 0 && floor(sqrt((xp - gained) / 50)) + 1 < level { Text { text: "level ${level}: ${rank}"; bold: true; color: accent; align: center } }
        if gained == 0 { Text { text: "xp comes with the first session of the day"; style: small; color: muted; align: center } }
      }
      Row {
        gap: 8
        Button { text: "back to menu"; color: muted; onTap: { view = "menu"; sound("stop") } }
        Spacer { weight: 1 }
        Button { text: "again"; onTap: { view = "session"; phase = "intro"; idx = 0; paused = false; quitting = false; endsAt = now + 10; sound(voice ? "${voiceUrl}start_0${now % 3 + 1}.mp3" : null) } }
      }
    }
  }
}
