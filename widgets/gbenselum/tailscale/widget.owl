widget "tailscale" {
  page: 1
  order: 10
  size: 6x5
  minSize: 3x4

  meta { owl: 4; description: "List Tailscale peers, copy an IP or hostname, and open the Android app to toggle the VPN. Requires Tailscale installed and configured on this device."; version: "1.3"; license: "MIT"; category: "system" }

  requires { pacman: ["iproute2", "bind"] }

  // The VPN runs in the Tailscale app on Android, so the tunnel shows up here
  // as a tun interface; each tailnet node is a host route on it. Resolve the
  // names through MagicDNS: ask the guest resolver first (works once the
  // launcher publishes Android's network DNS, see omalauncher#20), and fall
  // back to asking 100.100.100.100 directly since the rootfs resolvers can't
  // reach it. Only /32 host routes are devices; a path like 100.64.0.0/10 is
  // a range, not a peer.
  source raw = cmd('ip -o -4 route show table all 2>/dev/null | grep "dev tun" | cut -d" " -f1 | grep -v / | sort -u | grep "^100." | grep -v "^100.100.100.100" | while read -r ip; do name=$(getent hosts "$ip" 2>/dev/null | tr -s " " | cut -d" " -f2); [ -z "$name" ] && name=$(dig +short +time=1 +tries=1 -x "$ip" @100.100.100.100 2>/dev/null | grep -v "^;" | head -1 | sed "s/\\.$//"); printf "%s %s\n" "$ip" "$name"; done') every 1m

  // A 100.x address on the tun interface means the VPN is up, even when this
  // phone is the only device online. The phone's own route is not a peer.
  source tun = cmd('ip -o -4 addr show 2>/dev/null | grep ": tun" | grep -oE "inet 100[.][0-9.]+" | cut -d" " -f2 | head -1') every 1m

  // The peer list from the last time the tunnel had one. While Tailscale
  // rebuilds the tunnel (it renames the tun interface and reinstalls the peer
  // routes), the host routes vanish for a moment, which would otherwise drop
  // the widget to "Only this device is online." Keep showing the last list,
  // marked as reconnecting.
  state lastPeers = "" persist

  let peers = lines(raw).map(l => words(l)).map(w => { ip: w[0], host: w[1] }).filter(p => p.ip != tun).sortBy(p => p.host ?? p.ip)
  let connected = words(tun).length > 0
  let cached = lines(lastPeers).map(l => words(l)).map(w => { ip: w[0], host: w[1] }).filter(p => p.ip && p.ip != tun).sortBy(p => p.host ?? p.ip)
  let shown = peers.length > 0 ? peers : cached
  let reconnecting = connected && peers.length == 0 && cached.length > 0
  let named = shown.filter(p => p.host)
  let tailnet = connected && named.length > 0 ? split(named[0].host, ".").drop(1).join(".") : null

  // Remember the peers whenever the tunnel reports some, so a reconnect has a
  // list to fall back to.
  when peers.length > 0 { lastPeers = raw }

  // Tapping the tile opens the Tailscale app; the VPN is switched there.
  onTap: androidApp("com.tailscale.ipn")

  // The Tailscale mark: a 3x3 dot grid, the T-shaped dots solid, the rest faded.
  component Mark(dim = 26) {
    Canvas {
      width: dim
      height: dim
      let d = dim * 0.24
      let r = d / 2
      let c = [r, dim / 2, dim - r]
      for i in range(3) {
        for j in range(3) {
          circle(c[i], c[j], r, fill: (j == 1 || (i == 1 && j == 2)) ? foreground : alpha(foreground, 0.28))
        }
      }
    }
  }

  Column {
    gap: 8
    padding: 12

    Row {
      gap: 8
      align: center
      Mark { dim: 24; opacity: connected ? 1 : 0.5 }
      Box { width: 10; height: 10; radius: 5; background: connected ? green : red }
      Text {
        text: connected ? (reconnecting ? "reconnecting…" : "connected") : "disconnected"
        style: small
        color: connected ? (reconnecting ? muted : green) : red
      }
    }

    if connected {
      if tailnet {
        Text { text: tailnet; style: muted; fontSize: 11; maxLines: 1 }
      }

      if shown.length > 0 {
        Column {
          gap: 6
          weight: 1
          scroll: true
          for p in shown key p.ip {
            Row {
              gap: 6
              align: center
              Column {
                gap: 0
                weight: 1
                Text { text: p.host ? split(p.host, ".")[0] : p.ip; style: body; bold: true; maxLines: 1 }
                Text { text: p.ip; style: small; color: muted; font: mono; maxLines: 1 }
              }
              Button { text: "ip"; color: muted; onTap: copy(p.ip) }
              if p.host {
                Button { text: "host"; color: muted; onTap: copy(p.host) }
              }
            }
          }
        }
      } else {
        Column {
          gap: 10
          justify: center
          weight: 1
          Text { text: "Only this device is online."; style: small; color: muted }
        }
      }
    } else {
      Column {
        gap: 10
        justify: center
        weight: 1
        Text { text: "VPN is off"; style: body }
        Text { text: "Tailscale runs in the Android app; open it to connect."; style: small; color: muted; maxLines: 3 }
        Button { text: "open tailscale"; fill: width; onTap: androidApp("com.tailscale.ipn") }
      }
    }
  }
}
