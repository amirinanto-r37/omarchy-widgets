widget "sudoku" {
  page: 3
  order: 1
  size: 6x7
  minSize: 4x4
  padding: 0
  meta { description: "Sudoku in a terminal tile: every puzzle has exactly one solution. Picture grid, tap and keyboard play, pencil notes, check, hints, undo, pausable timer, 3 levels, saved game. Node.js only."; version: "1.6"; license: "MIT"; category: "games"; owl: 2 }
  requires { pacman: ["nodejs"] }

  // The game is one Node.js file that this command writes to ~/.cache/owl-sudoku/sudoku.js and starts.
  // The grid is a sixel picture sized from the terminal's real cell size; the digit pad and buttons are terminal text.
  Terminal {
    fontSize: 14
    command: """
mkdir -p ~/.cache/owl-sudoku && cat > ~/.cache/owl-sudoku/sudoku.js <<'SUDOKU_JS_EOF'
/* ================= sudoku: rules, solver, generator ================= */
// Cells are 0..80 (row * 9 + column). A digit is 1..9, 0 is empty. Candidate sets are bit masks: bit d is digit d.
const fs = require('fs'), os = require('os'), path = require('path');
const SAVE_FILE = path.join(os.homedir(), '.local', 'state', 'owl-sudoku', 'game.json');
const DIFFS = [{ name: 'Easy', empty: 40 }, { name: 'Medium', empty: 50 }, { name: 'Hard', empty: 60 }];
const ROW = i => (i / 9) | 0, COL = i => i % 9, BOX = i => ((i / 27) | 0) * 3 + (((i % 9) / 3) | 0);
const ALL = 0x3fe;
const POP = new Uint8Array(1024); for (let i = 1; i < 1024; i++) POP[i] = POP[i >> 1] + (i & 1);
const PEERS = [];
for (let i = 0; i < 81; i++) {
  PEERS[i] = [];
  for (let j = 0; j < 81; j++) if (j !== i && (ROW(j) === ROW(i) || COL(j) === COL(i) || BOX(j) === BOX(i))) PEERS[i].push(j);
}

// Counts the solutions of g (stops at `limit`) and leaves g unchanged. With `out`, the first solution found is copied into it.
// `shuffle` tries the digits in random order, which turns an empty grid into a random full one.
function search(g, limit, shuffle, out) {
  const rows = new Int16Array(9), cols = new Int16Array(9), boxes = new Int16Array(9);
  for (let i = 0; i < 81; i++) {
    const d = g[i]; if (!d) continue;
    const bit = 1 << d;
    if ((rows[ROW(i)] | cols[COL(i)] | boxes[BOX(i)]) & bit) return 0;
    rows[ROW(i)] |= bit; cols[COL(i)] |= bit; boxes[BOX(i)] |= bit;
  }
  let n = 0;
  const dfs = () => {
    let best = -1, bm = 0, bc = 10;
    for (let i = 0; i < 81; i++) {
      if (g[i]) continue;
      const m = ~(rows[ROW(i)] | cols[COL(i)] | boxes[BOX(i)]) & ALL, c = POP[m];
      if (c < bc) { bc = c; best = i; bm = m; if (c <= 1) break; }
    }
    if (best < 0) { if (n === 0 && out) out.set(g); n++; return; }
    if (bc === 0) return;
    const ds = []; for (let d = 1; d <= 9; d++) if (bm & (1 << d)) ds.push(d);
    if (shuffle) for (let i = ds.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const t = ds[i]; ds[i] = ds[j]; ds[j] = t; }
    const r = ROW(best), c = COL(best), b = BOX(best);
    for (const d of ds) {
      const bit = 1 << d;
      g[best] = d; rows[r] |= bit; cols[c] |= bit; boxes[b] |= bit;
      dfs();
      g[best] = 0; rows[r] &= ~bit; cols[c] &= ~bit; boxes[b] &= ~bit;
      if (n >= limit) return;
    }
  };
  dfs();
  return n;
}
// True when every row, column and box of a full grid holds each digit 1..9 exactly once.
function validSolution(g) {
  for (let u = 0; u < 9; u++) {
    let r = 0, c = 0, b = 0;
    for (let k = 0; k < 9; k++) {
      r |= 1 << g[u * 9 + k]; c |= 1 << g[k * 9 + u];
      b |= 1 << g[((u / 3) | 0) * 27 + (u % 3) * 3 + ((k / 3) | 0) * 9 + (k % 3)];
    }
    if (r !== ALL || c !== ALL || b !== ALL) return false;
  }
  return true;
}
// A puzzle with exactly one solution: dig holes in a random full grid, keeping a hole only while the solution stays unique.
// A unique puzzle with 60 holes is near the limit: a random dig reaches 59-60 within a third of a second, so the best of the tries is used.
function makePuzzle(empty, budgetMs) {
  const t0 = Date.now(); let best = null;
  for (;;) {
    const sol = new Int8Array(81); search(new Int8Array(81), 1, true, sol);
    const p = sol.slice(), order = Array.from({ length: 81 }, (_, i) => i);
    for (let i = 80; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const t = order[i]; order[i] = order[j]; order[j] = t; }
    let removed = 0;
    for (const i of order) {
      if (removed >= empty) break;
      const v = p[i]; p[i] = 0;
      if (search(p, 2, false) === 1) removed++; else p[i] = v;
    }
    if (!best || removed > best.removed) best = { p, sol, removed };
    if (removed >= empty || Date.now() - t0 > budgetMs) break;
  }
  return best;
}

/* ================= game state, undo, persistence ================= */
const G = { diff: 0, next: 0, puz: new Int8Array(81), sol: new Int8Array(81), v: new Int8Array(81), n: new Int16Array(81), hint: new Uint8Array(81), hints: 0, ms: 0, solved: false, undo: [], assist: true, same: true, paused: false };
const U = { sel: 0, notesOn: false, check: null, msg: '', msgUntil: 0, arm: '', armUntil: 0, view: 'game', page: 0, hits: [], needClear: true, tick: Date.now() };
const emptyCount = () => { let k = 0; for (let i = 0; i < 81; i++) if (!G.v[i]) k++; return k; };
const snap = () => ({ v: Array.from(G.v).join(''), n: Array.from(G.n), h: Array.from(G.hint).join('') });
function pushUndo() { G.undo.push(snap()); if (G.undo.length > 50) G.undo.shift(); }
function restore(s) { for (let i = 0; i < 81; i++) { G.v[i] = +s.v[i]; G.n[i] = s.n[i]; G.hint[i] = +s.h[i]; } }
function checkSolved() { for (let i = 0; i < 81; i++) if (G.v[i] !== G.sol[i]) return false; return true; }
function newGame() {
  const r = makePuzzle(DIFFS[G.next].empty, 350);
  G.diff = G.next; G.puz = r.p; G.sol = r.sol; G.v = r.p.slice(); G.n = new Int16Array(81); G.hint = new Uint8Array(81);
  G.hints = 0; G.ms = 0; G.solved = false; G.paused = false; G.undo = []; U.sel = Math.max(0, G.v.indexOf(0)); U.check = null;
}
function save() {
  try {
    fs.mkdirSync(path.dirname(SAVE_FILE), { recursive: true });
    fs.writeFileSync(SAVE_FILE, JSON.stringify({ v: 1, diff: G.diff, next: G.next, puz: Array.from(G.puz).join(''), sol: Array.from(G.sol).join(''), cur: Array.from(G.v).join(''), notes: Array.from(G.n), hint: Array.from(G.hint).join(''), hints: G.hints, ms: Math.round(G.ms), assist: G.assist, same: G.same, paused: G.paused, undo: G.undo }));
  } catch (e) { /* best effort */ }
}
function load() {
  try {
    const d = JSON.parse(fs.readFileSync(SAVE_FILE, 'utf8')), ok = s => typeof s === 'string' && /^[0-9]{81}$/.test(s);
    if (!ok(d.puz) || !ok(d.sol) || !ok(d.cur) || !ok(d.hint) || !Array.isArray(d.notes) || d.notes.length !== 81) throw new Error('bad save');
    const puz = Int8Array.from(d.puz, Number), sol = Int8Array.from(d.sol, Number), cur = Int8Array.from(d.cur, Number);
    if (!validSolution(sol) || search(puz.slice(), 2, false) !== 1) throw new Error('bad puzzle');
    for (let i = 0; i < 81; i++) if (puz[i] && (puz[i] !== sol[i] || cur[i] !== puz[i])) throw new Error('bad cells');
    const notes = Int16Array.from(d.notes, x => (x & ALL));
    G.puz = puz; G.sol = sol; G.v = cur; G.n = notes; G.hint = Uint8Array.from(d.hint, Number);
    G.diff = d.diff >= 0 && d.diff < DIFFS.length ? d.diff : 0; G.next = d.next >= 0 && d.next < DIFFS.length ? d.next : G.diff;
    G.assist = d.assist !== false; G.same = d.same !== false; G.hints = Math.max(0, d.hints | 0); G.ms = Math.max(0, +d.ms || 0);
    G.undo = (Array.isArray(d.undo) ? d.undo : []).filter(s => s && ok(s.v) && ok(s.h) && Array.isArray(s.n) && s.n.length === 81).slice(-50);
    G.solved = checkSolved(); G.paused = !!d.paused && !G.solved; U.sel = Math.max(0, G.v.indexOf(0));
  } catch (e) { newGame(); }
}

/* ================= pixel drawing: frame buffer, sixel, stroke digits ================= */
class Frame {
  constructor(w, h) { this.w = w; this.h = h; this.px = new Uint8Array(w * h); this.pal = []; this.map = new Map(); }
  col(c) { const k = c.join(','); let i = this.map.get(k); if (i === undefined) { i = this.pal.length; this.pal.push(c); this.map.set(k, i); } return i; }
  rect(x, y, w, h, i) { for (let yy = Math.max(0, y); yy < Math.min(this.h, y + h); yy++) this.px.fill(i, yy * this.w + Math.max(0, x), yy * this.w + Math.min(this.w, x + w)); }
  blit(sp, x0, y0, cf) {
    const S = sp.S;
    for (let y = 0; y < S; y++) { const yy = y0 + y; if (yy < 0 || yy >= this.h) continue;
      for (let x = 0; x < S; x++) { const xx = x0 + x; if (xx < 0 || xx >= this.w) continue; if (sp.fill[y * S + x]) this.px[yy * this.w + xx] = cf; } }
  }
}
// P2=1: unset bits leave pixels alone
function sixelEncode(fr, x0, y0, w, h, padL) {
  padL = padL || 0; const lead = padL ? '!' + padL + '?' : ''; // '?' sets no pixels: with P2=1 they stay as they are
  const used = new Set(); for (let y = y0; y < y0 + h; y++) for (let x = x0; x < x0 + w; x++) used.add(fr.px[y * fr.w + x]);
  let out = '\x1bP0;1;0q"1;1;' + (w + padL) + ';' + h;
  for (const i of used) { const c = fr.pal[i]; out += '#' + i + ';2;' + Math.round(c[0] * 100 / 255) + ';' + Math.round(c[1] * 100 / 255) + ';' + Math.round(c[2] * 100 / 255); }
  const masks = new Map();
  for (let by = 0; by < h; by += 6) {
    masks.clear(); const bh = Math.min(6, h - by);
    for (let r = 0; r < bh; r++) { const base = (y0 + by + r) * fr.w + x0; for (let x = 0; x < w; x++) { const c = fr.px[base + x]; let m = masks.get(c); if (!m) { m = new Uint8Array(w); masks.set(c, m); } m[x] |= 1 << r; } }
    let first = true;
    for (const [c, m] of masks) {
      out += (first ? '' : '$') + '#' + c + lead; first = false;
      let x = 0; while (x < w) { let n = 1; while (x + n < w && m[x + n] === m[x]) n++; const ch = String.fromCharCode(63 + m[x]); out += n > 3 ? '!' + n + ch : ch.repeat(n); x += n; }
    }
    out += '-';
  }
  return out + '\x1b\\';
}
// Digits are strokes in a 60 x 100 box, drawn with a round pen, so they stay smooth at any size.
const arc = (cx, cy, rx, ry, a0, a1) => { const pts = [], n = Math.max(6, Math.ceil(Math.abs(a1 - a0) / 12)); for (let i = 0; i <= n; i++) { const a = (a0 + (a1 - a0) * i / n) * Math.PI / 180; pts.push([cx + rx * Math.cos(a), cy + ry * Math.sin(a)]); } return pts; };
const SIX = [arc(30, 69, 27, 30, 0, 360), arc(60, 70, 55, 70, 180, 252)];
const STROKES = {
  1: [[[10, 24], [30, 0], [30, 100]], [[8, 100], [52, 100]]],
  2: [arc(30, 30, 27, 28, 185, 405).concat([[3, 100], [58, 100]])],
  3: [arc(28, 25, 24, 24, 205, 450), arc(28, 74, 26, 26, 270, 515)],
  4: [[[44, 100], [44, 0], [0, 68], [60, 68]]],
  5: [[[54, 0], [12, 0]].concat(arc(28, 68, 27, 30, -125, 150))],
  6: SIX,
  7: [[[2, 0], [58, 0], [22, 100]]],
  8: [arc(30, 25, 23, 24, 0, 360), arc(30, 74, 27, 26, 0, 360)],
  9: SIX.map(s => s.map(p => [60 - p[0], 100 - p[1]]))
};
const glyphCache = new Map();
function glyph(d, S, pen) {
  const key = d + ':' + S + ':' + pen; if (glyphCache.has(key)) return glyphCache.get(key);
  const fill = new Uint8Array(S * S), sc = S * 0.84 / 100, ox = (S - 60 * sc) / 2, oy = (S - 100 * sc) / 2, half = pen * sc / 2, segs = [];
  for (const st of STROKES[d]) for (let i = 1; i < st.length; i++) segs.push([ox + st[i - 1][0] * sc, oy + st[i - 1][1] * sc, ox + st[i][0] * sc, oy + st[i][1] * sc]);
  // supersample 3 x 3; every segment only stamps the samples inside its own bounding box
  const SS = 3, SN = S * SS, mask = new Uint8Array(SN * SN), hs = half * SS;
  for (const s of segs) {
    const x0 = s[0] * SS, y0 = s[1] * SS, x1 = s[2] * SS, y1 = s[3] * SS, dx = x1 - x0, dy = y1 - y0, l2 = dx * dx + dy * dy;
    const ya = Math.max(0, Math.floor(Math.min(y0, y1) - hs)), yb = Math.min(SN - 1, Math.ceil(Math.max(y0, y1) + hs));
    const xa = Math.max(0, Math.floor(Math.min(x0, x1) - hs)), xb = Math.min(SN - 1, Math.ceil(Math.max(x0, x1) + hs));
    for (let y = ya; y <= yb; y++) for (let x = xa; x <= xb; x++) {
      const px = x + 0.5, py = y + 0.5; let t = l2 ? ((px - x0) * dx + (py - y0) * dy) / l2 : 0; t = Math.max(0, Math.min(1, t));
      if ((px - x0 - t * dx) ** 2 + (py - y0 - t * dy) ** 2 <= hs * hs) mask[y * SN + x] = 1;
    }
  }
  for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {
    let c = 0; for (let sy = 0; sy < SS; sy++) for (let sx = 0; sx < SS; sx++) c += mask[(y * SS + sy) * SN + x * SS + sx];
    if (c * 2 > SS * SS) fill[y * S + x] = 1;
  }
  const r = { fill, S }; glyphCache.set(key, r); return r;
}

/* ================= terminal UI ================= */
const hex = s => { const v = parseInt(s, 16); return [v >> 16 & 255, v >> 8 & 255, v & 255]; };
const mixc = (a, b, t) => [0, 1, 2].map(i => Math.round(a[i] * (1 - t) + b[i] * t));
const rgb = c => c.join(';');
// colors follow the Omarchy theme when its foot.ini is readable
function themeColors() {
  const d = { background: '1a1b26', foreground: 'c0caf5', regular1: 'f7768e', regular2: '73daca', regular3: 'e0af68', regular4: '7aa2f7', regular6: '7dcfff' };
  try {
    const f = path.join(os.homedir(), '.local', 'state', 'omarchy', 'current', 'theme', 'foot.ini');
    for (const line of fs.readFileSync(f, 'utf8').split('\n')) { const m = line.match(/^\s*(\w+)\s*=\s*#?([0-9a-fA-F]{6})\s*$/); if (m) d[m[1]] = m[2]; }
  } catch (e) { /* defaults */ }
  return d;
}
let C = {};
function setupColors() {
  const t = themeColors(), bg = hex(t.background), fg = hex(t.foreground), acc = hex(t.regular2 || t.regular6);
  C = {
    bg, fg, acc, muted: mixc(fg, bg, 0.5), boxA: mixc(bg, fg, 0.07), boxB: mixc(bg, fg, 0.16),
    yellow: hex(t.regular3), red: hex(t.regular1), blue: hex(t.regular4), green: hex(t.regular2),
    btn: mixc(bg, fg, 0.16), btnHot: hex(t.regular3)
  };
}
let W = 80, H = 24, CHs, FGs, BGs, BOs;
function initBuf() {
  W = process.stdout.columns || 80; H = process.stdout.rows || 24;
  const n = W * H; CHs = new Array(n).fill(' '); FGs = new Array(n).fill(rgb(C.fg)); BGs = new Array(n).fill(rgb(C.bg)); BOs = new Array(n).fill(false);
}
function put(x, y, str, fg, bg, bold) {
  if (y < 0 || y >= H) return;
  for (const ch of str) {
    if (x >= 0 && x < W) { const i = y * W + x; CHs[i] = ch; if (fg) FGs[i] = rgb(fg); if (bg) BGs[i] = rgb(bg); if (bold !== undefined) BOs[i] = !!bold; }
    x++;
  }
}
function fillRect(x, y, w, h, bg) { for (let j = 0; j < h; j++) put(x, y + j, ' '.repeat(Math.max(0, w)), C.fg, bg, false); }
function flush(skipRows, clear) {
  let out = '\x1b[?2026h' + (clear ? '\x1b[48;2;' + rgb(C.bg) + 'm\x1b[2J' : '');
  for (let y = skipRows || 0; y < H; y++) {
    out += '\x1b[' + (y + 1) + ';1H'; let cf = '', cb = '', co = null;
    for (let x = 0; x < W; x++) {
      const i = y * W + x;
      if (FGs[i] !== cf || BGs[i] !== cb || BOs[i] !== co) { cf = FGs[i]; cb = BGs[i]; co = BOs[i]; out += '\x1b[0' + (co ? ';1' : '') + ';38;2;' + cf + ';48;2;' + cb + 'm'; }
      out += CHs[i];
    }
  }
  process.stdout.write(out + '\x1b[0m' + (flush.after || '') + '\x1b[?2026l'); flush.after = '';
}

const M = { img: false, cw: 0, ch: 0, pix: false };
let IMG = null;
function toast(t, ms) { U.msg = t; U.msgUntil = Date.now() + (ms || 3000); setTimeout(render, (ms || 3000) + 30); }
const fmtTime = ms => { const t = Math.floor(ms / 1000), h = Math.floor(t / 3600), m = Math.floor(t / 60) % 60, s = t % 60; return (h ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(s).padStart(2, '0'); };

// What each cell looks like: tints for the selection, its row/column/box, equal digits, hints, check results and rule conflicts.
function makeCtx() {
  const conflict = new Uint8Array(81);
  if (G.assist) for (let i = 0; i < 81; i++) if (G.v[i]) for (const j of PEERS[i]) if (G.v[j] === G.v[i]) { conflict[i] = 1; break; }
  const ck = U.check && Date.now() < U.check.until ? U.check : null;
  return { conflict, ck, sd: G.same && U.sel >= 0 ? G.v[U.sel] : 0 };
}
function cellLook(i, ctx) {
  let bg = (((ROW(i) / 3) | 0) + ((COL(i) / 3) | 0)) % 2 ? C.boxB : C.boxA;
  if (U.sel >= 0 && i !== U.sel && (ROW(i) === ROW(U.sel) || COL(i) === COL(U.sel) || BOX(i) === BOX(U.sel))) bg = mixc(bg, C.acc, 0.14);
  if (ctx.sd && G.v[i] === ctx.sd) bg = mixc(bg, C.yellow, 0.28);
  if (G.hint[i] && G.v[i]) bg = mixc(bg, C.yellow, 0.2);
  if (ctx.ck && ctx.ck.good.has(i)) bg = mixc(bg, C.green, 0.4);
  if (ctx.ck && ctx.ck.bad.has(i)) bg = mixc(bg, C.red, 0.55);
  if (ctx.conflict[i] && !G.puz[i]) bg = mixc(bg, C.red, 0.25);
  if (i === U.sel) bg = mixc(bg, C.acc, 0.5);
  let fg = G.puz[i] ? C.fg : (G.hint[i] ? C.yellow : C.blue);
  if (ctx.conflict[i]) fg = C.red;
  return { bg, fg };
}

function padRows() { return H >= 18 ? 2 : 1; }
// Text layout (no sixel): the biggest cells that fit above a status line, the digit pad and a button row.
function layoutText() {
  const bottom = 3; let best = null;
  for (let sw = 2; sw <= 9; sw++) for (let sh = 1; sh <= 4; sh++) {
    const bw = 9 * sw, bh = 9 * sh; if (bw > W || bh + bottom > H) continue;
    const d = sw - 2 * sh, vis = sw * sh * 100 - (d > 0 ? d * d * 25 : d * d * 150);
    if (!best || vis > best.vis) best = { sw, sh, bw, bh, vis };
  }
  if (!best) best = { sw: 2, sh: 1, bw: 18, bh: 9, vis: 0 };
  best.bx = Math.max(0, (W - best.bw) >> 1); best.barY = Math.min(H - bottom, best.bh); best.ph = 1; best.extra = H - best.barY - bottom;
  return best;
}
function drawBoardText(L) {
  const ctx = makeCtx();
  for (let i = 0; i < 81; i++) {
    const px = L.bx + COL(i) * L.sw, py = ROW(i) * L.sh, look = cellLook(i, ctx);
    fillRect(px, py, L.sw, L.sh, look.bg);
    const gx = px + (L.sw >> 1), gy = py + (L.sh >> 1);
    if (G.v[i]) put(gx, gy, String(G.v[i]), look.fg, look.bg, true);
    else if (G.n[i]) { let s = ''; for (let d = 1; d <= 9; d++) if (G.n[i] & (1 << d)) s += d; s = s.slice(0, L.sw); put(px + ((L.sw - s.length) >> 1), gy, s, C.muted, look.bg, false); }
    U.hits.push({ x: px, y: py, w: L.sw, h: L.sh, cell: i });
  }
}

function button(x, y, w, label, act, hot, dim, h) {
  h = h || 1;
  const t = label.length >= w ? label.slice(0, w) : ' '.repeat((w - label.length) >> 1) + label + ' '.repeat(w - label.length - ((w - label.length) >> 1));
  fillRect(x, y, w, h, hot ? C.btnHot : C.btn);
  put(x, y + ((h - 1) >> 1), t, hot ? C.bg : (dim ? C.muted : C.fg), hot ? C.btnHot : C.btn, true);
  if (act !== null) U.hits.push({ x, y, w, h, act });
}
function row(y, defs, gap) {
  const n = defs.length, w = Math.floor((W - gap * (n - 1)) / n); let x = Math.max(0, (W - (w * n + gap * (n - 1))) >> 1);
  for (const d of defs) { button(x, y, w, d[0], d[1], d[2], d[3]); x += w + gap; }
}
function drawPad(y, ph) {
  const gap = (W - 8) / 9 >= 3 ? 1 : 0, w = Math.max(1, Math.floor((W - gap * 8) / 9)); let x = Math.max(0, (W - (w * 9 + gap * 8)) >> 1);
  const cnt = new Int8Array(10); for (let i = 0; i < 81; i++) cnt[G.v[i]]++;
  for (let d = 1; d <= 9; d++) {
