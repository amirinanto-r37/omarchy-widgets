widget "tarjeta" {
  size: 6x3
  minSize: 2x3

  meta {
    owl: 7
    description: "Tu tarjeta de presentacion en el mosaico, con un QR vCard que cualquiera escanea para guardarte en sus contactos."
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  requires { pacman: ["qrencode", "python"] }

  // Los datos viven en un JSON: se editan desde la pantalla del widget, a mano
  // o desde cualquier script. Mientras no exista, la tarjeta sale de ejemplo.
  source card = file("~/.config/omalauncher/tarjeta.json") json

  // El mismo JSON, leido por el ayudante: arma la vCard y la pasa por qrencode.
  // Lee el archivo el mismo, no los valores de arriba, asi el codigo ya es el
  // de la tarjeta en el primer dibujo, sin esperar a que cargue el archivo.
  // qrencode -t ASCII escribe cada modulo como dos caracteres iguales, asi que
  // [::2] deja una fila de un caracter por modulo, lista para sprite(). El
  // margen de 4 modulos ya viene en el codigo.
  source qr = cmd("""
    python3 -c '
import json, os, subprocess

CAMPOS = ("nombre", "puesto", "empresa", "tel", "email", "web", "direccion")
try:
    crudo = json.load(open(os.path.expanduser("~/.config/omalauncher/tarjeta.json")))
except Exception:
    crudo = {}
if not isinstance(crudo, dict):
    crudo = {}
d = {c: str(crudo.get(c) or "").strip() for c in CAMPOS}

def esc(s):
    # En un valor de vCard la barra, ; y , son escape y separadores.
    return s.replace(chr(92), chr(92) * 2).replace(";", chr(92) + ";").replace(",", chr(92) + ",")

nombre = d["nombre"] or "Tu nombre"
partes = nombre.split()
apellido = partes[-1] if len(partes) > 1 else ""
pila = " ".join(partes[:-1]) if len(partes) > 1 else nombre
web = d["web"]
if web and not web.startswith(("http://", "https://")):
    web = "https://" + web

lineas = ["BEGIN:VCARD", "VERSION:3.0",
          "N:" + esc(apellido) + ";" + esc(pila) + ";;;", "FN:" + esc(nombre)]
if d["empresa"]:
    lineas.append("ORG:" + esc(d["empresa"]))
if d["puesto"]:
    lineas.append("TITLE:" + esc(d["puesto"]))
if d["tel"]:
    lineas.append("TEL;TYPE=CELL,VOICE:" + esc(d["tel"]))
if d["email"]:
    lineas.append("EMAIL;TYPE=INTERNET:" + esc(d["email"]))
if web:
    lineas.append("URL:" + esc(web))
if d["direccion"]:
    lineas.append("ADR;TYPE=WORK:;;" + esc(d["direccion"]) + ";;;;")
lineas.append("END:VCARD")
vcard = (chr(13) + chr(10)).join(lineas) + chr(13) + chr(10)

hecho = subprocess.run(["qrencode", "-t", "ASCII", "-l", "M", "-m", "4", "-o", "-"],
                       input=vcard.encode("utf-8"), stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE)
if hecho.returncode != 0:
    print(json.dumps({"ok": False,
                      "error": hecho.stderr.decode("utf-8", "replace").strip()[:120] or "qrencode fallo"}))
else:
    filas = [f[::2].replace("#", "d").replace(" ", ".")
             for f in hecho.stdout.decode("utf-8").splitlines() if f]
    print(json.dumps({"ok": True, "filas": filas, "vcard": vcard, "letras": len(vcard),
                      "llenos": sum(1 for c in CAMPOS if d[c])}))
'
  """) every 12h json

  state editando = false

  // Si alguien edita el JSON, la tarjeta y su QR se vuelven a armar.
  on card { refresh() }

  let nombre = (card.nombre ?? "") == "" ? "Tu nombre" : card.nombre
  let puesto = card.puesto ?? ""
  let empresa = card.empresa ?? ""
  let tel = card.tel ?? ""
  let email = card.email ?? ""
  let web = card.web ?? ""
  let direccion = card.direccion ?? ""
  let webUrl = startsWith(web, "http") ? web : "https://${web}"
  let resumen = join([nombre, puesto, empresa, tel, email, web].filter(x => x != ""), " · ")

  let filas = qr.filas ?? []
  let lado = clamp(min(tileWidth ?? 200, tileHeight ?? 200) - 34, 48, 190)
  let ancho = clamp((screenWidth ?? 360) - 120, 170, 300)

  onTap: screen()

  // El QR siempre negro sobre blanco: asi se lee con cualquier tema.
  component Codigo(tam) {
    Canvas {
      size: tam
      rect(0, 0, width, height, fill: "#FFFFFF", radius: 10 * corners)
      let n = count(filas)
      if n > 0 {
        let p = max(1, floor(min(width, height) / n))
        sprite(filas, (width - n * p) / 2, (height - n * p) / 2, p, palette: {d: "#000000"})
      } else {
        text(qr == null ? "…" : "sin QR", width / 2, height / 2, size: 12, align: center, color: "#666666")
      }
    }
  }

  component Dato(etiqueta, valor) {
    if valor != "" {
      Row {
        gap: 10
        align: center
        Text { text: etiqueta; style: label; color: muted; width: 76 }
        Text { text: valor; style: body; weight: 1; maxLines: 2 }
      }
    }
  }

  // Guarda el campo en el JSON sin tocar los demas. El valor entra como
  // argumento con sh(value), nunca dentro del programa.
  component Campo(etiqueta, clave, valor) {
    Column {
      gap: 2
      Text { text: etiqueta; style: label; color: muted }
      Input {
        text: valor
        placeholder: etiqueta
        onSubmit: { haptic(); run("python3 -c 'import json, os, sys; p = os.path.expanduser(\"~/.config/omalauncher/tarjeta.json\"); d = json.load(open(p)) if os.path.exists(p) else {}; d = d if isinstance(d, dict) else {}; d[sys.argv[1]] = sys.argv[2].strip(); os.makedirs(os.path.dirname(p), exist_ok=True); json.dump(d, open(p, \"w\"), ensure_ascii=False, indent=2)' ${sh(clave)} ${sh(value)}") }
      }
    }
  }

  if (cols ?? 6) >= 4 {
    Row {
      gap: 12
      align: center
      fill: true
      Column {
        gap: 2
        weight: 1
        Text { text: nombre; style: title; maxLines: 2 }
        if puesto != "" { Text { text: puesto; style: small; color: accent; maxLines: 1 } }
        if empresa != "" { Text { text: empresa; style: small; color: muted; maxLines: 1 } }
        Spacer { height: 4 }
        if tel != "" { Text { text: tel; style: small; maxLines: 1 } }
        if email != "" { Text { text: email; style: small; color: muted; maxLines: 1 } }
      }
      Codigo { tam: lado }
    }
  } else {
    Column {
      gap: 6
      align: center
      fill: true
      Codigo { tam: lado }
      Text { text: nombre; style: body; align: center; maxLines: 1 }
      if puesto != "" { Text { text: puesto; style: label; color: accent; align: center; maxLines: 1 } }
    }
  }

  screen {
    title: "tarjeta de contacto"
    Column {
      scroll: true
      gap: 14
      Box {
        fill: width
        align: center
        Codigo { tam: ancho }
      }
      Column {
        gap: 2
        Text { text: nombre; style: title; align: center }
        if puesto != "" { Text { text: puesto; style: body; color: accent; align: center } }
        if empresa != "" { Text { text: empresa; style: small; color: muted; align: center } }
      }
      Column {
        gap: 8
        Dato { etiqueta: "telefono"; valor: tel }
        Dato { etiqueta: "correo"; valor: email }
        Dato { etiqueta: "web"; valor: web }
        Dato { etiqueta: "lugar"; valor: direccion }
      }
      Row {
        gap: 8
        wrap: true
        if tel != "" { Button { text: "llamar"; onTap: { haptic(); url("tel:${tel}") } } }
        if email != "" { Button { text: "correo"; onTap: { haptic(); url("mailto:${email}") } } }
        if web != "" { Button { text: "web"; onTap: { haptic(); url(webUrl) } } }
      }
      Row {
        gap: 8
        wrap: true
        Button { text: "compartir"; onTap: { haptic(); share(resumen) } }
        if qr.ok { Button { text: "copiar vCard"; onTap: { haptic(); copy(qr.vcard) } } }
        Button {
          text: editando ? "listo" : "editar"
          color: editando ? accent : muted
          onTap: { haptic(); editando = !editando }
        }
      }
      if editando {
        Column {
          gap: 10
          padding: [0, 6]
          Text { text: "escribe y pulsa la tecla de enviar del teclado"; style: label; color: muted }
          Campo { etiqueta: "nombre"; clave: "nombre"; valor: card.nombre ?? "" }
          Campo { etiqueta: "puesto"; clave: "puesto"; valor: card.puesto ?? "" }
          Campo { etiqueta: "empresa"; clave: "empresa"; valor: card.empresa ?? "" }
          Campo { etiqueta: "telefono"; clave: "tel"; valor: card.tel ?? "" }
          Campo { etiqueta: "correo"; clave: "email"; valor: card.email ?? "" }
          Campo { etiqueta: "web"; clave: "web"; valor: card.web ?? "" }
          Campo { etiqueta: "lugar"; clave: "direccion"; valor: card.direccion ?? "" }
        }
      }
      Text {
        text: qr.ok ? "vCard de ${qr.letras} caracteres" : qr == null ? "…" : "no se pudo armar el QR"
        style: label
        color: muted
        align: center
      }
      Button { text: "cerrar"; onTap: close() }
    }
  }
}
