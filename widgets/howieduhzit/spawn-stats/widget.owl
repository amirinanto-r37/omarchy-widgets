widget "spawn stats" {
  size: 3x4
  minSize: 3x4
  meta { description: "Spawn.co game stats: track a game's plays and likes, plus the hot, top and recent charts. Tap for the full list and search."; version: "1.0"; license: "MIT"; category: "games"; owl: 5 }

  // No cmd() sources here, only http + clock, so no pacman packages are needed
  // and the widget works without Linux too.

  state sort = "hot" persist
  state tracked = "@howieduhzit/devoid" persist
  state filter = ""

  // The tracked game's slug is whatever follows the last "/" (@user/game, user/game or just game).
  let slug = last(split(tracked, "/")) ?? ""
  let tq = slug.replace("%", "%25").replace(" ", "+").replace("&", "%26").replace("?", "%3F").replace("#", "%23").replace("/", "%2F")

  source feed = http("https://www.spawn.co/api/feed?sort=${sort}") every 10m timeout 15s json
  source trackedFeed = http("https://www.spawn.co/api/feed?sort=top&q=${tq}") every 10m timeout 15s json

  let games = feed.games ?? []
  let totalPlays = sum(games.map(g => num(g.play_count, 0)))
  let top = games.take(5)
  let hits = trackedFeed.games ?? []
  let hit = hits.find(g => lower(g.games.adventure_name) == lower(slug)) ?? first(hits)
  let playsHist = history(hit.play_count, 40)
  let fq = lower(trim(filter))
  let shown = (fq == "" ? games : games.filter(g => contains(lower(g.games.name ?? ""), fq) || contains(lower(g.profiles.username ?? ""), fq))).take(20)

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "spawn.co"; style: label; color: accent; weight: 1; maxLines: 1 }
      Text { text: sort; style: label; color: muted; width: 56; align: end; maxLines: 1 }
    }
    if hit != null {
      Column {
        gap: 0
        Text { text: hit.games.name; style: title; maxLines: 1 }
        Text { text: "@${hit.profiles.username}/${hit.games.adventure_name}"; style: small; color: muted; maxLines: 1 }
        Row {
          gap: 6
          Text { text: "${hit.play_count} plays"; style: body; color: cyan; maxLines: 1; weight: 1 }
          Text { text: "♥ ${hit.like_count}"; style: body; color: magenta; width: 64; align: end; maxLines: 1 }
        }
        Sparkline { values: playsHist; area: true; color: accent; fill: width; height: 32 }
      }
    } else {
      Text { text: trackedFeed == null ? "spawn.co…" : "game not found"; style: small; color: muted; maxLines: 1 }
    }
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
    if games == [] {
      Text { text: feed == null ? "loading charts…" : "charts offline"; style: small; color: muted }
    } else {
      Column {
        gap: 2
        for g in top key g.id {
          Row {
            gap: 6
            align: center
            onTap: url("https://www.spawn.co/@${g.profiles.username}/${g.games.adventure_name}")
            Text { text: g.games.name; style: small; weight: 1; maxLines: 1 }
            Text { text: "${g.play_count}"; style: small; color: cyan; width: 52; align: end; maxLines: 1 }
          }
        }
      }
    }
    Spacer { weight: 1 }
    Text { text: totalPlays > 0 ? "∑ ${totalPlays} · tap for more" : "tap for charts"; style: label; color: muted; maxLines: 1 }
  }

  screen {
    title: "spawn stats"
    Input {
      text: tracked
      placeholder: "@user/game to track"
      onSubmit: { tracked = trim(value); refresh() }
    }
    Input {
      text: filter
      placeholder: "filter charts…"
      onChange: filter = value
    }
    Row {
      gap: 6
      Button { text: "hot"; color: sort == "hot" ? accent : muted; onTap: { sort = "hot"; refresh() } }
      Button { text: "top"; color: sort == "top" ? accent : muted; onTap: { sort = "top"; refresh() } }
      Button { text: "recent"; color: sort == "recent" ? accent : muted; onTap: { sort = "recent"; refresh() } }
    }
    if hit != null {
      Column {
        gap: 0
        Text { text: "tracked · ${hit.games.name}"; style: label; color: accent; maxLines: 1 }
        Text { text: "${hit.play_count} plays · ♥ ${hit.like_count} · ✎ ${hit.comment_count} · @${hit.profiles.username}"; style: small; color: muted; maxLines: 1 }
        Row {
          gap: 6
          Button { text: "play ↗"; onTap: url("https://www.spawn.co/@${hit.profiles.username}/${hit.games.adventure_name}") }
          Button { text: "copy link"; color: muted; onTap: copy("https://www.spawn.co/@${hit.profiles.username}/${hit.games.adventure_name}") }
        }
      }
    }
    if feed == null {
      Text { text: "loading charts…"; style: body; color: muted }
    } else {
      Column {
        scroll: true
        gap: 8
        for g in shown key g.id {
          Row {
            gap: 8
            align: center
            onTap: url("https://www.spawn.co/@${g.profiles.username}/${g.games.adventure_name}")
            Column {
              gap: 0
              weight: 1
              Text { text: g.games.name; style: body; maxLines: 1 }
              Text { text: "@${g.profiles.username} · ♥ ${g.like_count} · ✎ ${g.comment_count} · ${sub(g.last_published_at ?? "", 0, 10)}"; style: small; color: muted; maxLines: 1 }
            }
            Text { text: "${g.play_count}"; style: small; color: cyan; width: 56; align: end; maxLines: 1 }
          }
        }
        Row {
          justify: end
          Button { text: "open spawn.co ↗"; color: muted; onTap: url("https://www.spawn.co/") }
        }
      }
    }
  }
}
