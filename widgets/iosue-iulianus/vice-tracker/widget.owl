widget "vice-tracker" {
  size: 4x2
  minSize: 3x2

  meta {
    owl: 7
    description: "One-tap logging of cigarettes, whiskey and beer, kept on the phone: today's totals against daily goals, streaks, undo, an editable calendar and 7 or 30-day charts"
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  // The local database, kept by the launcher: one record per day with something logged,
  // oldest first. Tracking starts with the first record; from then on a vice at 0 on a day
  // counts as none, so a day with nothing logged is clean.
  state days = [] persist
  // Today's entries, newest last, so undo can take them back one by one.
  state entries = [] persist
  // Taps not yet filed under a day. The clock only ticks while the page is on screen, so a
  // tap right after midnight could still see yesterday's date. A tap queues here, the tap
  // refreshes the clock, and the queue is filed under the fresh date once it lands.
  state queue = [] persist
  state queuedAt = 0 persist
  // Daily limits; 0 means no goal. Whiskey is in cl.
  state goals = {cigarette: 0, whiskey: 0, beer: 0} persist
  state pour = 5 persist
  let pourCl = clamp(pour, 2, 15)
  state monthBack = 0
  // Backup: pasted JSON waiting to be imported, and whether import was tapped once.
  state importText = ""
  state importArmed = false
  // Days shown in the charts: 7 or 30.
  state chartDays = 7 persist
  // The day picked in the calendar to edit; null means today.
  state selDate = null
  state selDn = null

  source now = clock every 60s
  let today = fmtTime(now, "yyyy-MM-dd")
  // Noon today: stepping whole days back from it stays on the right date across DST changes.
  let noon = now - num(fmtTime(now, "H")) * 3600 - num(fmtTime(now, "m")) * 60 - num(fmtTime(now, "s")) + 43200
  // A running day number, stored in each record so streaks need no date parsing.
  let todayDn = floor(noon / 86400)

  let started = len(days) > 0
  let startDate = started ? days[0].date : today
  let startDn = started ? days[0].dn : todayDn
  let rec = find(days, x => x.date == today)
  let cur = rec ?? {date: today, dn: todayDn, cigarette: 0, whiskey: 0, beer: 0}
  // Narrow tiles (under 4 columns, or under 300dp on a small phone) show the emoji only.
  let compact = cols != null && (cols < 4 || (tileWidth ?? 999) < 300)
  // A 3x2 on a small phone: about 34dp per card.
  let tiny = (tileWidth ?? 999) < 200
  let short = rows != null && rows < 3

  // Filing the queue under today: add each vice's queued amounts to today's record.
  let qSum = {
    cigarette: sum(queue.filter(q => q.v == "cigarette").map(q => q.a)),
    whiskey: sum(queue.filter(q => q.v == "whiskey").map(q => q.a)),
    beer: sum(queue.filter(q => q.v == "beer").map(q => q.a))
  }
  let filedRec = {date: today, dn: todayDn, cigarette: cur.cigarette + qSum.cigarette, whiskey: cur.whiskey + qSum.whiskey, beer: cur.beer + qSum.beer}
  let filedAll = rec == null ? flatten([days, [filedRec]]) : days.map(x => x.date == today ? filedRec : x)
  let filedDays = drop(filedAll, max(len(filedAll) - 800, 0))
  let filedEntries = flatten([entries.filter(x => x.date == today), queue.map(q => {date: today, v: q.v, a: q.a})])
  when len(queue) > 0 && now != null && now != queuedAt {
    days = filedDays
    entries = filedEntries
    queue = []
  }

  // Undo: take back today's newest entry; a day left at 0 everywhere drops its record.
  let lastE = last(entries.filter(x => x.date == today))
  let undoRec = lastE == null ? null : {
    date: today,
    dn: todayDn,
    cigarette: max(cur.cigarette - (lastE.v == "cigarette" ? lastE.a : 0), 0),
    whiskey: max(cur.whiskey - (lastE.v == "whiskey" ? lastE.a : 0), 0),
    beer: max(cur.beer - (lastE.v == "beer" ? lastE.a : 0), 0)
  }
  let undoDays = lastE == null ? days : undoRec.cigarette + undoRec.whiskey + undoRec.beer <= 0 ? days.filter(x => x.date != today) : days.map(x => x.date == today ? undoRec : x)
  let undoEntries = lastE == null ? entries : take(entries, len(entries) - 1)
  // A tap still in the queue is taken back first.
  let queued = len(queue) > 0
  let canUndo = queued || lastE != null

  // The last 7 days' dates, oldest first, today last.
  let week = range(7).map(i => fmtTime(noon - (6 - i) * 86400, "yyyy-MM-dd"))

  // The month shown: from the 15th of this month, back monthBack months, then to its 1st.
  let first0 = noon - (num(fmtTime(now, "d")) - 1) * 86400
  let mid = first0 + 14 * 86400 - round(monthBack * 30.44) * 86400
  let first = mid - (num(fmtTime(mid, "d")) - 1) * 86400
  let monthNum = fmtTime(first, "MM")
  let dim = count(range(31), i => fmtTime(first + i * 86400, "MM") == monthNum)
  // Monday-first weekday of the 1st, from the day count (1 Jan 1970 was a Thursday).
  let lead = (floor(first / 86400) + 3) % 7
  let weeks = ceil((lead + dim) / 7)

  // This week against the one before, per vice (days without a record count as 0).
  let thisWeek = days.filter(x => x.dn > todayDn - 7)
  let lastWeek = days.filter(x => x.dn > todayDn - 14 && x.dn <= todayDn - 7)
  let lastWeekTracked = started && startDn <= todayDn - 7

  // The day being edited on the screen.
  let editDate = selDate ?? today
  let editDn = selDate == null ? todayDn : selDn
  let editRec = find(days, x => x.date == editDate)
  let editBase = editRec ?? {date: editDate, dn: editDn, cigarette: 0, whiskey: 0, beer: 0}
  // Days from the first record on count as tracked; an earlier one can be marked clean,
  // which keeps a record at 0 and moves the start back to it.
  let editTracked = started && editDate >= startDate
  let markDays = sortBy(flatten([days, [editBase]]), x => x.dn)

  onTap: { haptic(); monthBack = 0; selDate = null; importText = ""; importArmed = false; screen() }

  // A day's level: clean = nothing, ok = within every goal set, over = over at least one;
  // untracked before the first record, future after today.
  component Dot(key, size = 9) {
    let r = find(days, x => x.date == key)
    let lv = key > today ? "future" : !started || key < startDate ? "untracked" : r == null ? "clean" : (goals.cigarette > 0 && r.cigarette > goals.cigarette) || (goals.whiskey > 0 && r.whiskey > goals.whiskey) || (goals.beer > 0 && r.beer > goals.beer) ? "over" : r.cigarette + r.whiskey + r.beer == 0 ? "clean" : "ok"
    Box {
      width: size
      height: size
      radius: size / 2
      background: lv == "clean" ? green : lv == "ok" ? orange : lv == "over" ? red : lv == "future" ? alpha(muted, 0.1) : alpha(muted, 0.4)
    }
  }

  // The whole card is the log button: one big tap target per vice.
  // Every line has a fixed height, so logging never shifts the card's contents.
  component Vice(glyph, name, amount, step, unit) {
    let total = get(cur, name, 0) + get(qSum, name, 0)
    let goal = get(goals, name, 0)
    let over = goal > 0 && total > goal
    let nextQueue = flatten([queue, [{v: name, a: amount}]])
    // Streak: days in a row up to today within the goal (or at 0 without one). Days without
    // a record are 0, so it runs from the day after the last bad one, or from the start.
    let lastBad = max(days.filter(x => x.dn <= todayDn && (goal > 0 ? get(x, name, 0) > goal : get(x, name, 0) > 0)).map(x => x.dn))
    let streak = !started ? 0 : todayDn - (lastBad != null ? lastBad + 1 : startDn) + 1
    let label = goal > 0 ? "${round(total, 1)}/${round(goal, 1)}" : "${round(total, 1)}${unit}"
    Column {
      gap: 0
      fill: height
      justify: center
      align: center
      padding: [compact ? 0 : 4, 2]
      border: 1
      borderColor: over ? red : accent
      background: alpha(over ? red : accent, 0.12)
      onTap: { haptic(); queue = nextQueue; queuedAt = now }
      Text {
        text: label
        height: 26
        fontSize: tiny ? (len(label) >= 4 ? 11 : 14) : (compact ? 15 : 20) - (len(label) > 4 ? (compact ? 3 : 4) : 0)
        bold: true
        align: center
        color: over ? red : foreground
        maxLines: 1
      }
      Text { text: compact ? glyph : "${glyph} ${step}"; height: 20; fontSize: 14; align: center; color: accent; maxLines: 1 }
      if !short && !compact {
        Text { text: streak > 0 ? "${streak}d streak" : ""; height: 16; style: small; align: center; color: muted; maxLines: 1 }
      }
    }
  }

  // One vice of the day being edited, with − and +. Records stay in date order;
  // a day taken back to 0 keeps its record, so it stays tracked as clean.
  component EditRow(glyph, name, stepBy, unit) {
    let val = get(editBase, name, 0)
    let downRec = {
      date: editDate,
      dn: editDn,
      cigarette: name == "cigarette" ? max(val - stepBy, 0) : editBase.cigarette,
      whiskey: name == "whiskey" ? max(val - stepBy, 0) : editBase.whiskey,
      beer: name == "beer" ? max(val - stepBy, 0) : editBase.beer
    }
    let upRec = {
      date: editDate,
      dn: editDn,
      cigarette: name == "cigarette" ? val + stepBy : editBase.cigarette,
      whiskey: name == "whiskey" ? val + stepBy : editBase.whiskey,
      beer: name == "beer" ? val + stepBy : editBase.beer
    }
    let upDays = editRec == null ? sortBy(flatten([days, [upRec]]), x => x.dn) : days.map(x => x.date == editDate ? upRec : x)
    let downDays = editRec == null ? days : days.map(x => x.date == editDate ? downRec : x)
    Row {
      gap: 8
      align: center
      Text { text: glyph; width: 28 }
      Text { text: "${round(val, 1)}${unit}"; weight: 1; bold: true; color: val > 0 ? foreground : muted }
      Button { text: "−"; color: muted; onTap: { haptic(); days = downDays } }
      Button { text: "+"; onTap: { haptic(); days = drop(upDays, max(len(upDays) - 800, 0)) } }
    }
  }

  // A vice's last 7 or 30 days: the daily total (shaded), a 7-day rolling average and
  // the goal (dashed). Untracked days are gaps, not zeros.
  component ViceChart(glyph, title, name, unit) {
    let n = chartDays
    let keys = range(n).map(i => fmtTime(noon - (n - 1 - i) * 86400, "yyyy-MM-dd"))
    let vals = keys.map(k => started && k >= startDate ? get(find(days, x => x.date == k), name, 0) : null)
    let known = vals.filter(v => v != null)
    let rolling = range(n).map(i => avg(drop(take(vals, i + 1), max(i - 6, 0)).filter(v => v != null)))
    let goal = get(goals, name, 0)
    let top = max(max(known) ?? 0, goal, 1)
    let ymax = top <= 4 ? 4 : top <= 10 ? 10 : ceil(top * 1.15 / 5) * 5
    let mean = len(known) > 0 ? round(sum(known) / len(known), 1) : null
    Column {
      gap: 6
      padding: 12
      border: 1
      borderColor: border
      radius: 8 * corners
      Row {
        gap: 8
        align: center
        Text { text: glyph; width: 28 }
        Column {
          gap: 0
          weight: 1
          Text { text: title; bold: true; maxLines: 1 }
          Text { text: "${goal > 0 ? "goal ${goal}${unit}/day" : "no goal"} · ${len(known)} of ${n} days tracked"; style: small; color: muted; maxLines: 1 }
        }
      }
      Canvas {
        height: 150
        fill: width
        let L = 26
        let R = 6
        let T = 6
        let B = 18
        let w = width - L - R
        let h = height - T - B
        let xs = range(n).map(i => L + (n > 1 ? i * w / (n - 1) : w / 2))
        // Grid and y labels at 0, half and the top
        for f in [0, 0.5, 1] {
          line(L, T + h * (1 - f), width - R, T + h * (1 - f), stroke: alpha(muted, 0.15), width: 1)
          text("${round(ymax * f, 1)}", L - 4, T + h * (1 - f), size: 9, align: end, color: muted)
        }
        // Daily: shaded area and line between neighbouring tracked days, a dot on each
        for i in range(n - 1) {
          if vals[i] != null && vals[i + 1] != null {
            path([[xs[i], T + h], [xs[i], T + h * (1 - vals[i] / ymax)], [xs[i + 1], T + h * (1 - vals[i + 1] / ymax)], [xs[i + 1], T + h]], closed: true, fill: alpha(accent, 0.18))
            line(xs[i], T + h * (1 - vals[i] / ymax), xs[i + 1], T + h * (1 - vals[i + 1] / ymax), stroke: accent, width: 2, cap: round)
          }
        }
        for i in range(n) {
          if vals[i] != null {
            circle(xs[i], T + h * (1 - vals[i] / ymax), n > 7 ? 1.5 : 2.5, fill: accent)
          }
        }
        // 7-day average
        for i in range(n - 1) {
          if rolling[i] != null && rolling[i + 1] != null {
            line(xs[i], T + h * (1 - rolling[i] / ymax), xs[i + 1], T + h * (1 - rolling[i + 1] / ymax), stroke: alpha(foreground, 0.55), width: 1.5, cap: round)
          }
        }
        // Goal, dashed
        if goal > 0 {
          for j in range(ceil(w / 10)) {
            line(L + j * 10, T + h * (1 - goal / ymax), min(L + j * 10 + 6, width - R), T + h * (1 - goal / ymax), stroke: orange, width: 1.5)
          }
        }
        // Dates along the bottom
        for i in range(n) {
          if n <= 7 || i % 6 == (n - 1) % 6 {
            let lbl = n <= 7 ? fmtTime(noon - (n - 1 - i) * 86400, "EEE") : fmtTime(noon - (n - 1 - i) * 86400, "d MMM")
            // The last one ends at the right edge instead of running past it.
            if i == n - 1 {
              text(lbl, width - R, height - 7, size: 9, align: end, color: muted)
            } else {
              text(lbl, xs[i], height - 7, size: 9, align: center, color: muted)
            }
          }
        }
      }
      Row {
        gap: 12
        justify: center
        Row { gap: 4; align: center; Box { width: 12; height: 3; background: accent }; Text { text: "daily"; style: small; color: muted; width: 40 } }
        Row { gap: 4; align: center; Box { width: 12; height: 2; background: alpha(foreground, 0.55) }; Text { text: "7-day avg"; style: small; color: muted; width: 70 } }
        if goal > 0 {
          Row { gap: 4; align: center; Box { width: 12; height: 2; background: orange }; Text { text: "goal"; style: small; color: muted; width: 32 } }
        }
      }
      Row {
        gap: 8
        for st in [["avg/day", mean], ["best day", min(known)], ["total", round(sum(known), 1)]] {
          Column {
            gap: 0
            weight: 1
            align: center
            Text { text: st[0]; style: label; color: muted; align: center }
            Text { text: st[1] == null ? "–" : "${round(st[1], 1)}${unit}"; bold: true; align: center }
          }
        }
      }
    }
  }

  // Backup as JSON, so the history survives a new phone or removing the widget.
  let exportJson = "{\"app\":\"vice-tracker\",\"version\":1,\"pour\":${pourCl},\"goals\":{\"cigarette\":${goals.cigarette},\"whiskey\":${goals.whiskey},\"beer\":${goals.beer}},\"days\":[" + join(days.map(r => "{\"date\":\"${r.date}\",\"dn\":${r.dn},\"cigarette\":${r.cigarette},\"whiskey\":${r.whiskey},\"beer\":${r.beer}}"), ",") + "]}"
  let parsed = trim(importText) == "" ? null : parseJson(trim(importText))
  // Imported days must have a day number that matches their date (it's what streaks count
  // on), can't be in the future, and are sorted with one record per date.
  let importRaw = sortBy((parsed.days ?? []).filter(d => num(d.dn, null) != null && num(d.dn, 0) <= todayDn && fmtTime(num(d.dn, 0) * 86400 + 43200, "yyyy-MM-dd") == str(d.date)), d => num(d.dn, 0))
  let importDays = range(len(importRaw)).filter(i => i == 0 || importRaw[i].dn != importRaw[i - 1].dn).map(i => {date: str(importRaw[i].date), dn: num(importRaw[i].dn, 0), cigarette: max(num(importRaw[i].cigarette, 0), 0), whiskey: max(num(importRaw[i].whiskey, 0), 0), beer: max(num(importRaw[i].beer, 0), 0)})
  let importOk = parsed != null && parsed.app == "vice-tracker" && len(importDays) > 0
  let importGoals = {cigarette: max(num(parsed.goals.cigarette, 0), 0), whiskey: max(num(parsed.goals.whiskey, 0), 0), beer: max(num(parsed.goals.beer, 0), 0)}

  // A daily limit with − and +, on the screen.
  component Goal(glyph, name, stepBy, unit) {
    let g = get(goals, name, 0)
    let down = {cigarette: name == "cigarette" ? max(g - stepBy, 0) : goals.cigarette, whiskey: name == "whiskey" ? max(g - stepBy, 0) : goals.whiskey, beer: name == "beer" ? max(g - stepBy, 0) : goals.beer}
    let up = {cigarette: name == "cigarette" ? g + stepBy : goals.cigarette, whiskey: name == "whiskey" ? g + stepBy : goals.whiskey, beer: name == "beer" ? g + stepBy : goals.beer}
    Row {
      gap: 8
      align: center
      Text { text: glyph; width: 28 }
      Text { text: g > 0 ? "${g}${unit} a day" : "no goal"; color: g > 0 ? foreground : muted; weight: 1 }
      Button { text: "−"; color: muted; onTap: { haptic(); goals = down } }
      Button { text: "+"; onTap: { haptic(); goals = up } }
    }
  }

  Column {
    gap: 5
    fill: true

    // Today and the last 7 days, when the tile is tall enough
    if !short {
      Row {
        gap: 6
        align: center
        Text {
          text: !started ? "vice tracker" : cur.cigarette + cur.whiskey + cur.beer == 0 ? "clean so far today" : "today"
          style: small
          color: !started ? muted : cur.cigarette + cur.whiskey + cur.beer == 0 ? green : muted
          weight: 1
          maxLines: 1
        }
        Row {
          gap: 4
          align: center
          for k in week { Dot { key: k } }
        }
      }
    }

    // One card per vice; undo and the calendar on the right
    Row {
      gap: tiny ? 4 : compact ? 5 : 8
      weight: 1
      Vice { glyph: "🚬"; name: "cigarette"; amount: 1; step: "+1"; unit: ""; weight: 1 }
      Vice { glyph: "🥃"; name: "whiskey"; amount: pourCl; step: "+${pourCl}"; unit: "cl"; weight: 1 }
      Vice { glyph: "🍺"; name: "beer"; amount: 1; step: "+1"; unit: ""; weight: 1 }
      Column {
        gap: tiny ? 4 : compact ? 5 : 8
        width: tiny ? 30 : compact ? 38 : 46
        // Undo stands out while there's something to take back.
        Column {
          gap: 0
          weight: 1
          fill: width
          justify: center
          align: center
          border: !canUndo ? 1 : 2
          borderColor: !canUndo ? alpha(border, 0.5) : orange
          background: !canUndo ? null : alpha(orange, 0.15)
          onTap: { haptic(); queue = queued ? take(queue, len(queue) - 1) : queue; days = queued ? days : undoDays; entries = queued ? entries : undoEntries }
          Text { text: "↶"; fontSize: 24; bold: true; align: center; color: !canUndo ? alpha(muted, 0.35) : orange }
          Text { text: "undo"; visible: (tileHeight ?? 999) >= 120; style: small; bold: true; align: center; maxLines: 1; color: !canUndo ? alpha(muted, 0.35) : orange }
        }
        Box {
          weight: 1
          fill: width
          align: center
          border: 1
          borderColor: border
          onTap: { haptic(); monthBack = 0; selDate = null; importText = ""; importArmed = false; screen() }
          // A line-drawn calendar in the theme's colours, like Omarchy's icons.
          Canvas {
            width: 24
            height: 24
            let c = alpha(foreground, 0.8)
            rect(3, 5, 18, 16, radius: 3 * corners, stroke: c, width: 1.6)
            line(3, 10, 21, 10, stroke: c, width: 1.6)
            line(8, 3, 8, 7, stroke: c, width: 1.6, cap: round)
            line(16, 3, 16, 7, stroke: c, width: 1.6, cap: round)
            for i in range(6) {
              circle(7.5 + (i % 3) * 4.5, 13.5 + floor(i / 3) * 4, 1.1, fill: i == 4 ? accent : c)
            }
          }
        }
      }
    }
  }

  screen {
    title: "vice tracker"

    Column {
      gap: 12
      padding: 16
      scroll: true

      // Calendar
      Row {
        gap: 8
        align: center
        Button { text: "‹"; color: muted; onTap: { haptic(); monthBack = monthBack + 1 } }
        Text { text: fmtTime(first, "MMMM yyyy"); style: title; align: center; weight: 1 }
        Button { text: "›"; color: monthBack > 0 ? accent : alpha(muted, 0.3); onTap: { haptic(); monthBack = max(monthBack - 1, 0) } }
      }
      Row {
        gap: 6
        for w in ["M", "T", "W", "T", "F", "S", "S"] { Text { text: w; style: label; color: muted; align: center; weight: 1 } }
      }
      for wk in range(weeks) {
        Row {
          gap: 6
          for dw in range(7) {
            let i = wk * 7 + dw
            let ts = first + (i - lead) * 86400
            let key = fmtTime(ts, "yyyy-MM-dd")
            let inMonth = i >= lead && i < lead + dim
            if inMonth && key <= today {
              // Past days and today: tap to edit.
              Column {
                gap: 2
                align: center
                weight: 1
                height: 44
                padding: [0, 3]
                border: key == editDate ? 1 : 0
                borderColor: accent
                onTap: { haptic(); selDate = key; selDn = floor(ts / 86400) }
                Text { text: fmtTime(ts, "d"); style: small; align: center; color: key == today ? accent : foreground; bold: key == today || key == editDate }
                Dot { key: key; size: 12 }
              }
            } else {
              Column {
                gap: 2
                align: center
                weight: 1
                height: 44
                padding: [0, 3]
                Text { text: inMonth ? fmtTime(ts, "d") : ""; style: small; align: center; color: alpha(foreground, 0.5) }
                if inMonth {
                  Dot { key: key; size: 12 }
                }
              }
            }
          }
        }
      }
      Row {
        gap: 12
        justify: center
        Row { gap: 4; align: center; Box { width: 9; height: 9; radius: 5; background: green }; Text { text: "clean"; style: small; color: muted; width: 44 } }
        Row { gap: 4; align: center; Box { width: 9; height: 9; radius: 5; background: orange }; Text { text: "within goals"; style: small; color: muted; width: 96 } }
        Row { gap: 4; align: center; Box { width: 9; height: 9; radius: 5; background: red }; Text { text: "over"; style: small; color: muted; width: 36 } }
      }

      // The picked day
      Row {
        gap: 8
        align: center
        Text { text: editDate == today ? "today" : fmtTime(editDn * 86400 + 43200, "EEEE d MMMM"); style: label; weight: 1 }
        if editRec == null && !editTracked {
          Text { text: "not tracked"; style: small; color: muted; width: 96; align: end }
          Button { text: "mark clean"; color: green; onTap: { haptic(); days = markDays } }
        }
        if editDate != today {
          Button { text: "today"; color: muted; onTap: { haptic(); selDate = null } }
        }
      }
      EditRow { glyph: "🚬"; name: "cigarette"; stepBy: 1; unit: "" }
      EditRow { glyph: "🥃"; name: "whiskey"; stepBy: pourCl; unit: "cl" }
      EditRow { glyph: "🍺"; name: "beer"; stepBy: 1; unit: "" }
      Text { text: "tap a day in the calendar to change it"; style: small; color: muted }

      // Last 7 days
      Text { text: "last 7 days"; style: label; color: muted }
      Row {
        gap: 8
        Text { text: ""; width: 72 }
        Text { text: "🚬"; weight: 1; align: end }
        Text { text: "🥃"; weight: 1; align: end }
        Text { text: "🍺"; weight: 1; align: end }
        Spacer { width: 12 }
      }
      for i in range(7) {
        let key = week[6 - i]
        let r = find(days, x => x.date == key)
        let tracked = started && key >= startDate
        Row {
          gap: 8
          align: center
          Text { text: i == 0 ? "today" : fmtTime(noon - i * 86400, "EEE d"); width: 72; color: i == 0 ? accent : foreground }
          Text { text: !tracked ? "–" : "${round(r.cigarette ?? 0, 1)}"; weight: 1; align: end; color: tracked ? foreground : muted }
          Text { text: !tracked ? "–" : "${round(r.whiskey ?? 0, 1)}cl"; weight: 1; align: end; color: tracked ? foreground : muted }
          Text { text: !tracked ? "–" : "${round(r.beer ?? 0, 1)}"; weight: 1; align: end; color: tracked ? foreground : muted }
          Dot { key: key; size: 12 }
        }
      }
      Row {
        gap: 8
        Text { text: "vs week before"; width: 72; style: small; color: muted }
        for v in ["cigarette", "whiskey", "beer"] {
          let a = sum(thisWeek.map(r => get(r, v, 0)))
          let b = sum(lastWeek.map(r => get(r, v, 0)))
          let pct = lastWeekTracked && b > 0 ? round((a - b) / b * 100) : null
          Text {
            text: pct == null ? "–" : pct > 0 ? "+${pct}%" : "${pct}%"
            style: small
            weight: 1
            align: end
            color: pct == null ? muted : pct > 0 ? red : green
          }
        }
        Spacer { width: 12 }
      }

      // Charts
      Row {
        gap: 8
        align: center
        Text { text: "charts"; style: label; color: muted; weight: 1 }
        Button { text: "7 days"; color: chartDays == 7 ? accent : muted; onTap: { haptic(); chartDays = 7 } }
        Button { text: "30 days"; color: chartDays == 30 ? accent : muted; onTap: { haptic(); chartDays = 30 } }
      }
      ViceChart { glyph: "🚬"; title: "cigarettes"; name: "cigarette"; unit: "" }
      ViceChart { glyph: "🥃"; title: "whiskey"; name: "whiskey"; unit: "cl" }
      ViceChart { glyph: "🍺"; title: "beer"; name: "beer"; unit: "" }

      // Goals
      Text { text: "daily goals"; style: label; color: muted }
      Goal { glyph: "🚬"; name: "cigarette"; stepBy: 1; unit: "" }
      Goal { glyph: "🥃"; name: "whiskey"; stepBy: 5; unit: "cl" }
      Goal { glyph: "🍺"; name: "beer"; stepBy: 1; unit: "" }
      Row {
        gap: 8
        align: center
        Text { text: "🥃"; width: 28 }
        Text { text: "a pour is ${pourCl}cl (2–15)"; weight: 1 }
        // A pour stays between a small shot (2cl) and a very generous one (15cl).
        Button { text: "−"; color: pourCl > 2 ? muted : alpha(muted, 0.3); onTap: { haptic(); pour = max(pourCl - 1, 2) } }
        Button { text: "+"; color: pourCl < 15 ? accent : alpha(muted, 0.3); onTap: { haptic(); pour = min(pourCl + 1, 15) } }
      }
      // Backup
      Text { text: "backup"; style: label; color: muted }
      Text { text: "${len(days)} days of history. Export it to keep a copy; import a copy to bring it back."; style: small; color: muted }
      Row {
        gap: 8
        Button { text: "copy export"; weight: 1; onTap: { haptic(); copy(exportJson) } }
        Button { text: "share export"; weight: 1; onTap: { haptic(); share(exportJson) } }
      }
      Input { text: importText; placeholder: "paste an export here to import it"; onChange: { importText = value; importArmed = false } }
      if trim(importText) != "" {
        Text {
          text: !importOk ? "that isn't a vice tracker export" : importArmed ? "this replaces all ${len(days)} days here with ${len(importDays)} from the export. Tap again to import." : "${len(importDays)} days, from ${importDays[0].date} to ${last(importDays).date}"
          style: small
          color: !importOk ? red : importArmed ? orange : muted
        }
        if importOk {
          Button {
            text: importArmed ? "replace and import" : "import"
            color: importArmed ? orange : accent
            onTap: { haptic(); days = importArmed ? drop(importDays, max(len(importDays) - 800, 0)) : days; goals = importArmed ? importGoals : goals; pour = importArmed ? clamp(num(parsed.pour, 5), 2, 15) : pour; entries = importArmed ? [] : entries; importText = importArmed ? "" : importText; importArmed = !importArmed }
          }
        }
      }
      Text { text: "a vice at 0 on a day counts as none; everything stays on this phone"; style: small; color: muted; align: center }
    }
  }
}
