widget "omacasino wallet" {
  meta { description: "The bankroll omacasino blackjack and baccarat share, from their shared ledger: the balance, what each game won or lost, and every change"; version: "1.0"; license: "MIT"; category: "games"; owl: 7 }
  size: 3x2
  minSize: 2x2

  // The ledger the omacasino games write (blackjack, baccarat, ...): one "<name> <delta> <time>
  // <id>" line per change, appended, never rewritten; the balance is 1000 plus all the deltas.
  // This widget only reads it.
  // A fifth word marks a line that isn't a hand's result: "hold" for a stake held while its hand
  // is in play (and the release when it settles), "comm" for baccarat's commission box.
  //
  // The tile reads it through a stream: tail replays the whole file and then follows it, and
  // awk prints a running summary for every line. Sources stop while their page is off screen,
  // and a file() source then misses the changes; a stream starts over when the page is back,
  // replaying the file, so the tile is right the moment it's seen, with no clock or polling.
  // The awk sees every line, so the screen's numbers (balance, in play, per-game totals) come
  // from it too; the screen reads only the file's end, for the recent list and the chart.
  // The launcher doesn't always stop an old copy of the stream when it starts it again, and an
  // idle ledger gives the old one nothing to write, so it would never notice; each start ends
  // older tails first, so one runs however many omacasino widgets are on the home screen.
  source summary = stream("""f="$HOME/.local/share/omacasino/ledger"; pkill -f "^tail -n .1 -F $f"; n=$( { wc -l < "$f"; } 2>/dev/null || echo 0)
    exec awk -v f="$f" -v day="$(date +%Y%m%d)" -v n="$n" '
    function emit(  g, seen, games) {
      seen = ""; for (g in last) seen = seen (seen == "" ? "" : ",") "\"" g "\":" last[g]
      games = ""; for (g in gn) games = games (games == "" ? "" : ",") "\"" g "\":{\"net\":" gn[g] ",\"n\":" (gc[g] + 0) "}"
      printf "{\"b\":%d,\"h\":%d,\"tn\":%d,\"tc\":%d,\"ln\":\"%s\",\"ld\":%d,\"lt\":%d,\"e\":%d,\"last\":{%s},\"g\":{%s}}\n", 1000 + b, h, tn, tc, ln, ld, lt, e, seen, games
      fflush()
    }
    BEGIN {
      if (n + 0 == 0) emit()
      src = "exec tail -n +1 -F \"" f "\" 2>/dev/null"
      while ((src | getline) > 0) {
        i++
        if (NF >= 2 && !($4 != "" && $4 in ids)) {
          if ($4 != "") ids[$4] = 1
          b += $2
          if ($5 == "hold") h += $2
          else if ($1 != "rebuy" && $1 != "reset" && strftime("%Y%m%d", $3) == day) { tn += $2; if ($5 == "") tc++ }
          if (split($4, p, "-") >= 2) { g = p[1]; if (!(g in last) || p[2] + 0 > last[g]) last[g] = p[2] + 0 }
          if ($5 != "hold") {
            ln = $1; ld = $2; lt = $3; e++
            if ($1 != "rebuy" && $1 != "reset") { gn[$1] += $2; if ($5 == "") gc[$1]++ }
          }
        }
        if (i >= n + 0 && NF >= 2) emit()
      }
    }'""") json
  // The end of the ledger, for the screen's recent list and chart: a hand writes about three
  // lines (hold, release, result), so 300 lines cover the last 100 or so changes. lines() keeps
  // at most 1000 items, so the whole file can't be read this way once it grows. A tap opening
  // the screen refreshes it, so it's current however long the tile has been on screen.
  source recentLog = cmd("tail -n 300 \"$HOME/.local/share/omacasino/ledger\" 2>/dev/null") every 5m

  let rows = lines(recentLog ?? "").filter(l => trim(l) != "").map(l => {
    name: words(l)[0] ?? "?", delta: num(words(l)[1], 0), t: num(words(l)[2], 0), kind: words(l)[4] ?? ""
  })
  // The lists and the chart leave holds out: a hand's hold and its release cancel, and its
  // result line says what it did.
  let settled = rows.filter(r => r.kind != "hold")
  let totals = keys(summary.g ?? {}).map(g => { name: g, net: get(summary.g, g, {}).net ?? 0, n: get(summary.g, g, {}).n ?? 0 })
    .sortBy(g => -abs(g.net))
  // The numbers, from the stream (1000 before anything is written). The balance counts
  // everything, stakes held by hands in play too.
  let tBal = summary.b ?? 1000
  let todayNet = summary.tn ?? 0
  let todayN = summary.tc ?? 0
  let tHeld = -(summary.h ?? 0)

  onTap: { refresh(); screen() }

  Column {
    gap: 2
    Row {
      gap: 6; align: center
      Box { width: 14; height: 14; radius: 7; background: red; border: 2; borderColor: alpha(foreground, 0.85) }
      Text { text: "omacasino"; style: label; weight: 1 }
    }
    Text { text: "${tBal}"; style: title; bold: true; color: accent }
    if summary != null && summary.lt > 0 {
      Text {
        text: todayN > 0 ? "today ${todayNet > 0 ? "+" : todayNet < 0 ? "−" : "±"}${abs(todayNet)} · ${todayN} hands" : "no hands today"
        style: small; color: todayNet > 0 ? green : todayNet < 0 ? red : muted; maxLines: 1
      }
      Text {
        text: tHeld > 0 ? "${tHeld} in play"
          : "${summary.ln} ${summary.ld > 0 ? "+" : summary.ld < 0 ? "−" : "±"}${abs(summary.ld)} · ${fmtTime(summary.lt, "HH:mm")}"
        style: small; color: muted; maxLines: 1
      }
    } else {
      Text { text: "play omacasino blackjack or baccarat to start"; style: small; color: muted; maxLines: 2 }
    }
  }

  screen {
    title: "omacasino wallet"
    Column {
      fill: true; gap: 14; scroll: true
      Row {
        align: bottom
        Column {
          gap: 0; weight: 1
          Text { text: "shared bankroll"; style: label }
          Text { text: "${tBal}"; style: huge; color: accent }
        }
        Text { text: tHeld > 0 ? "${tHeld} in play" : "${summary.e ?? 0} entries"; style: muted; width: 120; align: end }
      }
      if len(settled) > 1 {
        // The balance after each change in that end of the file, holds left out. It's counted back
        // from the stream's balance, since the file's start isn't read, so it ends at the balance
        // shown above (lower by any stake still in play).
        let recent = settled.map(r => r.delta)
        let base = tBal - sum(recent)
        let points = range(len(recent)).map(i => base + sum(recent.take(i + 1)))
        Sparkline { values: points; min: 0; max: max(points) * 1.1; area: true; color: accent; fill: width; height: 80 }
      }
      Text { text: "by game"; style: label }
      if len(totals) == 0 {
        Text { text: "no games played yet: get omacasino blackjack or baccarat from the store"; style: muted }
      }
      for g in totals key g.name {
        Row {
          gap: 10; align: center; padding: [10, 6]
          background: alpha(surface, 0.6); radius: 8 * corners
          Text { text: g.name; weight: 1 }
          Text { text: "${g.n} hands"; style: small; color: muted; width: 80; align: end }
          Text {
            text: g.net > 0 ? "+${g.net}" : g.net < 0 ? "−${-g.net}" : "±0"; bold: true; width: 70; align: end
            color: g.net > 0 ? green : g.net < 0 ? red : muted
          }
        }
      }
      Text { text: "recent"; style: label }
      for r, i in reverse(settled).take(50) key i {
        Row {
          gap: 10; align: center
          Text { text: fmtTime(r.t, "d MMM HH:mm"); style: small; color: muted; width: 92 }
          Text { text: r.kind == "comm" ? "${r.name} commission" : r.name; weight: 1; maxLines: 1 }
          Text {
            text: r.delta > 0 ? "+${r.delta}" : r.delta < 0 ? "−${-r.delta}" : "±0"; width: 70; align: end
            color: r.name == "rebuy" || r.name == "reset" ? muted : r.delta > 0 ? green : r.delta < 0 ? red : muted
          }
        }
      }
      Text {
        text: "the ledger is ~/.local/share/omacasino/ledger; omacasino blackjack and baccarat write it, this only reads it"
        style: small; color: muted
      }
    }
  }
}
