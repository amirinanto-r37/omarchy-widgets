widget "markets" {
  size: 6x5
  minSize: 4x4

  meta { owl: 5; description: "US, European and Japanese stock markets (index futures where available), gold futures and bitcoin as % change in one chart: 24h, 1 week or 12 months"; version: "1.0"; license: "MIT"; category: "finance" }

  // Yahoo Finance's public chart API, no key needed. Futures are US index futures (S&P 500, Nasdaq,
  // Nikkei) and gold; Yahoo has no European index futures, so the DAX is the cash index.
  state span = "D" persist
  // Saved spans from before the rename (24h, 1w, 1m, 1y, 12m) move to the new letters.
  when span == "24h" { span = "D" }
  when span == "1w" { span = "W" }
  when span == "1m" { span = "M" }
  when span == "1y" || span == "12m" { span = "Y" }
  let spans = ["D", "W", "M", "Y"]
  let win = span == "D" ? 86400 : span == "W" ? 604800 : span == "M" ? 2592000 : 31536000
  // Fetch a bit more than the window: a closed futures market has no bars in the last 24 h.
  let ua = { "User-Agent": "markets/1.0" }
  let base = "https://query1.finance.yahoo.com/v8/finance/chart/"

  // One source per span, so switching never waits for a refetch and never shows another span's data.
  source sp_d = http("${base}ES%3DF?range=5d&interval=15m", ua) every 5m timeout 15s json
  source nq_d = http("${base}NQ%3DF?range=5d&interval=15m", ua) every 5m timeout 15s json
  source dax_d = http("${base}%5EGDAXI?range=5d&interval=15m", ua) every 5m timeout 15s json
  source nik_d = http("${base}NIY%3DF?range=5d&interval=15m", ua) every 5m timeout 15s json
  source au_d = http("${base}GC%3DF?range=5d&interval=15m", ua) every 5m timeout 15s json
  source btc_d = http("${base}BTC-USD?range=5d&interval=15m", ua) every 5m timeout 15s json

  source sp_w = http("${base}ES%3DF?range=7d&interval=1h", ua) every 10m timeout 15s json
  source nq_w = http("${base}NQ%3DF?range=7d&interval=1h", ua) every 10m timeout 15s json
  source dax_w = http("${base}%5EGDAXI?range=7d&interval=1h", ua) every 10m timeout 15s json
  source nik_w = http("${base}NIY%3DF?range=7d&interval=1h", ua) every 10m timeout 15s json
  source au_w = http("${base}GC%3DF?range=7d&interval=1h", ua) every 10m timeout 15s json
  source btc_w = http("${base}BTC-USD?range=7d&interval=1h", ua) every 10m timeout 15s json

  source sp_m = http("${base}ES%3DF?range=1mo&interval=1h", ua) every 15m timeout 15s json
  source nq_m = http("${base}NQ%3DF?range=1mo&interval=1h", ua) every 15m timeout 15s json
  source dax_m = http("${base}%5EGDAXI?range=1mo&interval=1h", ua) every 15m timeout 15s json
  source nik_m = http("${base}NIY%3DF?range=1mo&interval=1h", ua) every 15m timeout 15s json
  source au_m = http("${base}GC%3DF?range=1mo&interval=1h", ua) every 15m timeout 15s json
  source btc_m = http("${base}BTC-USD?range=1mo&interval=1h", ua) every 15m timeout 15s json

  source sp_y = http("${base}ES%3DF?range=1y&interval=1d", ua) every 30m timeout 15s json
  source nq_y = http("${base}NQ%3DF?range=1y&interval=1d", ua) every 30m timeout 15s json
  source dax_y = http("${base}%5EGDAXI?range=1y&interval=1d", ua) every 30m timeout 15s json
  source nik_y = http("${base}NIY%3DF?range=1y&interval=1d", ua) every 30m timeout 15s json
  source au_y = http("${base}GC%3DF?range=1y&interval=1d", ua) every 30m timeout 15s json
  source btc_y = http("${base}BTC-USD?range=1y&interval=1d", ua) every 30m timeout 15s json

  let defs = [
    { n: "S&P 500", c: blue, d: span == "D" ? sp_d : span == "W" ? sp_w : span == "M" ? sp_m : sp_y },
    { n: "Nasdaq", c: cyan, d: span == "D" ? nq_d : span == "W" ? nq_w : span == "M" ? nq_m : nq_y },
    { n: "DAX", c: green, d: span == "D" ? dax_d : span == "W" ? dax_w : span == "M" ? dax_m : dax_y },
    { n: "Nikkei", c: magenta, d: span == "D" ? nik_d : span == "W" ? nik_w : span == "M" ? nik_m : nik_y },
    { n: "Gold", c: yellow, d: span == "D" ? au_d : span == "W" ? au_w : span == "M" ? au_m : au_y },
    { n: "Bitcoin", c: orange, d: span == "D" ? btc_d : span == "W" ? btc_w : span == "M" ? btc_m : btc_y }
  ]

  // Raw series: [{t, p}] without the gaps Yahoo leaves as null.
  let raw = defs.map(s => {
    n: s.n,
    c: s.c,
    pts: range(len(s.d.chart.result[0].timestamp ?? [])).filter(i => s.d.chart.result[0].indicators.quote[0].close[i] != null).map(i => { t: s.d.chart.result[0].timestamp[i], p: s.d.chart.result[0].indicators.quote[0].close[i] })
  })
  let t1 = max(raw.map(s => len(s.pts) > 0 ? last(s.pts).t : 0))
  // A market with nothing inside the window (futures at the weekend) shows its latest window, right-aligned.
  let ends = raw.map(s => len(s.pts) > 0 && last(s.pts).t < t1 - win ? last(s.pts).t : t1)
  let wins = range(len(raw)).map(k => raw[k].pts.filter(x => x.t > ends[k] - win))
  let norm = range(len(raw)).map(k => { n: raw[k].n, c: raw[k].c, pts: wins[k].map(x => { t: x.t + (t1 - ends[k]), p: (x.p / first(wins[k]).p - 1) * 100 }) })
  let live = norm.filter(s => len(s.pts) > 1)
  let lo = min(min(live.map(s => min(s.pts.map(x => x.p)))), 0) - 0.1
  let hi = max(max(live.map(s => max(s.pts.map(x => x.p)))), 0) + 0.1
  // Longest hole in the data that is still one line (DAX): a few bars on 24h; beyond that nights and weekends are bridged.
  let gap = span == "D" ? 10800 : 432000
  // Futures trade nearly around the clock: only a closed weekend (about 49 h) is left as a gap of data, so bridge it.
  let fgap = span == "Y" ? 432000 : 216000
  // Time markers: 4-hourly on 24h, daily on 1w, weekly on 1m, monthly on 1y, on the local clock.
  let off = round(((num(fmtTime(t1, "HH")) * 3600 + num(fmtTime(t1, "mm")) * 60 - t1 % 86400) + 129600) % 86400 / 900) * 900 - 43200
  let step = span == "D" ? 14400 : span == "W" ? 86400 : span == "M" ? 604800 : 2629800
  let first = span == "Y" ? t1 : floor((t1 - off) / step) * step + off
  let ticks = range(ceil(win / step) + 1).map(k => first - k * step).filter(x => x > t1 - win)
  let tfmt = span == "D" ? "HH:mm" : span == "W" ? "EEE" : span == "M" ? "d MMM" : "MMM"
  let loaded = len(live) > 0

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "markets"; style: label; weight: 1 }
      for s in spans key s {
        Button { text: s; color: s == span ? accent : muted; onTap: span = s }
      }
    }
    Grid {
      columns: 3
      gap: 2
      for s in norm key s.n {
        Row {
          gap: 4
          Box { width: 8; height: 8; radius: 4; background: s.c }
          Text { text: len(s.pts) > 0 ? "${s.n} ${last(s.pts).p >= 0 ? "+" : ""}${fixed(last(s.pts).p, 1)}%" : "${s.n} …"; style: small; maxLines: 1; weight: 1 }
        }
      }
    }
    Canvas {
      weight: 1
      fill: width
      if loaded {
        let w = width - 34
        let h = height - 16
        let zy = h - (0 - lo) / (hi - lo) * h
        line(0, zy, w, zy, stroke: muted, width: 1)
        text("0%", width, zy, size: 10, align: end, color: muted)
        text("${hi >= 0 ? "+" : ""}${fixed(hi, 1)}", width, 6, size: 10, align: end, color: muted)
        text("${fixed(lo, 1)}", width, h - 6, size: 10, align: end, color: muted)
        for tk in ticks {
          let tx = (tk - (t1 - win)) / win * w
          line(tx, h, tx, h + 3, stroke: muted, width: 1)
          text(fmtTime(tk, tfmt), tx, height - 5, size: 10, align: center, color: muted)
        }
        for s in live {
          // The DAX (cash index) is only open in the day: break its line overnight instead of drawing across.
          let st = range(len(s.pts)).filter(i => i == 0 || s.pts[i].t - s.pts[i - 1].t > (s.n == "DAX" ? gap : fgap))
          for j in range(len(st)) {
            let seg = s.pts.drop(st[j]).take((j + 1 < len(st) ? st[j + 1] : len(s.pts)) - st[j])
            path(seg.map(x => [(x.t - (t1 - win)) / win * w, h - (x.p - lo) / (hi - lo) * h]), stroke: s.c, width: 1.5)
          }
        }
      }
    }
  }
}
