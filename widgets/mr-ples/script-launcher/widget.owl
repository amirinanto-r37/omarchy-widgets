widget "script-launcher" {
  // A launcher for shell scripts. The scripts folder is the list: every
  // executable file at its top level is a row. Only script rows launch —
  // tap one to run it in a terminal. Tapping anywhere else on the tile (the
  // header, the space between and below rows) opens the full view, which has
  // the sort control, + add, edit and the bigger ↻.
  size: 6x3
  minSize: 3x2

  meta { owl: 7; description: "A launcher widget for shell scripts"; version: "1.0"; license: "MIT"; category: "system" }

  requires { pacman: ["jq"] }

  // The user's editor: resolved by the shell (braces must NOT be OWL
  // interpolation here, hence the raw single-quoted string).
  source editor = cmd('echo ${EDITOR:-vi}') every 1h timeout 5s

  source rows = cmd("""
    d=~/.config/omalauncher/scripts
    [ -d "$d" ] || mkdir -p "$d"
    t=$(mktemp)
    for f in "$d"/*; do
      [ -f "$f" ] && [ -x "$f" ] || continue
      h=$(awk '/^#!/ { next } /^#/ { sub(/^#+ */, ""); if ($0 != "") { print; exit } }' "$f")
      jq -nc --arg p "$f" --arg m "$(stat -c %Y "$f")" --arg h "$h" \
        '{path: $p, name: ($p | split("/") | last | sub("\\.[^./]+$"; "")), mtime: ($m | tonumber), hint: $h}' >> "$t"
    done
    if [ -s "$t" ]; then jq -sc . "$t"; else echo '[]'; fi
    rm -f "$t"
  """) every 1h json timeout 20s

  // The only interval is 1h: OWL sources always re-run on a schedule, so 1h is
  // the closest to "never" — real refreshes are the ↻ button, launches
  // (sources re-run after an action) and page returns. One cycling button in
  // the full view changes it; the tile follows; it persists.
  state sort = "name" persist

  // + add asks for a name before creating anything. The Input only records
  // the name; handlers cannot branch, so three `when` triggers below do the
  // validating and fire the create + editor.
  state adding = false
  state pendingName = ""
  state submitted = false
  state addErr = ""

  let sortLabel = sort == "name" ? "A–Z" : sort == "nameDesc" ? "Z–A" : "new"
  let nextSort = sort == "name" ? "nameDesc" : sort == "new" ? "name" : "new"
  let byName = rows == null ? null : rows.sortBy(r => lower(r.name))
  let list = rows == null ? null : sort == "new" ? rows.sortBy(r => -r.mtime) : sort == "nameDesc" ? reverse(byName) : byName
  let nameOk = submitted && pendingName != "" && match(pendingName, "^[A-Za-z0-9][A-Za-z0-9_-]*$") != null
  let nameTaken = nameOk && any(list ?? [], r => r.name == pendingName)
  let editCmd = editor == null ? "vi" : editor == "" ? "vi" : editor

  when submitted && !nameOk && pendingName != "" { addErr = "letters, digits, - and _ only" }
  when submitted && nameOk && nameTaken { addErr = "a script with that name exists" }
  when submitted && nameOk && !nameTaken {
    adding = false; addErr = ""
    run("d=~/.config/omalauncher/scripts; f=$d/${sh(pendingName)}.sh; echo '#!/bin/sh' > $f; echo '# this is the description' >> $f; chmod +x $f")
    terminal("d=~/.config/omalauncher/scripts; ${sh(editCmd)} $d/${sh(pendingName)}.sh ${sh(pendingName)}")
    pendingName = ""; submitted = false
  }

  onTap: { haptic(); screen() }

  Column {
    gap: 6
    Row {
      Text { text: "scripts"; style: muted; weight: 1; width: 100 }
      Text { text: "↻"; fontSize: 22; width: 48; align: center; padding: [2, 6]; color: foreground; onTap: { haptic(); refresh() } }
    }
    if rows == null {
      Text { text: "…"; style: small; color: muted }
    } else if len(list) == 0 {
      Text { text: "no scripts yet — tap anywhere for the full view and + add"; style: small; color: muted }
    } else {
      Column {
        scroll: true
        weight: 1
        gap: 2
        for r in list key r.path {
          Row {
            gap: 10
            padding: 6
            onTap: { haptic(); terminal("${sh(r.path)} ${sh(r.name)}") }
            Column {
              weight: 1
              gap: 1
              Text { text: r.name; font: mono; fontSize: 14; maxLines: 1 }
              Text { text: r.hint ?? ""; fontSize: 12; color: muted; maxLines: 1 }
            }
            Text { text: fmtTime(r.mtime, "EEE d MMM"); style: small; color: muted; width: 72; align: end }
          }
        }
      }
    }
  }

  screen {
    title: "scripts"
    Column {
      padding: 12
      gap: 10
      Row {
        gap: 8
        Text { text: "sort: ${sortLabel}"; style: small; width: 120; align: center; padding: [6, 8]; radius: 3 * corners
          background: accent; color: background
          onTap: { haptic(); sort = nextSort } }
        Spacer { weight: 1 }
        Text { text: "+ add"; style: small; fontSize: 16; width: 64; align: center; color: foreground; padding: [6, 8]
          onTap: { haptic(); adding = true; addErr = ""; pendingName = ""; submitted = false } }
        
        Text { text: "↻"; style: small; fontSize: 22; width: 52; align: center; color: muted; padding: [8, 6]
          onTap: { haptic(); refresh() } }
      }
      if adding {
        Column {
          gap: 4
          Row {
            gap: 8
            Input { text: pendingName; placeholder: "name — letters, digits, - _"; fontSize: 14; color: foreground; weight: 1; focus: true
              onChange: { pendingName = value; submitted = false; addErr = "" }
              onSubmit: submitted = true }
            Text { text: "create"; style: small; width: 52; align: center; color: foreground; padding: [6, 8]; onTap: { haptic(); submitted = true } }
            Text { text: "cancel"; style: small; width: 52; align: center; color: muted; padding: [6, 8]
              onTap: { haptic(); adding = false; addErr = ""; pendingName = ""; submitted = false } }
          }
          if addErr != "" { Text { text: addErr; style: small; color: red } }
        }
      }
      if rows == null {
        Text { text: "…"; style: small; color: muted }
      } else if len(list) == 0 {
        Text { text: "no scripts yet — + add creates one and opens it in an editor"; style: small; color: muted }
      } else {
        Column {
          scroll: true
          weight: 1
          gap: 6
          for r in list key r.path {
            Row {
              gap: 10
              padding: 6
              onTap: { haptic(); terminal("${sh(r.path)} ${sh(r.name)}") }
              Column {
                weight: 1
                gap: 1
                Text { text: r.name; font: mono; fontSize: 14; maxLines: 1 }
                Text { text: r.hint ?? ""; fontSize: 12; color: muted; maxLines: 1 }
              }
              Text { text: fmtTime(r.mtime, "EEE d MMM"); style: small; color: muted; width: 72; align: end }
            }
          }
        }
      }
    }
  }
}
