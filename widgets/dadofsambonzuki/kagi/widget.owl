widget "kagi" {
  page: 1
  order: 3
  size: 4x1
  minSize: 3x1
  meta { description: "A Kagi search bar: tap it, type a query and results open in the browser, with live Kagi autosuggest."; version: "1.1"; license: "MIT"; category: "productivity"; owl: 6 }

  // What's typed; kept only for the open screen.
  state q = ""

  // The query, percent-encoded so it can't break the URL. Empty means no suggestions yet.
  let qq = q.replace("%", "%25").replace("+", "%2B").replace("&", "%26").replace("#", "%23").replace("'", "%27").replace(" ", "+")

  // Kagi's own autosuggest; onChange refreshes the source the moment q changes.
  source sug = http("https://kagi.com/api/autosuggest?q=${qq}") every 5m json
  let items = sug[1] ?? []
  let results = "https://kagi.com/search?q=" + qq

  onTap: screen()

  // The tile is just the search bar; tapping it opens the screen and the keyboard.
  Row {
    gap: 10
    fill: true
    align: center
    Canvas {
      width: 18
      height: 18
      circle(7, 7, 5.5, stroke: muted, width: 1.8)
      line(11, 11, 17, 17, stroke: muted, width: 1.8)
    }
    Text { text: "Search with Kagi"; style: body; color: muted; weight: 1; maxLines: 1 }
  }

  screen {
    title: "kagi"
    Column {
      gap: 10
      padding: 14
      Input {
        text: q
        placeholder: "Search Kagi"
        focus: true
        fontSize: 18
        background: surface
        border: 1
        borderColor: border
        radius: 22 * corners
        padding: [16, 12]
        onChange: { q = value; refresh() }
        onSubmit: { url(results); q = ""; close() }
      }
      if len(items) > 0 {
        Column {
          scroll: true
          gap: 2
          for s in items {
            Row {
              gap: 12
              align: center
              padding: [12, 11]
              onTap: { url("https://kagi.com/search?q=" + s.replace("%", "%25").replace("+", "%2B").replace("&", "%26").replace("#", "%23").replace("'", "%27").replace(" ", "+")); q = ""; close() }
              Canvas {
                width: 16
                height: 16
                circle(6, 6, 4.5, stroke: muted, width: 1.6)
                line(9.5, 9.5, 14.5, 14.5, stroke: muted, width: 1.6)
              }
              Text { text: s; style: body; weight: 1; maxLines: 1 }
            }
          }
        }
      } else {
        Text { text: "Private search: no ads, no tracking."; style: small; color: muted }
      }
    }
  }
}
