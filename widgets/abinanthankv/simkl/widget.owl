widget "simkl" {
  page: 1
  order: 15
  size: 6x4
  minSize: 3x4
  meta { owl: 6; description: "Your next week of TV, anime and movies from Simkl: tile, posters and full screen. Tap login, approve the code on simkl.com, done"; version: "1.3"; license: "MIT"; category: "media" }
  requires { pacman: ["python", "curl"] }

  let clientId = "95a4064f1187b0dd4846827dbbf0268d12ea8cec58ca89e323021f87eda269ed"

  // The helper writes itself to the cache on first run (and after this file changes).
  source boot = cmd("""
d=~/.cache/omalauncher-simkl
mkdir -p "$d"
t="$d/simkl.py.tmp"
cat > "$t" <<'OWL_SIMKL_PY'
#!/usr/bin/env python3
# Simkl upcoming-calendar helper for the omarchy widget.
# Subcommands:
#   device-start <client_id>  start login and poll until approved, denied or expired
#   check <client_id>         re-check the pending login once (the refresh button)
#   fetch <days> <client_id>  print upcoming episodes/releases as JSON
#   logout                    forget the local token
# Tokens live only in ~/.config/omarchy-simkl (mode 600); never in the widget.
import io
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime

HOME = os.path.expanduser("~")
CONF_DIR = os.path.join(HOME, ".config", "omarchy-simkl")
CACHE = os.path.join(HOME, ".cache", "omalauncher", "simkl")
POSTER_DIR = os.path.join(CACHE, "posters")
TOKEN_F = os.path.join(CONF_DIR, "token")
REFRESH_F = os.path.join(CONF_DIR, "refresh")
EXPIRES_F = os.path.join(CONF_DIR, "expires")
DEVICE_F = os.path.join(CONF_DIR, "device.json")
DCODE_F = os.path.join(CONF_DIR, "device-code")

API = "https://api.simkl.com"
CDN = "https://data.simkl.in/calendar/v2"
APP_NAME = "omarchy-simkl"
APP_VERSION = "1.0"
UA = "omarchy-simkl/1.0"
CAL_TTL = 5 * 3600
DEVICE_GRANT = "urn:ietf:params:oauth:grant-type:device_code"

STATUSES = {"shows": ["watching", "plantowatch"],
            "anime": ["watching", "plantowatch"],
            "movies": ["plantowatch"]}
CAL_FILE = {"shows": "tv", "anime": "anime", "movies": "movie_release"}
FINALE = {1: "mid-season finale", 2: "season finale", 3: "series finale"}


def log(*a):
    print(*a, file=sys.stderr)


def _run_curl(cmd, timeout):
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=timeout + 5)
    except subprocess.TimeoutExpired:
        raise urllib.error.HTTPError("curl", 124, "timeout", {}, None)
    out = p.stdout
    body, _, code = out.rpartition(b"\n")
    try:
        code = int(code)
    except ValueError:
        body, code = out, 0
    if p.returncode != 0 and not code:
        raise urllib.error.URLError(p.stderr.decode(errors="replace")[:200])
    if code >= 400:
        raise urllib.error.HTTPError("curl", code, "http %d" % code, {}, io.BytesIO(body))
    return body


def http_get(url, headers=None, timeout=30):
    cmd = ["curl", "-sS", "-m", str(timeout), "-A", UA]
    for k, v in (headers or {}).items():
        cmd += ["-H", "%s: %s" % (k, v)]
    return _run_curl(cmd + ["-w", "\n%{http_code}", url], timeout), {}


def http_post(url, fields, timeout=30):
    cmd = ["curl", "-sS", "-m", str(timeout), "-A", UA, "-X", "POST"]
    for k, v in fields.items():
        cmd += ["--data-urlencode", "%s=%s" % (k, v)]
    return _run_curl(cmd + ["-w", "\n%{http_code}", url], timeout), {}


def base_params(cid):
    return "client_id=%s&app-name=%s&app-version=%s" % (cid, APP_NAME, APP_VERSION)


def read_secret(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return ""


def write_secret(path, text):
    os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def save_token(tok):
    write_secret(TOKEN_F, tok["access_token"])
    if tok.get("refresh_token"):
        write_secret(REFRESH_F, tok["refresh_token"])
    write_secret(EXPIRES_F, str(int(time.time()) + int(tok.get("expires_in") or 0)))


def clear_pending():
    for p in (DCODE_F, DEVICE_F):
        try:
            os.remove(p)
        except OSError:
            pass


def poll_once(cid, dc):
    # Swap the device code for a token, once. A network hiccup reads as {} so the
    # caller can just try again on the next tick instead of giving up.
    try:
        raw, _ = http_post("%s/oauth2/token?%s" % (API, base_params(cid)),
                           {"grant_type": DEVICE_GRANT, "client_id": cid, "device_code": dc})
        return json.loads(raw or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read() or b"{}")
        except Exception:
            return {}
    except urllib.error.URLError:
        return {}


def cmd_device_start(cid):
    raw, _ = http_post("%s/oauth2/device?%s" % (API, base_params(cid)), {"client_id": cid})
    d = json.loads(raw)
    if not d.get("user_code") or not d.get("device_code"):
        log("device-start failed:", d)
        return 1
    dc = d["device_code"]
    write_secret(DCODE_F, dc)
    pub = {"user_code": d.get("user_code"),
           "verification_uri": d.get("verification_uri", "https://simkl.com/pin"),
           "verification_uri_complete": d.get("verification_uri_complete")
           or "https://simkl.com/pin?user_code=" + d.get("user_code", "")}
    os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
    with open(DEVICE_F, "w") as f:
        json.dump(pub, f)
    print("ok")
    # Poll here on the interval Simkl asks for, until the token arrives, the user
    # denies it, or expires_in runs out; then drop the pending code either way.
    try:
        interval = max(1, int(d.get("interval") or 5))
        deadline = time.time() + int(d.get("expires_in") or 900)
        while time.time() < deadline:
            time.sleep(interval)
            tok = poll_once(cid, dc)
            if tok.get("access_token"):
                save_token(tok)
                return 0
            err = tok.get("error") or ""
            if err == "slow_down":
                interval += 5
            elif err in ("access_denied", "expired_token"):
                return 0
            # authorization_pending, or a network hiccup: keep waiting
        return 0
    finally:
        clear_pending()


def cmd_check(cid):
    # One-shot re-check of the pending login, behind the widget's refresh button,
    # so an approved code is picked up even if the background poller hiccuped.
    dc = read_secret(DCODE_F)
    if not dc:
        print("none")
        return 0
    tok = poll_once(cid, dc)
    if tok.get("access_token"):
        save_token(tok)
        clear_pending()
        print("ok")
        return 0
    err = tok.get("error") or ""
    if err in ("access_denied", "expired_token"):
        clear_pending()
    print(err or "pending")
    return 0


def cmd_logout():
    for p in (TOKEN_F, REFRESH_F, EXPIRES_F, DEVICE_F, DCODE_F):
        try:
            os.remove(p)
        except OSError:
            pass
    print("ok")
    return 0


def refresh_if_needed(cid):
    rt = read_secret(REFRESH_F)
    if not rt:
        return
    exp = read_secret(EXPIRES_F)
    if exp and time.time() < int(exp) - 3600:
        return
    try:
        raw, _ = http_post("%s/oauth2/token?%s" % (API, base_params(cid)),
                           {"grant_type": "refresh_token", "client_id": cid, "refresh_token": rt})
        tok = json.loads(raw)
        if tok.get("access_token"):
            write_secret(TOKEN_F, tok["access_token"])
            if tok.get("refresh_token"):
                write_secret(REFRESH_F, tok["refresh_token"])
            write_secret(EXPIRES_F, str(int(time.time()) + int(tok.get("expires_in") or 0)))
    except Exception as e:
        log("refresh failed:", e)


def api(path, cid, token, extra=""):
    q = base_params(cid) + (("&" + extra) if extra else "")
    headers = {"User-Agent": UA, "Authorization": "Bearer " + token}
    raw, _ = http_get("%s%s?%s" % (API, path, q), headers)
    return json.loads(raw or b"null")


def item_simkl_id(item):
    if not isinstance(item, dict):
        return None
    node = item
    if not isinstance(node.get("ids"), dict):
        for k in ("show", "movie", "anime", "tv_show"):
            if isinstance(node.get(k), dict):
                node = node[k]
                break
    ids = node.get("ids")
    if isinstance(ids, dict) and ids.get("simkl") is not None:
        return ids["simkl"]
    return node.get("simkl_id") or node.get("id")


def watchlist_ids(cid, token):
    ids = {"shows": set(), "anime": set(), "movies": set()}
    tasks = [(typ, st) for typ, statuses in STATUSES.items() for st in statuses]

    def one(task):
        typ, st = task
        try:
            data = api("/sync/all-items/%s/%s" % (typ, st), cid, token,
                       "extended=simkl_ids_only")
        except urllib.error.HTTPError as e:
            if e.code == 401:
                raise
            return typ, []
        if not isinstance(data, dict):
            return typ, []
        return typ, [item_simkl_id(i) for i in (data.get(typ) or [])]

    with ThreadPoolExecutor(max_workers=len(tasks)) as ex:
        for typ, sids in ex.map(one, tasks):
            for sid in sids:
                if sid is not None:
                    ids[typ].add(int(sid))
    return ids


def calendar(kind):
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, kind + ".json")
    if os.path.exists(path) and time.time() - os.path.getmtime(path) < CAL_TTL:
        try:
            with open(path) as f:
                return json.load(f)
        except Exception:
            pass
    raw, _ = http_get("%s/%s.json?%s" % (CDN, kind, base_params("owl")),
                      {"User-Agent": UA}, timeout=60)
    with open(path, "wb") as f:
        f.write(raw)
    return json.loads(raw)


def poster_path(rel, sid):
    if not rel:
        return ""
    os.makedirs(POSTER_DIR, exist_ok=True)
    out = os.path.join(POSTER_DIR, "%d.webp" % sid)
    if os.path.exists(out) and os.path.getsize(out) > 0:
        return out
    try:
        raw, _ = http_get("https://simkl.in/posters/%s_m.webp" % rel,
                          {"User-Agent": UA}, timeout=30)
        with open(out, "wb") as f:
            f.write(raw)
        return out
    except Exception:
        return ""


def cmd_fetch(days, cid):
    token = read_secret(TOKEN_F)
    if not token:
        log("not logged in")
        return None
    refresh_if_needed(cid)
    token = read_secret(TOKEN_F)
    try:
        ids = watchlist_ids(cid, token)
    except urllib.error.HTTPError as e:
        if e.code != 401:
            raise
        write_secret(EXPIRES_F, "0")
        refresh_if_needed(cid)
        ids = watchlist_ids(cid, read_secret(TOKEN_F))
    now = time.time()
    end = now + days * 86400
    kinds = [CAL_FILE[t] for t in CAL_FILE if ids[t]]
    cals = {}
    if kinds:
        with ThreadPoolExecutor(max_workers=len(kinds)) as ex:
            for kind, cal in zip(kinds, ex.map(calendar, kinds)):
                cals[kind] = cal
    items = []
    for typ, kind in CAL_FILE.items():
        if not ids[typ] or kind not in cals:
            continue
        cal = cals[kind]
        meta = cal.get("metadata", {})
        for e in cal.get("calendar", []):
            sid = e.get("simkl_id")
            if sid is None or int(sid) not in ids[typ]:
                continue
            try:
                t = datetime.fromisoformat(e["date"].replace("Z", "+00:00")).timestamp()
            except Exception:
                continue
            if not (now <= t <= end):
                continue
            show = meta.get(str(sid), {})
            ep = e.get("episode") or {}
            if kind == "movie_release":
                sub = "in cinemas"
            elif "season" in ep:
                sub = "S%sE%s" % (ep.get("season"), ep.get("episode"))
                if ep.get("title"):
                    sub += " · " + ep["title"]
            else:
                sub = "E%s" % ep.get("episode")
                if ep.get("title"):
                    sub += " · " + ep["title"]
            url = show.get("url") or ""
            if url and not url.startswith("http"):
                url = "https://simkl.com" + url
            items.append({"t": int(t), "kind": typ, "title": show.get("title") or "?",
                          "sub": sub, "rel": show.get("poster"), "sid": sid,
                          "url": url, "fin": FINALE.get(e.get("finale_type"), "")})
    items.sort(key=lambda x: x["t"])
    if items:
        with ThreadPoolExecutor(max_workers=min(8, len(items))) as ex:
            posters = list(ex.map(lambda i: poster_path(i["rel"], i["sid"]), items))
        for it, p in zip(items, posters):
            it["poster"] = p
    for it in items:
        it.pop("rel", None)
        it.pop("sid", None)
    return items


def main():
    a = sys.argv[1:]
    if not a:
        log("usage: simkl.py device-start|check <client_id> | fetch <days> <client_id> | logout")
        return 2
    cmd = a[0]
    if cmd == "device-start" and len(a) >= 2:
        return cmd_device_start(a[1])
    if cmd == "check" and len(a) >= 2:
        return cmd_check(a[1])
    if cmd == "logout":
        return cmd_logout()
    if cmd == "fetch" and len(a) >= 3:
        items = cmd_fetch(int(a[1]), a[2])
        if items is None:
            print("[]")
            return 1
        print(json.dumps(items))
        return 0
    log("bad arguments")
    return 2


if __name__ == "__main__":
    sys.exit(main())
OWL_SIMKL_PY
chmod 700 "$t" 2>/dev/null
mv -f "$t" "$d/simkl.py"
echo ok
""") every 12h

  source dev = file("~/.config/omarchy-simkl/device.json") json
  source tok = file("~/.config/omarchy-simkl/token")

  source up = cmd("[ -s ~/.config/omarchy-simkl/token ] && python3 ~/.cache/omalauncher-simkl/simkl.py fetch 7 ${sh(clientId)} || echo '[]'") every 4h json timeout 90s

  // device-start polls Simkl itself until the code is approved, denied or expires,
  // then drops the pending code. It's detached from run()'s 30s cap, so the tile
  // switches over via the device.json/token file sources as soon as they change.
  let logged = trim(tok ?? "") != ""
  // Signing in happens in the background, so fetch the shows as soon as the token appears.
  // null while the file is still loading, so opening the widget fetches only once.
  let signedIn = tok == null ? null : trim(tok) != ""
  on signedIn { refresh() }
  let loading = up == null
  let items = up ?? []
  let code = dev.user_code ?? ""
  let pinUrl = dev.verification_uri_complete ?? "https://simkl.com/pin"

  when logged { refresh() }

  component Show(e) {
    Row {
      gap: 10
      align: center
      onTap: url(e.url)
      if e.poster {
        Image { src: e.poster; width: 40; height: 60; fit: cover; radius: 6 * corners }
      } else {
        Box { width: 40; height: 60; background: surface; radius: 6 * corners; align: center
          Text { text: "?"; style: muted }
        }
      }
      Column {
        gap: 1
        weight: 1
        Text { text: e.title; style: body; maxLines: 1 }
        Text { text: e.sub; style: small; color: muted; maxLines: 1 }
        Text { text: fmtTime(e.t, "EEE d MMM · HH:mm"); style: label; color: accent }
        if e.fin {
          Text { text: e.fin; style: label; color: yellow }
        }
      }
    }
  }

  Column {
    if logged {
      Row {
        align: center
        Text { text: "upcoming"; style: muted; weight: 1 }
        Button { text: "refresh"; onTap: refresh() }
        Button { text: "all ›"; onTap: screen() }
      }
      if loading {
        Text { text: "loading…"; style: small; color: muted }
      } else {
        if len(items) == 0 {
          Text { text: "nothing in the next 7 days"; style: small; color: muted }
        }
        for e in items.take(3) key e.t {
          Show { e: e }
        }
      }
    } else {
      Row {
        align: center
        Text { text: "Simkl"; style: muted; weight: 1 }
      }
      if code != "" {
        Text { text: "1. Open simkl.com/pin"; style: small; color: muted }
        Text { text: code; style: huge; color: accent }
        Text { text: "2. Enter the code, then wait here"; style: small; color: muted }
        Row {
          gap: 8
          Button { text: "open in browser"; onTap: url(pinUrl) }
          Button { text: "refresh"; onTap: run("python3 ~/.cache/omalauncher-simkl/simkl.py check ${sh(clientId)}") }
        }
      } else {
        Text { text: "Connect your Simkl account to see the next week of TV, anime and movies."; style: small; color: muted }
        Button { text: "login with Simkl"; onTap: run("setsid python3 ~/.cache/omalauncher-simkl/simkl.py device-start ${sh(clientId)} >/dev/null 2>&1 &") }
      }
    }
  }

  screen {
    title: "simkl · upcoming"
    Column {
      scroll: true
      gap: 10
      if logged {
        if loading {
          Text { text: "loading…"; style: muted }
        } else {
          if len(items) == 0 {
            Text { text: "nothing in the next 7 days"; style: muted }
          }
          for e in items key e.t {
            Show { e: e }
          }
        }
        Spacer { size: 6 }
        Button { text: "sign out"; onTap: { run("python3 ~/.cache/omalauncher-simkl/simkl.py logout"); refresh() } }
      } else {
        Text { text: "Connect your Simkl account"; style: title }
        if code != "" {
          Text { text: "Open simkl.com/pin and enter this code:"; style: small; color: muted }
          Text { text: code; style: huge; color: accent }
          Row {
            gap: 8
            Button { text: "open in browser"; onTap: url(pinUrl) }
            Button { text: "refresh"; onTap: run("python3 ~/.cache/omalauncher-simkl/simkl.py check ${sh(clientId)}") }
          }
          Text { text: "This screen updates by itself once you approve."; style: label; color: muted }
        } else {
          Button { text: "login with Simkl"; onTap: run("setsid python3 ~/.cache/omalauncher-simkl/simkl.py device-start ${sh(clientId)} >/dev/null 2>&1 &") }
        }
      }
      Button { text: "close"; onTap: close() }
    }
  }
}
