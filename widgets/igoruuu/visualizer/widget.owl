widget "visualizer" {
  size: 3x6
  minSize: 2x4
  padding: 0
  requires { pacman: [] }
  meta { description: "A cava-style spectrum analyzer for whatever is playing on your phone: just the bars, no track info. It animates while music plays. Tap to open the player"; version: "2.0"; license: "MIT"; category: "media" }

  // {available, playing, title, artist, album, app, package, position, duration, art}.
  // Android only shares other apps' sessions with notification access; without it available is false.
  source m = android.media
  let playing = m != null && m.playing == true

  onTap: media("open")

  Box {
    fill: true
    background: background
    clip: true

    Canvas {
      fill: true
      // cava's look: tight blocky bars, a green -> yellow -> red gradient up the screen.
      let n = 44
      let gap = 1
      let bw = max((width - gap * (n - 1)) / n, 1)
      let grad = linear(0, height, 0, 0, [green, yellow, red])
      for i in range(n) {
        let t = n > 1 ? i / (n - 1) : 0
        let x = i * (bw + gap)
        if playing {
          // Low frequencies taller, with a slow wobble so the bars breathe.
          let env = 0.35 + 0.65 * pow(1 - t, 0.6)
          let v = sin(time * (2.4 + (i % 5) * 0.7) + i * 1.3) * 0.5 + 0.5
          let v2 = sin(time * (4.3 + (i % 3) * 0.9) + i * 2.1) * 0.5 + 0.5
          let v3 = sin(time * (6.1 + (i % 7) * 0.5) + i * 0.7) * 0.5 + 0.5
          let amp = clamp(v * 0.5 + v2 * 0.3 + v3 * 0.2, 0, 1)
          let h = (0.06 + 0.9 * amp) * env * height
          rect(x, height - h, bw, h, fill: grad)
        } else {
          // Idle: cava's flat bar heads along the bottom.
          rect(x, height - 0.04 * height, bw, 0.04 * height, fill: grad)
        }
      }
    }
  }
}
