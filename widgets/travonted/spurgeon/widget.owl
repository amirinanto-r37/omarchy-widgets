widget "spurgeon" {
  page: 1
  order: 3
  size: 6x4
  minSize: 3x3
  meta { description: "C. H. Spurgeon's Faith's Check Book entry for the day, from romans45.org. Tap it to read the whole thing"; version: "1.0"; license: "MIT"; category: "news"; owl: 5 }

  // A plain GET from the phone: no curl, no Linux. The cgi's markup never varies, so
  // <h2> is the date, <H4> the entry's title, <H3><I> the verse, and the paragraphs are
  // the bits of text between tags that end in <P>.
source fcb = http("https://www.romans45.org/fcb/fcb.cgi") every 24h timeout 15s status
source now = clock every 1m
  let html = fcb.out ?? ""
  let date = trim(match(html, "<h2> ?([^<]*)</h2>")[0] ?? "")
  let title = trim(match(html, "<H4>([^<]*)</H4>")[0] ?? "")
  let verse = trim(match(html, "<H3><I>([^<]*)</I></H3>")[0] ?? "")
  // The scripture reference is the verse's last bracket, "(Matthew 10:32)".
  let ref = match(verse, "^(.*) ?\\(([^()]+)\\)$")[1] ?? ""
  let quoted = ref ? replace(verse, " (${ref})", "") : verse
  let paras = matchAll(html, "([^<>]+)<P>").map(m => trim(m[0])).filter(p => len(p) > 0)
// The cgi's day is the server's, so it can run ahead of or behind the phone's; the date
// then shows yellow, and the screen's refresh button picks up a day-old entry.
let fresh = date == fmtTime(now, "EEEE, MMMM d, yyyy")

// One fetch a day, at 05:00 by the phone's clock. "at" runs even with the page off screen,
// and needs no live source. It re-arms a day on, not from `now`: off screen the clock doesn't
// tick, so `now` is still before 05:00 and would give the same time, which `at` doesn't run
// twice. armedAt isn't persisted, so a missed hour doesn't fire on the next start: the
// source runs once at startup anyway.
let midnight = now - (num(fmtTime(now, "H")) * 3600 + num(fmtTime(now, "m")) * 60)
let fetchAt = midnight + 5 * 3600 + (midnight + 5 * 3600 > now ? 0 : 86400)
state armedAt = 0
when armedAt == 0 && now != null { armedAt = fetchAt }
at armedAt {
  refresh()
  armedAt = armedAt + 24h
}

  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  // The day's text, set off by a rule in the margin.
  component Verse(limit) {
    Row {
      gap: 8
      align: top
      Spacer { width: 2; height: 44; background: alpha(accent, 0.5) }
      Text { text: verse; style: small; italic: true; weight: 1; maxLines: limit }
    }
  }

  if len(paras) == 0 {
    Column {
      gap: 2
      Text { text: "spurgeon"; style: muted }
      Text { text: fcb == null ? "…" : fcb.ok ? "no entry today" : "offline"; style: title; color: muted }
    }
  } else {
    // One column, whatever the tile's size. The gaps between the blocks are Spacers, so
    // they survive justify: spaceBetween, which hands any slack it has to the gaps too.
    Column {
      gap: 0
      justify: spaceBetween
      Row {
        gap: 6
        Text { text: "spurgeon"; style: muted; width: 90; maxLines: 1 }
        Text { text: fresh ? lower(fmtTime(now, "EEE, MMM d")) : date; style: small; color: fresh ? muted : yellow; weight: 1; align: end; maxLines: 1 }
      }
      Spacer { height: 8 }
      Text { text: title; style: title; color: accent; maxLines: 2 }
      Spacer { height: 10 }
      Verse { limit: 4 }
      Spacer { height: 10 }
      Column {
        gap: 10
        // Only a tile with room for it gets the second paragraph.
        for p in paras.take((rows ?? 3) >= 4 ? 2 : 1) key p {
          Text { text: p; style: small; color: muted; maxLines: 4 }
        }
      }
    }
  }

  screen {
    title: "Faith's Check Book"
    if len(paras) == 0 {
      Text { text: fcb == null ? "…" : fcb.ok ? "no entry today" : "couldn't reach romans45.org"; style: body; color: muted }
    } else {
      Column {
        scroll: true
        gap: 16
        Row {
          Text { text: date; style: label; color: fresh ? accent : yellow; width: 190; maxLines: 1 }
          Text { text: "C. H. Spurgeon"; style: small; color: muted; weight: 1; align: end; maxLines: 1 }
        }
        Text { text: title; style: huge }
        // The day's text, set off by a rule in the margin.
        Row {
          gap: 12
          align: top
          Spacer { width: 3; height: 56; background: alpha(accent, 0.6) }
          Column {
            gap: 6
            weight: 1
            Text { text: quoted; style: body; italic: true }
            Text { text: ref; style: label; color: accent }
          }
        }
        Rule { }
        for p in paras {
          Text { text: p; style: body }
        }
        Rule { }
        Row {
          gap: 8
          Button { text: "refresh"; color: muted; onTap: refresh() }
          Button { text: "copy"; color: muted; onTap: copy("${title}\n\n${verse}\n\n${join(paras, "\n\n")}") }
          Button { text: "open the page ↗"; color: muted; onTap: url("https://www.romans45.org/fcb/fcb.cgi") }
        }
      }
    }
  }
}