widget "nasa photo of the day" {
  page: 1
  order: 35
  size: 3x4
  minSize: 3x3
  padding: 0

  meta { owl: 7; description: "NASA's picture of the day: swipe through the last week of photos on the tile, tap for a full-screen view with the story behind each one."; version: "1.1"; license: "MIT"; category: "world" }

  requires { pacman: ["curl", "file"] }

  // APOD now lives on science.nasa.gov, whose own WordPress API serves it: no key and
  // no rate limit worth worrying about. api.nasa.gov answers DEMO_KEY with a logo.
  source aps = http("https://science.nasa.gov/wp-json/wp/v2/apod-basic?per_page=14&_orderby=date&order=desc") every 30m json timeout 20s status

  // Each photo is fetched once and kept in ~/.cache/nasa, as a small copy for the tile
  // and a phone-sized one for the screen. Slot i points at whatever sits at i in the
  // list above, and s<i>.txt names the files (small, big, credit, story); the names
  // carry the download's time, so a redone download is read again. The slot paths never
  // move, which is what lets the tile follow the day's photos.
  source s0 = file("~/.cache/nasa/s0.txt")
  source s1 = file("~/.cache/nasa/s1.txt")
  source s2 = file("~/.cache/nasa/s2.txt")
  source s3 = file("~/.cache/nasa/s3.txt")
  source s4 = file("~/.cache/nasa/s4.txt")
  source s5 = file("~/.cache/nasa/s5.txt")
  source s6 = file("~/.cache/nasa/s6.txt")
  source s7 = file("~/.cache/nasa/s7.txt")

  state idx = 0 persist
  state dragX = 0
  state dragY = 0
  state dragAt = 0
  state fired = 0
  state fresh = 0

  // A photo of the day is sometimes a video, which has nothing to show in a tile.
  let photos = ((aps.ok ? aps.out : null) ?? []).filter(p => p.media_type == "image").take(8)

  let slot = [s0, s1, s2, s3, s4, s5, s6, s7]
  // What the cache holds stands in for the list when the phone can't reach NASA, so a
  // tile that has pictures keeps showing them, with their words, until it does.
  let n = max(count(photos), count(slot.filter(f => (f ?? "") != "")))
  let cur = photos[clamp(idx, 0, max(n - 1, 0))] ?? {}
  let rec = lines(slot[clamp(idx, 0, 7)] ?? "")
  let thumb = rec[0] ? "~/.cache/nasa/" + rec[0] : ""
  let full = rec[1] ? "~/.cache/nasa/" + rec[1] : ""
  let when = cur.date ?? rec[2] ?? ""
  let title = cur.title ?? rec[3] ?? "…"
  let credit = rec[4] ?? ""
  let story = rec[5] ?? ""
  let page = cur.permalink ?? (len(when) >= 10 ? "https://apod.nasa.gov/apod/ap" + sub(replace(when, "-", ""), 2, 8) + ".html" : "")

  // Five values per photo: date, image, title, credit, story. NASA resizes its
  // pictures on the fly, so both copies come out of one picture without installing
  // anything here to do it. Fetching is slow the first time (NASA makes each size as
  // it is asked), so the eight go out together and only what is missing is fetched
  // again next time.
  // They go to the command as one shell word, so nothing in them can run as code,
  // and % between the values with % taken out of them first lets the command split
  // them apart again. The ~ behind each photo keeps an empty story from being the
  // last value, which a shell drops when it splits a word apart.
  let jobs = photos.map(p => [p.date ?? "", split(p.hdurl ?? p.url ?? "", "?")[0], p.title ?? "", p.credit ?? "", p.explanation ?? ""].map(v => replace(v ?? "", "%", " ")).join("%") + "%~%").join("")

  source pics = cmd("blob=${sh(jobs)};" + """
    d=$HOME/.cache/nasa
    mkdir -p "$d"
    rm -f "$d"/[cdtx]*.part

    # One word in, the five values of each photo out, ~ ending every photo. The URL
    # had its % turned into spaces too; a URL has no spaces, so they go back.
    spaces=$IFS
    IFS='%'
    set -f
    set -- $blob
    set +f
    IFS=$spaces

    j=0
    k=0
    for w in "$@"; do
      i=$((j / 6))
      case $((j % 6)) in
      0) dt=$w; printf "%s" "$dt" > "$d/d$i.part" ;;
      1) u=${w// /%} ;;
      2) printf "%s" "$w" > "$d/t$i.part" ;;
      3) printf "%s" "$w" > "$d/c$i.part" ;;
      4) printf "%s" "$w" > "$d/x$i.part" ;;
      5)
         (
           if [ ! -s "$d/$dt-t.jpg" ]; then
             curl -sfL --max-time 60 "$u?w=540&h=640&fit=clip&crop=focalpoint" -o "$d/$dt-t.jpg.part" &&
               mv -f "$d/$dt-t.jpg.part" "$d/$dt-t.jpg"
           fi
           if [ ! -s "$d/$dt-f.jpg" ]; then
             curl -sfL --max-time 120 "$u?w=1080&h=1920&fit=clip&crop=focalpoint" -o "$d/$dt-f.jpg.part" &&
               mv -f "$d/$dt-f.jpg.part" "$d/$dt-f.jpg"
           fi
         ) &
         k=$((k + 1))
         [ $((k % 8)) -eq 0 ] && wait ;;
      esac
      j=$((j + 1))
    done
    wait

    # Point slot i at what is in the cache now, and write down what it is: the names,
    # the date, the words, and how many pixels the big copy is, so the screen can
    # give the picture the shape it really has.
    i=0
    while [ $i -lt $k ]; do
      dt=$(cat "$d/d$i.part")
      a=$(sed "s/<[^>]*>//g;s/&amp;/\\&/g;s/&nbsp;/ /g;s/&quot;/\"/g;s/&#8217;/\\x27/g" "$d/t$i.part")
      c=$(sed "s/<[^>]*>//g;s/&amp;/\\&/g;s/&nbsp;/ /g;s/&quot;/\"/g;s/&#8217;/\\x27/g" "$d/c$i.part")
      t=$(sed "s/<[^>]*>//g;s/&amp;/\\&/g;s/&nbsp;/ /g;s/&quot;/\"/g;s/&#8217;/\\x27/g;s/&#8212;/ - /g" "$d/x$i.part" | tr "\n\t" "  ")
      if [ -s "$d/$dt-t.jpg" ] && [ -s "$d/$dt-f.jpg" ]; then
        v=$(stat -c %Y "$d/$dt-f.jpg")
        sz=$(file -b "$d/$dt-f.jpg" 2>/dev/null | grep -oE "[0-9]+ *x *[0-9]+" | head -1)
        pw=${sz%x*}; pw=${pw// /}
        ph=${sz#*x}; ph=${ph// /}
        printf "%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n" "t$i-$v.jpg" "f$i-$v.jpg" "$dt" "$a" "$c" "$t" "$pw" "$ph" > "$d/s$i.txt.part"
        # Nothing to do when the slot already says this: swapping the files about
        # under the tile would make it read a picture that isn't there any more.
        if [ ! -s "$d/s$i.txt" ] || [ "$(cat "$d/s$i.txt")" != "$(cat "$d/s$i.txt.part")" ]; then
          mv -f "$d/s$i.txt.part" "$d/s$i.txt"
        fi
        # And a link that went missing is put back pointing at the same picture.
        [ -s "$d/t$i-$v.jpg" ] || ln -f "$d/$dt-t.jpg" "$d/t$i-$v.jpg"
        [ -s "$d/f$i-$v.jpg" ] || ln -f "$d/$dt-f.jpg" "$d/f$i-$v.jpg"
      fi
      i=$((i + 1))
    done

    # Keep the last day or so of downloads. The slot links are the eight the slots
    # name and nothing else: an old rule kept the newest sixteen, which quietly took
    # links away from a slot still using them.
    ls -t "$d"/20??-??-??-*.jpg 2>/dev/null | tail -n +25 | while read -r f; do rm -f "$f"; done
    for l in "$d"/[tf]*-*.jpg; do
      grep -Fxqs "${l##*/}" "$d"/s*.txt || rm -f "$l"
    done
    rm -f "$d"/*.part
    exit 0
  """) every 30m timeout 180s

  onTap: screen()

  // A dot for every photo, wide enough to tap when a swipe isn't wanted.
  component Pager {
    Row {
      gap: 0
      for i in range(max(n, 1)) {
        Box {
          width: i == idx ? 16 : 10
          height: 16
          align: center
          onTap: { idx = i; haptic() }
          Box { width: i == idx ? 10 : 4; height: 4; radius: 2; background: i == idx ? #ffffff : alpha(#ffffff, 0.45) }
        }
      }
    }
  }

  Box {
    fill: true
    clip: true
    radius: 8 * corners
    background: surface

    // A swipe turns one page, as soon as the finger has gone far enough in either
    // direction, and only once per gesture.
    onDrag: {
      fresh = time - dragAt > 0.3
      dragX = (fresh ? 0 : dragX) + dx
      dragY = (fresh ? 0 : dragY) + dy
      dragAt = time
      idx = fired == 1 || max(abs(dragX), abs(dragY)) < 44 ? idx : (idx + (dragX < 0 ? 1 : -1) + max(n, 1)) % max(n, 1)
      fired = fresh || max(abs(dragX), abs(dragY)) < 44 ? 0 : 1
    }

    if thumb != "" {
      Image { src: thumb; fill: true; fit: cover }
    } else {
      Text { text: n > 0 ? "fetching pictures…" : "no pictures yet"; style: small; color: muted; align: center }
    }

    // Just enough shade at the edges for the words to sit on.
    Canvas {
      fill: true
      rect(0, 0, width, height * 0.22, fill: linear(0, 0, 0, height * 0.22, [rgb(0, 0, 0, 0.55), rgb(0, 0, 0, 0)]))
      rect(0, height * 0.35, width, height * 0.65, fill: linear(0, height * 0.35, 0, height, [rgb(0, 0, 0, 0), rgb(0, 0, 0, 0.85)]))
    }

    Column {
      fill: true
      justify: start
      align: start
      padding: 10
      Row {
        fill: width
        gap: 6
        Text { text: (tileWidth ?? 200) > 260 ? "NASA photo of the day" : "NASA"; style: label; color: #ffffff; bold: true; width: (tileWidth ?? 200) > 260 ? 200 : 42 }
        Text { text: when; style: small; color: alpha(#ffffff, 0.8); weight: 1; align: end }
      }
    }

    Column {
      fill: true
      justify: end
      align: start
      padding: 10
      gap: 4
      Text { text: title; style: body; bold: true; color: #ffffff; maxLines: 2 }
      Row {
        fill: width
        Pager { }
        Text { text: n > 0 ? "${idx + 1} / ${n}" : "—"; style: small; color: alpha(#ffffff, 0.9); width: 40; align: end }
      }
      Text { text: first(split(credit, ",")); style: small; color: alpha(#ffffff, 0.75); maxLines: 1 }
    }
  }

  screen {
    title: "NASA photo of the day"

    // The picture takes the width the screen has, or the height it can spare,
    // whichever the picture's own shape reaches first, so it is shown whole and with
    // no empty band above or below it. The shape is what the cache measured.
    let shownW = num(rec[6] ?? "", 0)
    let shownH = num(rec[7] ?? "", 0)
    let shaped = shownW > 0 && shownH > 0
    let room = (screenWidth ?? 400) - 24
    let cap = (screenHeight ?? 800) * 0.55
    let byWidth = room * shownH / shownW
    let shotW = !shaped ? room : (byWidth <= cap ? room : cap * shownW / shownH)
    let shotH = !shaped ? cap : (byWidth <= cap ? byWidth : cap)

    Column {
      gap: 10

      Box {
        fill: width
        align: center
        Box {
          width: shotW
          height: shotH
          clip: true
          radius: 8 * corners
          background: surface
          onDrag: {
            fresh = time - dragAt > 0.3
            dragX = (fresh ? 0 : dragX) + dx
            dragY = (fresh ? 0 : dragY) + dy
            dragAt = time
            idx = fired == 1 || max(abs(dragX), abs(dragY)) < 44 ? idx : (idx + (dragX < 0 ? 1 : -1) + max(n, 1)) % max(n, 1)
            fired = fresh || max(abs(dragX), abs(dragY)) < 44 ? 0 : 1
          }
          if full != "" {
            Image { src: full; fill: true; fit: contain }
          } else {
            Text { text: "fetching picture…"; style: small; color: muted; align: center }
          }
        }
      }

      Text { text: title; style: title; maxLines: 2 }

      Row {
        gap: 8
        align: center
        Button { text: "‹ prev"; onTap: { idx = (idx - 1 + max(n, 1)) % max(n, 1); haptic() } }
        Text { text: n > 0 ? "${idx + 1} / ${n}" : ""; style: small; color: muted; weight: 1; align: center }
        Button { text: "next ›"; onTap: { idx = (idx + 1) % max(n, 1); haptic() } }
      }

      Text { text: credit == "" ? when : "${when} · ${credit}"; style: small; color: muted; maxLines: 1 }

      Column {
        scroll: true
        weight: 1
        Text { text: story == "" ? "No story yet." : story; style: small; color: muted }
      }

      Row {
        gap: 8
        Button { text: "newest"; color: accent; onTap: { idx = 0; haptic() } }
        if page != "" { Button { text: "read on nasa.gov ↗"; color: muted; onTap: url(page) } }
        Button { text: "close"; color: muted; onTap: close() }
      }
    }
  }
}