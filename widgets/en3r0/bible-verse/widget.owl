widget "bible" {
  size: 6x3
  minSize: 3x2
  requires { pacman: [] }
  meta {
    owl: 7
    description: "The NIV verse of the day. Tap for the full verse with copy and share. Needs no packages and keeps the last verse when offline."
    version: "1.0"
    license: "MIT"
    category: "news"
  }

  // ourmanna.com serves one NIV verse a day
  source day = http("https://beta.ourmanna.com/api/v1/get/?format=json") every 1h json timeout 10s
  state last = null persist

  let fresh = day.verse.details.text == null ? null : { text: trim(replace(day.verse.details.text, "\n", " ")), ref: day.verse.details.reference }
  let shown = fresh ?? last
  let long = len(shown.text ?? "") > 220

  // keep the last verse so the tile still has one offline
  on fresh.text { last = fresh }

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: fresh == null && last != null ? "last verse" : "verse of the day"; style: label; color: muted; weight: 1 }
      Text { text: "NIV"; style: label; color: accent; width: 32; align: end }
    }
    Text { text: shown == null ? "…" : shown.text; style: body; fontSize: long ? 13 : 16; italic: true; maxLines: long ? 8 : 5; weight: 1 }
    Text { text: shown.ref ?? ""; style: label; color: accent; align: end }
  }

  screen {
    title: "${shown.ref ?? "verse of the day"} · NIV"
    Column {
      scroll: true
      gap: 12
      padding: 8
      Text { text: shown.text ?? "…"; style: body; fontSize: 20; maxLines: 60 }
      Text { text: shown.ref ?? ""; color: accent }
      Row {
        gap: 8
        Button { text: "copy"; onTap: { copy("${shown.text} — ${shown.ref} (NIV)"); haptic() } }
        Button { text: "share"; onTap: share("${shown.text} — ${shown.ref} (NIV)") }
        Button { text: "close"; onTap: close() }
      }
      Text { text: "Verse of the day from ourmanna.com"; style: small; color: muted }
    }
  }
}
