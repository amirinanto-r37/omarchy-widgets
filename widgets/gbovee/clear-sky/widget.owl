widget "clear sky" {
  meta { owl: 6; description: "Clear Sky Charts from cleardarksky.com for the observing sites you add; tap for a large view and to manage sites"; version: "1.6"; license: "MIT"; category: "world" }
  page: 2
  order: 4
  size: 6x2
  minSize: 4x2

  requires { pacman: ["curl", "jq", "findutils", "diffutils", "gawk", "glibc"] }

  // Chart keys, as in cleardarksky.com/c/<key>key.html
  state sites = [] persist
  state sel = 0 persist
  state rotated = true
  state msg = ""
  state zoom = 1
  state px = 0
  state py = 0
  // Show only the chart's first 24 hours, on the tile and the screen.
  state oneDay = false persist

  // Downloads each chart in $K into ~/.cache/cleardarksky when it's over 30 min old, and lists
  // every chart in the cache in charts.json as [{key, name, path, ok}], so copies of the widget
  // with other sites don't drop each other's. A key whose first download failed gets a .fail
  // marker and ok: false; one not listed yet is still loading. A changed chart gets a new file
  // name so the image reloads. Re-run by refresh() when the sites change; the widget reads
  // charts.json through file(), which updates as soon as it's written.
  let keys = join(sites, " ")
  source fetched = cmd("""
    K=${sh(keys)}
    c=~/.cache/cleardarksky
    mkdir -p "$c"
    for k in $K; do
      k=$(printf %s "$k" | tr -cd A-Za-z0-9)
      [ -n "$k" ] || continue
      f=$(ls -t "$c/$k"-*.gif 2>/dev/null | head -1)
      if [ -z "$f" ] || [ -n "$(find "$f" -mmin +30)" ]; then
        if curl -fsm 20 -o "$c/$k.tmp" "https://www.cleardarksky.com/c/"$k"csk.gif"; then
          if [ -n "$f" ] && cmp -s "$c/$k.tmp" "$f"; then
            touch "$f"; rm -f "$c/$k.tmp"
          else
            n="$c/$k-$(date +%s).gif"; mv "$c/$k.tmp" "$n"
            [ -n "$f" ] && rm -f "$f"; f=$n
          fi
        fi
      fi
      if [ -n "$f" ]; then rm -f "$c/$k.fail"; else : > "$c/$k.fail"; fi
      if [ ! -s "$c/$k.name" ]; then
        curl -fsm 10 "https://www.cleardarksky.com/c/"$k"key.html" |
          grep -o '<title>[^<]*' | head -1 | sed 's/<title>//; s/ Clear Sky Chart$//' > "$c/$k.name"
      fi
    done
    for k in $(ls "$c" | sed -n 's/^\([A-Za-z0-9]*\)\(-[0-9]*[.]gif\|[.]fail\)$/\1/p' | sort -u); do
      f=$(ls -t "$c/$k"-*.gif 2>/dev/null | head -1)
      name=$(cat "$c/$k.name" 2>/dev/null)
      jq -cn --arg key "$k" --arg name "$name" --arg path "$f" \
        --arg size "$([ -n "$f" ] && od -An -tu2 -j6 -N4 "$f")" \
        '{key: $key, name: (if $name == "" then $key else $name end), path: $path, ok: ($path != ""),
          w: ($size | split(" ") | map(select(. != "") | tonumber) | .[0]), h: ($size | split(" ") | map(select(. != "") | tonumber) | .[1])}'
    done | jq -cs . > "$c/charts.$$.tmp" && mv "$c/charts.$$.tmp" "$c/charts.json"
  """) every 30m timeout 60s
  source chartsFile = file("~/.cache/cleardarksky/charts.json") json
  let charts = chartsFile == "" ? null : chartsFile
  on keys { refresh() }

  let list = charts ?? []
  let i = clamp(sel, 0, max(len(sites) - 1, 0))
  let cur = list.find(c => c.key == sites[i])

  // A chart's hour columns are 14 px apart from x = 134, the same in every chart, so its first
  // 24 hours (with the row labels) are the left 470 px. Charts are about 1280 x 290 px.
  let iw = cur.w ?? 1284
  let ih = cur.h ?? 292
  let cw = oneDay ? min(470, iw) : iw
  // Rough bounds for panning in handlers; the Canvas clamps exactly when it draws.
  let viewW = screenWidth ?? 400
  let viewH = (screenHeight ?? 800) - 280
  let fitF = rotated ? min(viewW / ih, viewH / cw) : min(viewW / cw, viewH / ih)
  let panX = max(0, ((rotated ? ih : cw) * fitF * zoom - viewW) / 2)
  let panY = max(0, ((rotated ? cw : ih) * fitF * zoom - viewH) / 2)

  // Lists charts: a state's or province's page when `browse` is set, else the site's search for
  // `query`. State pages are kept for a day. Writes {q, p, items: [{key, name, region, bortle, about}]} to list.json.
  // Re-run by refresh() from the taps that change them.
  state view = "chart"
  state query = ""
  state browse = ""
  state filter = ""
  // The chart tapped in a list, added only once "ok" confirms it.
  state picked = ""
  source listed = cmd("""
    P=${sh(browse)}
    Q=${sh(query)}
    c=~/.cache/cleardarksky
    mkdir -p "$c"
    P=$(printf %s "$P" | tr -cd A-Za-z_)
    if [ -n "$P" ]; then
      f="$c/state-$P.html"
      [ -s "$f" ] && [ -z "$(find "$f" -mmin +1440)" ] ||
        curl -fsm 25 -o "$f" "https://www.cleardarksky.com/csk/prov/$P"_charts.html || rm -f "$f"
      html=$(cat "$f" 2>/dev/null)
    elif [ -n "$Q" ]; then
      html=$(curl -fsm 25 "https://www.cleardarksky.com/cgi-bin/find_chart.py?type=text&keys=$(jq -rn --arg q "$Q" '$q | @uri')")
    fi
    printf %s "$html" | iconv -f latin1 -t utf-8 |
      awk -v state="$P" 'BEGIN { RS = "<tr valign=top>"; FS = sprintf("%c", 31) } NR > 1 && match($0, /c[/][A-Za-z0-9]+key[.]html/) {
        k = substr($0, RSTART + 2, RLENGTH - 10)
        n = match($0, /key[.]html[?]1>[^<]*/) ? substr($0, RSTART + 11, RLENGTH - 11) : k
        r = match($0, /_charts[.]html>[^<]*/) ? substr($0, RSTART + 13, RLENGTH - 13) : state
        b = match($0, /Bortle Class: [0-9.]+/) ? substr($0, RSTART + 14, RLENGTH - 14) : ""
        d = $0
        sub(/^.*Bortle Class[^<]*<[/]td><[/]tr><[/]table><[/]td>/, "", d)
        sub(/^.*_charts[.]html>[^<]*<[/]a>/, "", d)
        sub(/<[/]table>.*$/, "", d)
        gsub(/<[^>]*>/, "", d); gsub(/&nbsp;/, " ", d); gsub(/[[:space:]]+/, " ", d)
        gsub(/_/, " ", r)
        print k FS n FS r FS b FS d
      }' | head -1000 |
      jq -R 'split([31] | implode) | map(gsub("&amp;"; "&") | gsub("&#39;"; [39] | implode) | sub("^ +"; "") | sub(" +$"; "")) |
        {key: .[0], name: .[1], region: .[2], bortle: .[3], about: .[4]}' |
      jq -sc --arg q "$Q" --arg p "$P" '{q: $q, p: $p, items: .}' > "$c/list.$$.tmp" && mv "$c/list.$$.tmp" "$c/list.json"
  """) every 24h timeout 60s
  source listFile = file("~/.cache/cleardarksky/list.json") json
  let found = listFile == "" ? null : listFile
  let ready = found != null && found.q == query && found.p == browse
  let pickedRow = (found.items ?? []).find(r => r.key == picked)
  let matches = (found.items ?? []).filter(r => filter == "" || contains(lower("${r.name} ${r.about}"), lower(filter)))

  // The regions cleardarksky.com has chart pages for, as in /csk/prov/<name>_charts.html
  let regions = [
    {name: "United States", items: ["Alabama", "Alaska", "Arizona", "Arkansas", "California", "Colorado", "Connecticut", "DC", "Delaware", "Florida", "Georgia", "Idaho", "Illinois", "Indiana", "Iowa", "Kansas", "Kentucky", "Louisiana", "Maine", "Maryland", "Massachusetts", "Michigan", "Minnesota", "Mississippi", "Missouri", "Montana", "Nebraska", "Nevada", "New_Hampshire", "New_Jersey", "New_Mexico", "New_York", "North_Carolina", "North_Dakota", "Ohio", "Oklahoma", "Oregon", "Pennsylvania", "Rhode_Island", "South_Carolina", "South_Dakota", "Tennessee", "Texas", "Utah", "Vermont", "Virginia", "Washington", "West_Virginia", "Wisconsin", "Wyoming"]},
    {name: "Canada", items: ["Alberta", "British_Columbia", "Manitoba", "New_Brunswick", "Newfoundland", "Northwest_Territories", "Nova_Scotia", "Nunavut", "Ontario", "Prince_Edward_Island", "Quebec", "Saskatchewan", "Yukon"]},
    {name: "Mexico", items: ["Baja_California", "Chihuahua", "Sonora"]},
    {name: "Bahamas", items: ["Cat_Island", "Grand_Bahama", "New_Providence"]}
  ]

  onTap: screen()

  // A spinning arc next to the text, for whatever is still downloading.
  component Loading(caption) {
    Row {
      align: center
      Canvas {
        size: 18
        arc(width / 2, height / 2, width / 2 - 2, 0, 360, stroke: alpha(accent, 0.25), width: 2.5)
        arc(width / 2, height / 2, width / 2 - 2, time * 360 % 360, 90, stroke: accent, width: 2.5, cap: round)
      }
      Text { text: caption; style: muted; weight: 1 }
    }
  }

  if len(sites) == 0 {
    // Nothing to show yet: invite adding a site, straight to the search or the state list.
    Column {
      gap: 6
      fill: true
      justify: center
      align: center
      Text { text: "no observing site yet"; style: body; bold: true; align: center }
      Text { text: "add a Clear Sky Chart to see tonight's clouds, seeing and darkness"; style: small; color: muted; align: center; maxLines: 2 }
      Row {
        justify: center
        Button { text: "search"; onTap: { view = "chart"; screen() } }
        Button { text: "browse states"; onTap: { view = "states"; screen() } }
      }
    }
  } else {
    Column {
      gap: 4
      Row {
        Text { text: cur.name ?? sites[i]; style: body; bold: true; maxLines: 1; weight: 1 }
        if len(sites) > 1 {
          Button { text: "‹"; onTap: sel = (i + len(sites) - 1) % len(sites) }
          Text { text: "${i + 1}/${len(sites)}"; style: muted; width: 36; align: center }
          Button { text: "›"; onTap: sel = (i + 1) % len(sites) }
        }
      }
      if cur.ok {
        Canvas {
          fill: width
          weight: 1
          let f = min(width / cw, height / ih)
          let l = (width - cw * f) / 2
          let t = (height - ih * f) / 2
          clip(l, t, cw * f, ih * f) { image(cur.path, l, t, iw * f, ih * f) }
        }
      } else {
        if cur == null {
          Loading { caption: "loading chart…"; weight: 1 }
        } else {
          Text { text: "chart not found: ${sites[i]}"; style: muted; weight: 1 }
        }
      }
    }
  }

  screen {
    title: "clear sky chart"
    Column {
      gap: 8
      fill: true
      Row {
        Text { text: cur.name ?? sites[i] ?? "no site"; style: title; maxLines: 1; weight: 1 }
        Button { text: rotated ? "flat" : "rotate"; onTap: { rotated = !rotated; zoom = 1; px = 0; py = 0 } }
        Button { text: "web"; onTap: url("https://www.cleardarksky.com/c/${sites[i]}key.html") }
        if len(sites) > 0 {
          Button { text: "remove"; color: red; onTap: { sites = sites.take(i) + sites.drop(i + 1); sel = max(i - 1, 0) } }
        }
      }
      if view == "states" {
        Row {
          Text { text: "pick a state or province"; style: muted; weight: 1 }
          Button { text: "map"; onTap: url("https://www.cleardarksky.com/csk/") }
          Button { text: "back"; onTap: view = "chart" }
        }
        Column {
          gap: 6
          weight: 1
          scroll: true
          for g in regions key g.name {
            Text { text: g.name; style: label; padding: [0, 6, 0, 0] }
            Flow {
              gap: 6
              for r in g.items key r {
                Button { text: replace(r, "_", " "); onTap: { browse = r; query = ""; filter = ""; picked = ""; view = "list"; refresh() } }
              }
            }
          }
        }
      } else if view == "list" {
        Row {
          align: center
          Button { text: "‹"; onTap: { picked = ""; view = browse != "" ? "states" : "chart" } }
          Text { text: browse != "" ? replace(browse, "_", " ") : "“${query}”"; style: body; bold: true; maxLines: 1; weight: 1 }
          Text { text: ready ? "${len(matches)} charts" : ""; style: small; color: muted; width: 96; align: end }
        }
        if browse != "" {
          Input { placeholder: "filter by town or place"; onChange: filter = value }
        }
        if !ready {
          Loading { caption: "loading charts…"; weight: 1 }
        } else if len(matches) == 0 {
          Text { text: browse != "" ? "no charts match" : "no charts match; try a nearby town, or pick a state"; style: muted; weight: 1 }
        } else {
          Column {
            gap: 8
            weight: 1
            scroll: true
            for r in matches.take(120) key r.key {
              let added = contains(sites, r.key)
              let on = picked == r.key
              Row {
                align: center
                padding: [8, 6]
                radius: 6
                background: on ? alpha(accent, 0.18) : alpha(accent, 0)
                border: on ? 1 : 0
                borderColor: accent
                onTap: picked = on ? "" : r.key
                Column {
                  gap: 0
                  weight: 1
                  Text { text: r.name; bold: true; maxLines: 2 }
                  Text { text: "${browse != "" ? "" : r.region + " · "}${r.bortle != "" ? "Bortle ${r.bortle}" : ""}${r.about != "" ? " · ${r.about}" : ""}"; style: small; color: muted; maxLines: 2 }
                }
                if on {
                  Text { text: "󰄬"; font: icon; color: accent; width: 56; align: end }
                } else {
                  Text { text: added ? "added" : ""; style: small; color: muted; width: 56; align: end }
                }
              }
            }
            if len(matches) > 120 { Text { text: "${len(matches) - 120} more; filter to find them"; style: small; color: muted } }
          }
          if pickedRow != null {
            let added = contains(sites, picked)
            Row {
              align: center
              padding: [0, 4, 0, 0]
              Column {
                gap: 0
                weight: 1
                Text { text: pickedRow.name; bold: true; maxLines: 1 }
                Text { text: added ? "already in your sites" : "add to your sites?"; style: small; color: muted }
              }
              Button { text: "cancel"; color: muted; onTap: picked = "" }
              Button {
                text: added ? "show" : "ok"
                onTap: { sel = added ? indexOf(sites, picked) : len(sites); sites = added ? sites : sites + [picked]; picked = ""; view = "chart"; zoom = 1; px = 0; py = 0 }
              }
            }
          }
        }
      } else if cur.ok {
        // Zoomed and panned by hand; drag moves the chart. Rotated a quarter clockwise, the
        // 4.4:1 chart runs down the screen with time at the top.
        Canvas {
          weight: 1
          fill: width
          clip: true
          onDrag: { px = clamp(px + dx, -panX, panX); py = clamp(py + dy, -panY, panY) }
          let aw = rotated ? ih : cw
          let ah = rotated ? cw : ih
          let f = min(width / aw, height / ah) * zoom
          let dw = aw * f
          let dh = ah * f
          let cx = width / 2 + clamp(px, -max(0, (dw - width) / 2), max(0, (dw - width) / 2))
          let cy = height / 2 + clamp(py, -max(0, (dh - height) / 2), max(0, (dh - height) / 2))
          // The chart's own box, before turning it.
          let bw = cw * f
          let bh = ih * f
          if rotated {
            rotate(90, cx, cy) { clip(cx - bw / 2, cy - bh / 2, bw, bh) { image(cur.path, cx - bw / 2, cy - bh / 2, iw * f, bh) } }
          } else {
            clip(cx - bw / 2, cy - bh / 2, bw, bh) { image(cur.path, cx - bw / 2, cy - bh / 2, iw * f, bh) }
          }
        }
        Row {
          Button { text: "−"; onTap: { zoom = max(zoom / 1.5, 1); px = px / 1.5; py = py / 1.5 } }
          Text { text: "${round(zoom, 1)}×"; width: 56; align: center }
          Button { text: "+"; onTap: { zoom = min(zoom * 1.5, 8); px = zoom < 8 ? px * 1.5 : px; py = zoom < 8 ? py * 1.5 : py } }
          Button { text: "fit"; onTap: { zoom = 1; px = 0; py = 0 } }
          Button { text: oneDay ? "all days" : "1 day"; onTap: { oneDay = !oneDay; zoom = 1; px = 0; py = 0 } }
          Text { text: zoom > 1 ? "drag to move" : ""; style: small; color: muted; weight: 1; align: end }
        }
      } else {
        if len(sites) > 0 && cur == null {
          Loading { caption: "loading chart…"; weight: 1 }
        } else {
          Text { text: len(sites) == 0 ? "no sites yet" : "chart not found: ${sites[i]}"; style: muted; weight: 1 }
        }
      }
      Flow {
        gap: 6
        for s, j in sites key s {
          let c = list.find(x => x.key == s)
          Button { text: c.name ?? s; color: j == i ? accent : muted; onTap: { sel = j; zoom = 1; px = 0; py = 0 } }
        }
      }
      Row {
        Input {
          placeholder: "search, or paste a link"
          clear: true
          weight: 1
          onSubmit: {
            msg = contains(value, "/") ? (match(value, "/c/([A-Za-z0-9]+?)(?:key|csk)[.]")[0] == null ? "not a Clear Sky Chart link" : contains(sites, match(value, "/c/([A-Za-z0-9]+?)(?:key|csk)[.]")[0]) ? "already added" : "") : ""
            sel = contains(value, "/") && msg == "" ? len(sites) : sel
            sites = contains(value, "/") && msg == "" ? sites + [match(value, "/c/([A-Za-z0-9]+?)(?:key|csk)[.]")[0]] : sites
            picked = ""
            view = contains(value, "/") ? "chart" : trim(value) != "" ? "list" : view
            browse = contains(value, "/") || trim(value) == "" ? browse : ""
            query = contains(value, "/") ? query : trim(value)
            refresh()
          }
        }
        Button { text: "states"; onTap: view = "states" }
      }
      if msg != "" { Text { text: msg; style: small; color: red } }
    }
  }
}
