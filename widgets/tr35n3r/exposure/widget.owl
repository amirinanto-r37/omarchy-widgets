widget "exposure" {
  size: 3x3
  minSize: 2x2
  requires { pacman: ["iproute2"] }
  meta { owl: 5; description: "Your network's public IP as Shodan InternetDB sees it: open ports, CVEs, tags, ISP and line type. Rechecks when you switch networks; flags carrier (CGNAT) and VPN addresses."; version: "2.0"; license: "MIT"; category: "system" }

  source now = clock every 1m
  // Only for the recheck after a network change, which needs a clock finer than a minute.
  source tick = clock every 5s
  source sys = android.system every 1h

  // The phone's interfaces with a global address: wlan* means Wi-Fi, rmnet*/ccmni* etc. mobile data.
  // Polled often because a change of network is what makes the public IP change.
  source nif = cmd("ip -j addr show scope global 2>/dev/null") every 30s json optional
  let links = (nif ?? []).map(i => {name: i.ifname, addrs: (i.addr_info ?? []).filter(a => a.scope == "global").map(a => a.local)}).filter(l => len(l.addrs) > 0)
  let ifs = links.map(l => l.name)
  // A VPN (tun/wg/ppp/ipsec) hides both: the public IP is then the VPN's. swlan* is a hotspot, not Wi-Fi.
  let onVpn = any(ifs, i => match(i, "^(tun|wg|ppp|ipsec)") != null)
  let onWifi = !onVpn && any(ifs, i => match(i, "^(wlan|eth)") != null)
  let onMobile = !onVpn && !onWifi && any(ifs, i => match(i, "^(rmnet|ccmni|seth|pdp|wwan|v4-rmnet)") != null)
  let netLabel = onVpn ? "vpn" : onWifi ? "wi-fi" : onMobile ? "mobile" : null
  let netKey = nif == null ? null : join(links.map(l => "${l.name}=${join(l.addrs, ",")}"), " ")

  // On a network change: look everything up again now, and once more 20 s later, since
  // Android can take a moment to move its default route. Until then nothing old is shown.
  state recheckAt = 0
  on netKey { recheckAt = tick + 20; q = ""; refresh() }
  when recheckAt > 0 && tick >= recheckAt { recheckAt = 0; q = ""; refresh() }
  let settling = recheckAt > 0

  // Which alerts to post, chosen on the screen.
  state alCves = true persist
  state alMoved = true persist
  state alPorts = false persist
  state alPatch = false persist
  state alMismatch = true persist
  state patchWarned = "" persist
  state mismatchWarned = "" persist

  // The public IPv4, from ipify. Only a well-formed dotted quad is used anywhere else.
  source ipr = http("https://api.ipify.org/?format=json") every 15m json status
  let ip4re = "^(0|[1-9]\\d{0,2})\\.(0|[1-9]\\d{0,2})\\.(0|[1-9]\\d{0,2})\\.(0|[1-9]\\d{0,2})$"
  let ipRaw = ipr.ok ? trim(str(ipr.out.ip ?? "")) : ""
  let ipOct = match(ipRaw, ip4re)
  let ip = ipOct != null && all(ipOct, o => num(o) <= 255) ? ipRaw : null
  // The public IPv6, if this network has one (fails quietly on IPv4-only networks).
  source ipr6 = http("https://api6.ipify.org/?format=json") every 30m json status
  let ip6 = ipr6.ok && contains(str(ipr6.out.ip ?? ""), ":") ? lower(str(ipr6.out.ip)) : null

  // ISP and line type from ip-api.com (free, non-commercial, HTTP only). `mobile` means a
  // cellular network, `proxy`/`hosting` a VPN, proxy or data centre. Never reads location.
  source info = http(ip == null ? "http://ip-api.com/json/?fields=status,query,isp,org,as,countryCode,mobile,proxy,hosting" : "http://ip-api.com/json/${ip}?fields=status,query,isp,org,as,countryCode,mobile,proxy,hosting") every 6h json status
  on ip { refresh() }
  let infoOk = ip != null && info.ok && info.out.status == "success" && info.out.query == ip
  let isp = infoOk ? (info.out.isp ?? info.out.org) : null
  let asNum = infoOk ? first(words(info.out.as ?? "")) : null
  let country = infoOk ? info.out.countryCode : null
  let kind = !infoOk ? null : info.out.proxy == true || info.out.hosting == true ? "vpn/hosting" : info.out.mobile == true ? "mobile network" : "fixed line"
  let kindShort = kind == "vpn/hosting" ? "vpn/dc" : kind == "mobile network" ? "mobile" : kind == "fixed line" ? "fixed" : null
  // On Wi-Fi but the IP is a cellular one: the Wi-Fi has no internet and Android uses mobile
  // data, or the router itself connects over 4G/5G.
  let wifiOverMobile = onWifi && kind == "mobile network" && !settling

  // InternetDB answers 404 both for "not indexed" and for a URL built before the IP loaded,
  // so every lookup starts from a reset: q = "" fetches the fixed openapi.json (a distinct
  // 200), and only once that has arrived is q set to the IP. A result then belongs to q.
  state q = ""
  source db = http(q == "" ? "https://internetdb.shodan.io/openapi.json" : "https://internetdb.shodan.io/${q}") every 2h json status
  let dbReset = db.ok && db.out.openapi != null

  // Reset finished: look up the current IP. IP changed under an old result: reset again.
  // The two conditions exclude each other, and each one's statements make it false.
  when ip != null && dbReset && q != ip { q = ip; refresh() }
  when ip != null && !dbReset && q != "" && q != ip { q = ""; refresh() }

  let valid = !settling && ip != null && q == ip && db != null && !dbReset && (db.code == 404 || (db.code == 200 && db.out.ip == ip))
  let dbFailed = !settling && ip != null && q == ip && db != null && !dbReset && !valid
  let indexed = valid && db.code == 200
  let cur = !valid ? null : {
    ip: ip,
    indexed: indexed,
    nPorts: indexed ? len(db.out.ports ?? []) : 0,
    nVulns: indexed ? len(db.out.vulns ?? []) : 0,
    ports: indexed ? (db.out.ports ?? []).sort().take(100) : [],
    vulns: indexed ? (db.out.vulns ?? []).sort().reverse().take(100) : [],
    tags: indexed ? (db.out.tags ?? []).take(100) : [],
    hostnames: indexed ? (db.out.hostnames ?? []).take(100) : [],
    cpes: indexed ? (db.out.cpes ?? []).take(100) : []
  }
  let curKey = cur == null ? null : "${ip}|${indexed}|${join(cur.ports, ",")}|${join(cur.vulns, ",")}"

  // The last result per IP (10 IPs), for stale display and for spotting new CVEs.
  state snaps = [] persist
  state lastIp = "" persist
  state handled = ""
  state checkedAt = 0
  let prevSnap = ip == null ? null : snaps.find(s => s.ip == ip)
  let newCves = cur == null || prevSnap == null ? [] : cur.vulns.filter(v => !contains(prevSnap.vulns, v))
  let newPorts = cur == null || prevSnap == null ? [] : cur.ports.filter(p => !contains(prevSnap.ports, p))
  let moved = cur != null && lastIp != "" && lastIp != ip && (cur.nPorts > 0 || cur.nVulns > 0) && len(newCves) == 0
  // On mobile data the result is the carrier's: keep the last Wi-Fi one in view.
  let lastWifi = snaps.find(s => s.net == "wi-fi" && s.ip != ip)

  when curKey != null { checkedAt = now }
  // Runs once per new result. No alert on first start (lastIp empty, no snapshot) or for a
  // snapshot already seen; notify() with a null title does nothing.
  when curKey != null && curKey != handled {
    notify(alMoved && moved ? "exposure" : null, "This network exposes ${cur.nPorts} ports, ${cur.nVulns} CVEs")
    notify(alCves && len(newCves) > 0 ? "exposure" : null, "${len(newCves)} new CVEs for ${ip}: ${join(newCves.take(3), ", ")}")
    notify(alPorts && len(newPorts) > 0 ? "exposure" : null, "${len(newPorts)} new open ports on ${ip}: ${join(newPorts.take(8), ", ")}")
    snaps = ([{ip: ip, org: isp, kind: kindShort, net: netLabel, indexed: cur.indexed, nPorts: cur.nPorts, nVulns: cur.nVulns, ports: cur.ports, vulns: cur.vulns, tags: cur.tags, hostnames: cur.hostnames, cpes: cur.cpes, t: now}] + snaps.filter(s => s.ip != ip)).take(10)
    lastIp = ip
    handled = curKey
  }
  // Once per IP.
  when alMismatch && wifiOverMobile && mismatchWarned != ip {
    notify("exposure", "Wi-Fi is on, but ${ip} is a mobile-network IP (${isp ?? "carrier"}). The Wi-Fi may have no internet.")
    mismatchWarned = ip
  }

  // loading, checking, failed, absent (404), ok
  let status = ipr == null ? "loading" : settling ? "checking" : ip == null || dbFailed ? "failed" : valid ? (indexed ? "ok" : "absent") : "checking"
  let stale = status != "failed" ? null : ip != null ? prevSnap : first(snaps)
  let view = valid ? cur : stale
  let sev = view == null || !view.indexed ? muted : view.nVulns > 0 ? red : view.nPorts > 0 ? yellow : green
  let dot = status == "failed" || wifiOverMobile ? yellow : status == "ok" ? sev : muted
  let wide = (cols ?? 3) >= 3

  // Security patch age in days, exactly: days-from-civil (H. Hinnant) for both dates.
  let dayNums = [sys.patch, fmtTime(now, "yyyy-MM-dd")]
    .map(s => match(s ?? "", "^(\\d{4})-(\\d{2})-(\\d{2})"))
    .map(g => g == null ? null : {y: num(g[0]) - (num(g[1]) <= 2 ? 1 : 0), m: num(g[1]), d: num(g[2])})
    .map(c => c == null ? null : {era: floor(c.y / 400), yoe: c.y - floor(c.y / 400) * 400, doy: floor((153 * (c.m + (c.m > 2 ? -3 : 9)) + 2) / 5) + c.d - 1})
    .map(e => e == null ? null : e.era * 146097 + e.yoe * 365 + floor(e.yoe / 4) - floor(e.yoe / 100) + e.doy - 719468)
  let patchAge = dayNums[0] == null || dayNums[1] == null ? null : dayNums[1] - dayNums[0]
  let patchColor = patchAge == null ? muted : patchAge > 90 ? red : patchAge > 60 ? yellow : muted
  // Once per patch level: a newer patch resets it.
  when alPatch && patchAge != null && patchAge > 90 && patchWarned != sys.patch {
    notify("exposure", "Security patch ${sys.patch} is ${patchAge} days old. Check for a system update.")
    patchWarned = sys.patch
  }

  // Manual lookup: same reset rule, on its own source.
  state typed = ""
  state lqTarget = ""
  state lq = ""
  state lqErr = ""
  source lk = http(lq == "" ? "https://internetdb.shodan.io/openapi.json" : "https://internetdb.shodan.io/${lq}") every 6h json status
  let lkReset = lk.ok && lk.out.openapi != null
  when lkReset && lqTarget != "" && lq != lqTarget { lq = lqTarget; refresh() }
  let ip6re = "^(([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}|([0-9a-f]{1,4}:){1,7}:|([0-9a-f]{1,4}:){1,6}:[0-9a-f]{1,4}|([0-9a-f]{1,4}:){1,5}(:[0-9a-f]{1,4}){1,2}|([0-9a-f]{1,4}:){1,4}(:[0-9a-f]{1,4}){1,3}|([0-9a-f]{1,4}:){1,3}(:[0-9a-f]{1,4}){1,4}|([0-9a-f]{1,4}:){1,2}(:[0-9a-f]{1,4}){1,5}|[0-9a-f]{1,4}:(:[0-9a-f]{1,4}){1,6}|:((:[0-9a-f]{1,4}){1,7}|:))$"
  let t4 = match(typed, ip4re)
  let isV4 = t4 != null && all(t4, o => num(o) <= 255)
  let a = isV4 ? num(t4[0]) : -1
  let b = isV4 ? num(t4[1]) : -1
  let priv4 = isV4 && (a == 0 || a == 10 || a == 127 || (a == 100 && b >= 64 && b <= 127) || (a == 169 && b == 254) || (a == 172 && b >= 16 && b <= 31) || (a == 192 && b == 168))
  let isV6 = !isV4 && match(typed, ip6re) != null
  let priv6 = isV6 && (typed == "::" || typed == "::1" || match(typed, "^(0{1,4}:){7}0{0,3}1$") != null || match(typed, "^f[cd][0-9a-f]{2}:") != null || match(typed, "^fe[89ab][0-9a-f]:") != null)
  let typedErr = !isV4 && !isV6 ? "not a valid IPv4 or IPv6 address" : priv4 || priv6 ? "private or reserved address: InternetDB has no reliable data for it" : ""
  let lkValid = lqTarget != "" && lq == lqTarget && lk != null && !lkReset && (lk.code == 404 || (lk.code == 200 && (contains(lq, ":") || lk.out.ip == lq)))
  let lkFailed = lqTarget != "" && lq == lqTarget && lk != null && !lkReset && !lkValid
  let lkIndexed = lkValid && lk.code == 200
  let lkView = !lkValid ? null : {
    ip: lq,
    indexed: lkIndexed,
    nPorts: lkIndexed ? len(lk.out.ports ?? []) : 0,
    nVulns: lkIndexed ? len(lk.out.vulns ?? []) : 0,
    ports: lkIndexed ? (lk.out.ports ?? []).sort().take(100) : [],
    vulns: lkIndexed ? (lk.out.vulns ?? []).sort().reverse().take(100) : [],
    tags: lkIndexed ? (lk.out.tags ?? []).take(100) : [],
    hostnames: lkIndexed ? (lk.out.hostnames ?? []).take(100) : [],
    cpes: lkIndexed ? (lk.out.cpes ?? []).take(100) : []
  }

  onTap: { q = ""; refresh(); screen() }

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  component Heading(caption) {
    Text { text: caption; style: label; color: accent }
  }

  component AlertLabel(label, hint) {
    Column {
      gap: 0
      Text { text: label; style: body }
      Text { text: hint; style: small; color: muted }
    }
  }

  component Plain(label, items) {
    if len(items ?? []) > 0 {
      Column {
        gap: 2
        Heading { caption: "${label} (${len(items)})" }
        Text { text: join(items, "\n"); style: small; font: mono }
      }
    }
  }

  component Fact(label, val, tint = foreground) {
    Row {
      gap: 8
      Text { text: label; style: small; color: muted; width: 84 }
      Text { text: val; style: small; font: mono; color: tint; weight: 1; maxLines: 2 }
    }
  }

  // One result (own network or lookup): ports as chips, CVEs as a scrolling list, then the rest.
  component Details(r) {
    Column {
      gap: 10
      if !r.indexed {
        Text { text: "not in InternetDB. Shodan has no recent record of this IP, which is not the same as safe."; style: small; color: muted }
      } else {
        Column {
          gap: 4
          Heading { caption: "open ports (${r.nPorts})" }
          if r.nPorts == 0 {
            Text { text: "none seen"; style: small; color: green }
          } else {
            Flow {
              gap: 6
              for p in r.ports key p {
                Text { text: str(p); width: len(str(p)) * 8 + 20; align: center; style: small; font: mono; color: r.nVulns > 0 ? red : yellow; padding: [8, 3]; border: 1; borderColor: alpha(muted, 0.4) }
              }
            }
          }
        }
        Column {
          gap: 4
          Heading { caption: "CVEs (${r.nVulns}${r.nVulns > 100 ? ", first 100" : ""})" }
          if r.nVulns == 0 {
            Text { text: "none listed"; style: small; color: green }
          } else {
            Column {
              gap: 6
              scroll: true
              height: min(len(r.vulns) * 26, 260)
              for c in r.vulns key c {
                let ok = match(c, "^CVE-\\d{4}-\\d{4,7}$") != null
                Text { text: ok ? "${c} ↗" : c; style: small; font: mono; color: red; onTap: url(ok ? "https://nvd.nist.gov/vuln/detail/${c}" : null) }
              }
            }
          }
        }
        Plain { label: "hostnames"; items: r.hostnames }
        Plain { label: "tags"; items: r.tags }
        Plain { label: "CPEs"; items: r.cpes }
      }
    }
  }

  Column {
    gap: 1
    Row {
      gap: 6
      align: center
      Text { text: "exposure"; fontSize: 17; bold: true; color: foreground; weight: 1; maxLines: 1 }
      Text { text: netLabel ?? ""; style: small; color: muted; width: 52; align: end; maxLines: 1 }
      Text { text: "●"; style: small; color: dot; width: 14; align: end }
    }
    Text {
      text: settling ? "checking…" : status == "absent" ? "not indexed" : view == null ? (status == "failed" ? "lookup failed" : "…") : "${view.nPorts} port${view.nPorts == 1 ? "" : "s"}"
      style: title
      color: view == null ? (status == "failed" ? yellow : muted) : status == "failed" ? alpha(sev, 0.6) : sev
      maxLines: 1
    }
    Text {
      text: settling ? "network changed" : status == "checking" ? "checking…" : status == "failed" ? (view == null ? "no earlier result" : "stale · ${fmtTime(view.t, "HH:mm")}") : view == null ? "…" : view.indexed ? "${view.nVulns} CVE${view.nVulns == 1 ? "" : "s"}${len(view.tags) > 0 && wide ? " · ${join(view.tags, ", ")}" : ""}" : kind == "mobile network" ? (wide ? "carrier's shared IP" : "carrier IP") : wide ? "not the same as safe" : "≠ safe"
      style: small
      color: status == "failed" ? yellow : view != null && view.nVulns > 0 ? red : muted
      maxLines: 1
    }
    Text { text: settling ? "" : join([isp, kindShort].filter(s => s != null), " · "); style: small; color: muted; maxLines: 1 }
    Text { text: settling || ip == null ? "" : join([ip, country].filter(s => s != null), " · "); style: small; font: mono; color: muted; maxLines: 1 }
    if view != null && view.nPorts > 0 {
      Text { text: join(view.ports.take(24).map(p => str(p)), " "); style: small; font: mono; color: sev; maxLines: (rows ?? 3) >= 3 ? 2 : 1 }
    }
    if wifiOverMobile {
      Text { text: wide ? "wi-fi, but a mobile-network IP" : "wi-fi via mobile?"; style: small; color: yellow; maxLines: 1 }
    }
    if onMobile && lastWifi != null && ((rows ?? 3) >= 3 || view == null || view.nPorts == 0) {
      Text { text: !lastWifi.indexed ? "last wi-fi: not indexed" : "last wi-fi: ${lastWifi.nPorts}p · ${lastWifi.nVulns} CVE"; style: small; color: !lastWifi.indexed ? muted : lastWifi.nVulns > 0 ? red : lastWifi.nPorts > 0 ? yellow : green; maxLines: 1 }
    }
    Spacer { weight: 1 }
    Row {
      gap: 6
      align: center
      Text { text: patchAge == null ? "patch …" : "patch ${patchAge}d"; style: small; color: patchColor; weight: 1; maxLines: 1 }
      Text { text: checkedAt > 0 ? fmtTime(checkedAt, "HH:mm") : ""; style: small; color: muted; width: 48; align: end; maxLines: 1 }
    }
  }

  screen {
    title: "exposure"
    Column {
      scroll: true
      gap: 12
      Row {
        gap: 12
        align: center
        Column {
          gap: 2
          weight: 1
          Text { text: settling ? "checking…" : ip ?? (status == "failed" ? "no public IPv4" : "…"); style: title; font: mono; maxLines: 1; onTap: copy(settling ? null : ip) }
          Text { text: settling ? "network changed" : join([isp, kind].filter(s => s != null), " · "); style: small; maxLines: 2 }
          Text { text: "${country ?? "…"} · ${checkedAt > 0 ? "checked ${fmtTime(checkedAt, "HH:mm")}" : status == "failed" ? "lookup failed" : "checking…"}"; style: small; color: muted; maxLines: 1 }
        }
        Button { text: "refresh"; color: accent; onTap: { q = ""; refresh() } }
      }
      Text { text: "tap the IP to copy it"; style: small; color: muted }
      Rule { }

      Heading { caption: "connection" }
      Column {
        gap: 4
        Fact { label: "network"; val: netLabel ?? (linux ? "unknown" : "needs linux") }
        for l in links key l.name {
          Fact { label: l.name; val: join(l.addrs, "\n"); tint: muted }
        }
        Fact { label: "public v4"; val: settling ? "checking…" : ip ?? "none"; tint: accent }
        Fact { label: "public v6"; val: settling ? "checking…" : ip6 ?? "none"; tint: ip6 == null ? muted : accent }
        Fact { label: "provider"; val: settling ? "…" : join([isp, asNum].filter(s => s != null), " · ") ?? "…" }
        Fact { label: "line"; val: settling ? "…" : kind ?? "…"; tint: kind == "fixed line" ? green : kind == null ? muted : yellow }
      }
      if wifiOverMobile {
        Text { text: "Wi-Fi is on, but your public IP belongs to a mobile network. Either this Wi-Fi has no working internet and Android sends your traffic over mobile data, or the router itself connects over 4G/5G. The result below is about that mobile address."; style: small; color: yellow }
      }
      if onVpn || kind == "vpn/hosting" {
        Text { text: "Your traffic leaves through a VPN, proxy or data centre${len(ifs) > 0 ? " (${join(ifs, ", ")})" : ""}. The result below is about that server, not your network. Turn the VPN off to check your own network."; style: small; color: yellow }
      }
      if onMobile {
        Text { text: "You're on mobile data. Carriers share one public IP among many phones (CGNAT), so this result is about your carrier's address, not your phone. Switch to Wi-Fi to check your own network."; style: small; color: yellow }
      }
      if ip6 != null {
        Button { text: "look up my IPv6"; color: muted; onTap: { lqErr = ""; lqTarget = ip6; lq = ""; refresh() } }
      }
      Text { text: "Provider names are the registered company: \"Salt Mobile SA\", for example, also runs Salt's home fibre. \"line\" says whether the address is mobile, fixed or a VPN/data centre."; style: small; color: muted }
      Rule { }

      Heading { caption: "look up an IP address" }
      Row {
        gap: 8
        align: center
        Input { placeholder: "e.g. 8.8.8.8 or 2001:4860:4860::8888"; clear: true; weight: 1; onChange: typed = lower(trim(value)); onSubmit: { lqErr = typedErr; lqTarget = typedErr == "" ? typed : ""; lq = ""; refresh() } }
        Button { text: "clear"; color: muted; onTap: { lqTarget = ""; lq = ""; lqErr = ""; typed = "" } }
      }
      if lqErr != "" {
        Text { text: lqErr; style: small; color: yellow }
      }
      Rule { }

      if lqTarget != "" {
        Text { text: "lookup: ${lqTarget}"; style: body; font: mono; color: accent; maxLines: 1; onTap: copy(lqTarget) }
        if lkView != null {
          Details { r: lkView }
        } else {
          Text { text: lkFailed ? "lookup failed (HTTP ${lk.code})" : "checking…"; style: small; color: lkFailed ? yellow : muted }
        }
      } else {
        Text { text: netLabel == null ? "this network" : "this network (${netLabel})"; style: body; color: accent }
        if status == "failed" {
          Text { text: view == null ? "lookup failed, no earlier result" : "lookup failed: showing the result from ${fmtTime(view.t, "HH:mm")}${view.ip == ip ? "" : " for ${view.ip}"} (stale)"; style: small; color: yellow }
        }
        if view != null {
          Details { r: view }
        } else {
          Text { text: status == "failed" ? "" : "checking…"; style: small; color: muted }
        }
        if onMobile && lastWifi != null {
          Text { text: "last Wi-Fi: ${lastWifi.ip}${lastWifi.org == null ? "" : " · ${lastWifi.org}"} · ${fmtTime(lastWifi.t, "yyyy-MM-dd HH:mm")}"; style: small; color: muted; onTap: { lqErr = ""; lqTarget = lastWifi.ip; lq = ""; refresh() } }
        }
      }
      Rule { }

      Row {
        gap: 8
        align: center
        Heading { caption: "recent networks (${len(snaps)})"; weight: 1 }
        if len(snaps) > 0 {
          Button { text: "clear"; color: muted; onTap: { snaps = []; handled = "" } }
        }
      }
      if len(snaps) == 0 {
        Text { text: "none yet"; style: small; color: muted }
      }
      for s in snaps key s.ip {
        Row {
          gap: 8
          align: center
          onTap: { lqErr = ""; lqTarget = s.ip; lq = ""; refresh() }
          Column {
            gap: 0
            weight: 1
            Text { text: "${s.ip}${s.ip == ip ? " (now)" : ""}"; style: small; font: mono; color: s.ip == ip ? accent : foreground; maxLines: 1 }
            Text { text: join([s.org, s.kind, s.net].filter(x => x != null), " · ") ?? ""; style: small; color: muted; maxLines: 1 }
          }
          Column {
            gap: 0
            width: 110
            Text { text: !s.indexed ? "not indexed" : "${s.nPorts}p · ${s.nVulns} CVE"; style: small; color: !s.indexed ? muted : s.nVulns > 0 ? red : s.nPorts > 0 ? yellow : green; align: end; maxLines: 1 }
            Text { text: fmtTime(s.t, "yyyy-MM-dd HH:mm"); style: small; color: muted; align: end; maxLines: 1 }
          }
        }
      }
      Text { text: "tap one to look it up again"; style: small; color: muted }
      Rule { }

      Heading { caption: "alerts" }
      Row {
        gap: 8
        align: center
        AlertLabel { label: "new CVEs"; hint: "a CVE appears for your IP that wasn't listed before"; weight: 1 }
        Button { text: alCves ? "on" : "off"; color: alCves ? accent : muted; onTap: alCves = !alCves }
      }
      Row {
        gap: 8
        align: center
        AlertLabel { label: "exposed network"; hint: "you join a network with open ports or CVEs"; weight: 1 }
        Button { text: alMoved ? "on" : "off"; color: alMoved ? accent : muted; onTap: alMoved = !alMoved }
      }
      Row {
        gap: 8
        align: center
        AlertLabel { label: "new open ports"; hint: "a port opens that wasn't there before"; weight: 1 }
        Button { text: alPorts ? "on" : "off"; color: alPorts ? accent : muted; onTap: alPorts = !alPorts }
      }
      Row {
        gap: 8
        align: center
        AlertLabel { label: "wi-fi over mobile"; hint: "once per IP, when Wi-Fi is on but the IP is a mobile one"; weight: 1 }
        Button { text: alMismatch ? "on" : "off"; color: alMismatch ? accent : muted; onTap: alMismatch = !alMismatch }
      }
      Row {
        gap: 8
        align: center
        AlertLabel { label: "old security patch"; hint: "once, when the patch is older than 90 days"; weight: 1 }
        Button { text: alPatch ? "on" : "off"; color: alPatch ? accent : muted; onTap: alPatch = !alPatch }
      }
      Row {
        gap: 8
        Button { text: "all on"; color: accent; onTap: { alCves = true; alMoved = true; alPorts = true; alMismatch = true; alPatch = true } }
        Button { text: "all off"; color: muted; onTap: { alCves = false; alMoved = false; alPorts = false; alMismatch = false; alPatch = false } }
      }
      Rule { }
      Text { text: "security patch ${sys.patch ?? "…"}${patchAge == null ? "" : " · ${patchAge} days old"}"; style: small; color: patchColor }
      Text { text: "Data: Shodan InternetDB (non-commercial use), ipify, ip-api.com (non-commercial use). Snapshot data, not a live scan. Rechecks within a minute of a network change."; style: small; color: muted }
    }
  }
}
