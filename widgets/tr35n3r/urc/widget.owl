widget "urc" {
  size: 6x5
  minSize: 4x4
  requires { pacman: ["curl", "jq"] }
  meta { owl: 5; description: "United Rugby Championship: your starred teams (or the top 5) and the current round in a time zone you pick; tap for the full table."; version: "1.1"; license: "MIT"; category: "sport" }

  // The league: ESPN's id, names, where the table splits, and its finals rounds.
  let fullName = "united rugby championship"
  let cuts = [{at: 8, label: "play-offs"}]
  let finalNames = ["quarter-finals", "semi-finals", "final"]
  let nick = { "Glasgow Warriors": "Glasgow", "Cardiff Blues": "Cardiff", "Benetton Treviso": "Benetton" }
  // Kickoff time zones: the first is the default.
  let presets = [{id: "LON", name: "London", base: 0, dst: "eu"}, {id: "JNB", name: "Jo'burg", base: 2, dst: "no"},
    {id: "PAR", name: "Paris", base: 1, dst: "eu"}, {id: "BER", name: "Berlin", base: 1, dst: "eu"},
    {id: "ZHR", name: "Zürich", base: 1, dst: "eu"}]

  // Seasons run from autumn to June and are named after the year they end in;
  // from July on, show the coming one.
  source now = clock every 1m
  let season = now == null ? null : num(fmtTime(now, "yyyy")) + (num(fmtTime(now, "M")) >= 7 ? 1 : 0)
  // ESPN's public feeds: the table, and the season's whole schedule (grouped into rounds below).
  source sr = http("https://site.api.espn.com/apis/v2/sports/rugby/270557/standings?season=${season}") every 6h timeout 20s json status
  // The season spans two calendar years, which ESPN serves separately: fetch both, keep this
  // season's matches and trim them in jq (each year is ~200 KB with every match's events).
  source fx = cmd("{ curl -sf --compressed --max-time 14 'https://site.api.espn.com/apis/site/v2/sports/rugby/270557/scoreboard?dates=${int(season - 1)}&limit=1000'; curl -sf --compressed --max-time 14 'https://site.api.espn.com/apis/site/v2/sports/rugby/270557/scoreboard?dates=${int(season)}&limit=1000'; } | jq -sc 'if length == 0 then halt_error else {events: [.[].events[] | select(.season.year == ${int(season)}) | {id, date, status: {type: {state: .status.type.state, shortDetail: .status.type.shortDetail}}, competitions: [.competitions[0] | {timeValid, venue: {fullName: .venue.fullName}, competitors: [.competitors[] | {homeAway, score, team: {displayName: .team.displayName}}]}]}] | unique_by(.id)} end'") every 5m timeout 30s json status

  // Starred teams (tap a row in the full table): highlighted, and the tile lists them.
  state favs = [] persist

  let table = sr.out.children[0].standings
  // ESPN gives stats as a list of {name, displayValue}; flatten each team into one row.
  let rows = (table.entries ?? []).map(e => {
    name: e.team.displayName,
    label: get(nick, e.team.displayName, e.team.displayName),
    rank: num(e.stats.find(s => s.name == "rank").displayValue),
    p: num(e.stats.find(s => s.name == "gamesPlayed").displayValue),
    w: e.stats.find(s => s.name == "gamesWon").displayValue,
    d: e.stats.find(s => s.name == "gamesDrawn").displayValue,
    l: e.stats.find(s => s.name == "gamesLost").displayValue,
    pd: e.stats.find(s => s.name == "pointsDifference").displayValue,
    bp: e.stats.find(s => s.name == "bonusPoints").displayValue,
    pts: e.stats.find(s => s.name == "points").displayValue,
    form: e.stats.find(s => s.name == "overall").displayValue ?? ""
  }).sortBy(r => r.rank)
  // Before the first match ESPN ranks alphabetically and keeps last season's form: hide both.
  let started = rows.any(r => r.p > 0)
  let starred = rows.filter(r => contains(favs, r.name))
  let shown = len(starred) > 0 ? starred.take(5) : rows.take(5)
  let topCut = first(cuts).at

  // Kickoffs come as "2027-02-12T06:35Z" (UTC). Split them up, with the year counted from
  // March so leap days fall at its end, then turn them into Unix time (days-from-civil).
  let raw = (fx.out.events ?? []).map(e => {
    c: e.competitions[0],
    home: e.competitions[0].competitors.find(x => x.homeAway == "home"),
    away: e.competitions[0].competitors.find(x => x.homeAway == "away"),
    state: e.status.type.state, detail: e.status.type.shortDetail,
    y: num(sub(e.date, 0, 4)) - (num(sub(e.date, 5, 7)) <= 2 ? 1 : 0),
    doy: floor((153 * ((num(sub(e.date, 5, 7)) + 9) % 12) + 2) / 5) + num(sub(e.date, 8, 10)) - 1,
    mins: num(sub(e.date, 11, 13)) * 60 + num(sub(e.date, 14, 16))
  })
  // Time zone for kickoffs: the presets with their summer time, or a fixed UTC offset.
  state tz = "LON" persist
  state picking = false
  let zones = flatten([presets, range(-12, 15).map(n => {id: n < 0 ? "UTC${n}" : "UTC+${n}", name: "", base: n, dst: ""})])
  let zone = zones.find(z => z.id == tz) ?? zones[0]
  // European summer time in the season's two years, as Unix times: last Sunday of March to
  // last Sunday of October, 01:00 UTC. yb is the day number of 1 March - 1 of a year;
  // day n is a Sunday when (n + 4) % 7 == 0.
  let dstSpans = [season - 1, season].map(y => {yb: floor(y / 400) * 146097 + (y % 400) * 365 + floor((y % 400) / 4) - floor((y % 400) / 100) - 719468})
    .map(a => {from: (a.yb + 30 - (a.yb + 34) % 7) * 86400 + 3600, to: (a.yb + 244 - (a.yb + 248) % 7) * 86400 + 3600})
  let wdays = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]
  let months = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]

  let schedule = raw.map(r => {
    t: (floor(r.y / 400) * 146097 + (r.y % 400) * 365 + floor((r.y % 400) / 4) - floor((r.y % 400) / 100) + r.doy - 719468) * 86400 + r.mins * 60,
    home: r.home.team.displayName, away: r.away.team.displayName, hs: r.home.score, as: r.away.score,
    state: r.state, detail: r.detail, venue: r.c.venue.fullName ?? "",
    // ESPN puts a kickoff that isn't fixed yet at 00:00 UTC on its day.
    tbc: r.c.timeValid == false,
    homeLabel: get(nick, r.home.team.displayName, r.home.team.displayName),
    awayLabel: get(nick, r.away.team.displayName, r.away.team.displayName)
  }).map(g => {
    t: g.t, home: g.home, away: g.away, hs: g.hs, as: g.as, state: g.state, detail: g.detail, venue: g.venue,
    tbc: g.tbc, homeLabel: g.homeLabel, awayLabel: g.awayLabel,
    fav: contains(favs, g.home) || contains(favs, g.away),
    // Rounds by match week (Tuesday to Monday, UTC).
    week: floor((g.t + 172800) / 604800),
    // Kickoff shifted into the chosen zone, to be read with UTC arithmetic.
    lt: g.tbc ? g.t : g.t + 3600 * (zone.base + (zone.dst == "eu" && dstSpans.any(s => g.t >= s.from && g.t < s.to) ? 1 : 0))
  }).sortBy(g => g.t)
  // Weeks without matches don't count.
  let weeks = unique(schedule.map(g => g.week))
  // The current round holds the next match not yet finished (by state, or by time when
  // ESPN is slow to mark it); after the season, the last one.
  let current = schedule.find(g => g.state != "post" && g.t + 9000 > now) ?? last(schedule)
  let wi = current == null ? null : indexOf(weeks, current.week)
  let games = schedule.filter(g => g.week == current.week)
  // Rounds, read from the schedule (ESPN doesn't number them): a full round has the usual
  // number of matches. Weeks with fewer than half of that hold rearranged matches, and the
  // weeks after the last full one are the finals.
  let perWeek = weeks.map(w => count(schedule, g => g.week == w))
  let usual = first(unique(perWeek).sortBy(n => -count(perWeek, m => m == n)))
  let lastFull = len(perWeek) == 0 ? null : last(range(len(perWeek)).filter(i => perWeek[i] >= usual))
  let roundNo = wi == null ? null : len(range(wi + 1).filter(i => perWeek[i] * 2 >= usual))
  let roundTitle = wi == null ? "fixtures"
    : wi > lastFull ? (finalNames[wi - lastFull - 1] ?? "finals · week ${wi - lastFull}")
    : perWeek[wi] * 2 < usual ? "rearranged · after round ${roundNo}"
    : "round ${roundNo}"
  // Tiles under 6 columns get a tighter round header and match rows.
  let narrow = (cols ?? 6) < 6
  // The round's first and last day in the chosen zone (civil-from-days, step by step).
  let ends = (len(games) == 0 ? [] : [first(games).lt, last(games).lt])
    .map(s => {z: floor(s / 86400) + 719468})
    .map(a => {doe: a.z - floor(a.z / 146097) * 146097})
    .map(a => {doe: a.doe, yoe: floor((a.doe - floor(a.doe / 1460) + floor(a.doe / 36524) - floor(a.doe / 146096)) / 365)})
    .map(a => {doy: a.doe - (365 * a.yoe + floor(a.yoe / 4) - floor(a.yoe / 100))})
    .map(a => {doy: a.doy, mp: floor((5 * a.doy + 2) / 153)})
    .map(a => {d: a.doy - floor((153 * a.mp + 2) / 5) + 1, m: a.mp < 10 ? a.mp + 3 : a.mp - 9})
  let a0 = first(ends)
  let a1 = last(ends)
  let roundDates = len(ends) == 0 ? "" : a0.d == a1.d && a0.m == a1.m ? "${a0.d} ${months[a0.m - 1]}" : a0.m == a1.m ? "${a0.d}–${a1.d} ${months[a1.m - 1]}" : "${a0.d} ${months[a0.m - 1]} – ${a1.d} ${months[a1.m - 1]}"
  // The offset in force during this round (summer time may differ from today's).
  let timed = games.find(g => !g.tbc)
  let off = timed == null ? zone.base : (timed.lt - timed.t) / 3600
  let zoneLabel = zone.dst == "" ? zone.id : "${zone.id} · UTC${off < 0 ? "" : "+"}${off}"

  onTap: screen()

  // Recent results as coloured letters, oldest to newest, this season's only.
  // ESPN lists them newest first and writes draws as T.
  component Form(f, n) {
    let k = min(len(f), n)
    Row { gap: 2; width: 70
      for i in range(k) {
        let c = sub(f, k - 1 - i, k - i)
        Text { text: c == "T" ? "D" : c; fontSize: 11; font: mono; bold: true; width: 12; align: center
          color: c == "W" ? green : c == "D" || c == "T" ? yellow : alpha(foreground, 0.35) }
      }
    }
  }

  component Head(t, w) {
    Text { text: t; style: label; color: muted; width: w; align: end; maxLines: 1 }
  }

  // The time-zone dropdown: a chip showing the zone, and the list it opens.
  component ZoneChip(fs = 11, compact = false) {
    Text { text: "${compact ? zone.id : zoneLabel} ${picking ? "▴" : "▾"}"; fontSize: fs; font: mono; color: accent; maxLines: 1
      border: 1; borderColor: alpha(accent, 0.6); padding: [8, 3]; onTap: picking = !picking }
  }
  component ZoneOpt(z, fs = 12) {
    Text { text: z.name == "" ? z.id : "${z.id} ${z.name}"; fontSize: fs; font: mono; maxLines: 1
      align: center; color: z.id == tz ? background : foreground; background: z.id == tz ? accent : alpha(muted, 0.15)
      padding: [8, 4]; onTap: { tz = z.id; picking = false } }
  }
  component ZonePicker(fs = 12, n = 4) {
    Column { gap: 6
      Grid { gap: 6; columns: 3
        for z in presets key z.id { ZoneOpt { z: z; fs: fs } }
      }
      Grid { gap: 6; columns: n
        for z in zones.filter(z => z.dst == "") key z.id { ZoneOpt { z: z; fs: fs } }
      }
    }
  }

  // One match: kickoff (local time) or status, home, score, away.
  component Game(g, size = 12, tight = false) {
    let live = g.state == "in"
    let done = g.state == "post"
    let homeWon = num(g.hs) > num(g.as)
    let awayWon = num(g.as) > num(g.hs)
    let day = wdays[(floor(g.lt / 86400) + 4) % 7]
    Row {
      gap: tight ? 4 : 6
      align: center
      Text { text: live ? g.detail : done ? "ft" : g.tbc ? "${day} tbc" : "${day} ${pad(floor((g.lt % 86400) / 3600), 2, "0")}:${pad(floor((g.lt % 3600) / 60), 2, "0")}"; fontSize: size - 1; font: mono; color: live ? accent : muted; width: tight ? 50 : 72; maxLines: 1 }
      Text { text: g.homeLabel; fontSize: size; maxLines: 1; weight: 1; align: end; bold: contains(favs, g.home)
        color: done && !homeWon ? alpha(foreground, 0.5) : foreground }
      Text { text: done || live ? "${g.hs}–${g.as}" : "v"; fontSize: size; font: mono; bold: done || live; width: tight ? 34 : 50; align: center
        color: live ? accent : done ? foreground : muted }
      Text { text: g.awayLabel; fontSize: size; maxLines: 1; weight: 1; bold: contains(favs, g.away)
        color: done && !awayWon ? alpha(foreground, 0.5) : foreground }
    }
  }

  Column {
    gap: 5
    Row {
      align: center
      Text { text: fullName; fontSize: 16; color: foreground; weight: 1 }
      Text { text: season == null ? "" : "${season - 1}/${season % 100}"; style: label; color: muted; width: 60; align: end }
    }
    if sr != null && !sr.ok {
      Text { text: "standings unavailable"; style: small; color: muted }
    }
    Row {
      gap: 6
      Text { text: "#"; style: label; color: muted; width: 22 }
      Text { text: "team"; style: label; color: muted; weight: 1 }
      Head { t: "w-l"; w: 40 }
      Head { t: "pd"; w: 40 }
      Head { t: "pts"; w: 30 }
      if started && cols >= 6 { Text { text: "form"; style: label; color: muted; width: 70; align: center } }
    }
    for r in shown key r.name {
      Row {
        gap: 6
        align: center
        Text { text: started ? "${r.rank}" : "–"; font: mono; color: started && r.rank <= topCut ? accent : muted; width: 22; bold: true }
        Text { text: r.label; maxLines: 1; weight: 1 }
        Text { text: "${r.w}-${r.l}"; font: mono; fontSize: 13; color: muted; width: 40; align: end }
        Text { text: r.pd; font: mono; fontSize: 13; color: num(r.pd) > 0 ? green : num(r.pd) < 0 ? alpha(foreground, 0.45) : muted; width: 40; align: end }
        Text { text: r.pts; font: mono; bold: true; width: 30; align: end }
        if started && cols >= 6 { Form { f: r.form; n: r.p } }
      }
    }
    Spacer { height: 1; fill: width; background: alpha(muted, 0.4) }
    Row {
      align: center
      Text { text: narrow ? replace(roundTitle, " · after", "") : roundTitle; style: label; color: accent; weight: 1; maxLines: 1 }
      Text { text: roundDates; style: label; color: muted; width: narrow ? 90 : 110; align: end; maxLines: 1 }
      ZoneChip { compact: narrow; width: narrow ? 64 : 130 }
    }
    if fx != null && (!fx.ok || len(schedule) == 0) {
      Text { text: fx.ok ? "no fixtures yet" : "fixtures unavailable"; style: small; color: muted }
    }
    if picking {
      Column { gap: 3; weight: 1; scroll: true
        ZonePicker { n: (cols ?? 6) >= 6 ? 4 : 3 }
      }
    } else {
      // The matches share out the height left, so the tile has no empty bottom.
      Column { gap: 3; weight: 1; justify: spaceEvenly
        for g in games key "${g.t}${g.home}" {
          Game { g: g; size: narrow ? 12 : 13; tight: narrow }
        }
      }
    }
  }

  screen {
    title: "${fullName} ${season == null ? "" : "${season - 1}/${season % 100}"}"
    Column {
      gap: 8
      scroll: true
      if !started {
        Text { text: "the season hasn't started: the table fills in after round 1"; style: small; color: muted }
      }
      Text { text: "tap a team to star it: starred teams are highlighted and fill the tile"; style: small; color: muted }
      Row {
        gap: 4
        Text { text: "#"; style: label; color: muted; width: 22 }
        Text { text: "team"; style: label; color: muted; weight: 1 }
        Head { t: "p"; w: 22 }
        Head { t: "w"; w: 22 }
        Head { t: "d"; w: 22 }
        Head { t: "l"; w: 22 }
        Head { t: "pd"; w: 40 }
        Head { t: "bp"; w: 26 }
        Head { t: "pts"; w: 32 }
        Spacer { width: 16 }
      }
      for r in rows key r.name {
        let fav = contains(favs, r.name)
        let cut = cuts.find(c => c.at == r.rank)
        Column {
          gap: 4
          Row {
            gap: 4
            align: center
            padding: [0, 4]
            background: fav ? alpha(accent, 0.12) : null
            onTap: favs = fav ? favs.filter(f => f != r.name) : flatten([favs, [r.name]])
            Text { text: started ? "${r.rank}" : "–"; font: mono; bold: true; color: fav ? accent : muted; width: 22 }
            Text { text: r.label; maxLines: 1; weight: 1; bold: fav; color: fav ? foreground : alpha(foreground, 0.75) }
            Text { text: "${r.p}"; font: mono; fontSize: 13; color: muted; width: 22; align: end }
            Text { text: r.w; font: mono; fontSize: 13; width: 22; align: end }
            Text { text: r.d; font: mono; fontSize: 13; color: muted; width: 22; align: end }
            Text { text: r.l; font: mono; fontSize: 13; width: 22; align: end }
            Text { text: r.pd; font: mono; fontSize: 13; color: num(r.pd) > 0 ? green : num(r.pd) < 0 ? alpha(foreground, 0.45) : muted; width: 40; align: end }
            Text { text: r.bp; font: mono; fontSize: 13; color: muted; width: 26; align: end }
            Text { text: r.pts; font: mono; bold: true; width: 32; align: end }
            Text { text: fav ? "★" : "☆"; color: fav ? accent : alpha(muted, 0.6); width: 16; align: end }
          }
          if started && cut != null {
            Row { gap: 6; align: center
              Spacer { height: 1; weight: 1; background: alpha(accent, 0.5) }
              Text { text: cut.label; style: label; color: accent; width: 110; align: center }
              Spacer { height: 1; weight: 1; background: alpha(accent, 0.5) }
            }
          }
        }
      }
      Spacer { height: 4 }
      Spacer { height: 1; fill: width; background: alpha(muted, 0.4) }
      Spacer { height: 4 }
      Row {
        align: center
        Text { text: roundTitle; style: title; color: accent; weight: 1 }
        Text { text: roundDates; style: small; color: muted; width: 120; align: end }
      }
      Row {
        align: center
        Text { text: "kickoff times"; style: small; color: muted; weight: 1 }
        ZoneChip { fs: 13; width: 170 }
      }
      if picking { ZonePicker { fs: 14 } }
      for g in games key "${g.t}${g.home}" {
        Column {
          gap: 2
          padding: [0, 6]
          background: g.fav ? alpha(accent, 0.08) : null
          Game { g: g; size: 14 }
          Text { text: g.venue; style: small; color: muted; align: center; maxLines: 1 }
        }
      }
      Spacer { height: 8 }
      Text { text: "lines mark ${join(cuts.map(c => c.label), " and ")} · times in ${zone.dst == "" ? zone.id : zone.name} · source: espn"; style: small; color: muted }
      Spacer { height: 4 }
      Button { text: "close"; onTap: close() }
    }
  }
}
