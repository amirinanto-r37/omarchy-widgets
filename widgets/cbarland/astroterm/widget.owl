widget "astroterm" {
  size: 6x6
  minSize: 4x4
  padding: 8

  meta {
    owl: 6
    description: "Interactive Astroterm sky map with startup IP location, manual coordinates, and saved display settings."
    version: "1.6"
    license: "MIT"
    category: "world"
  }
  requires { pacman: ["astroterm", "curl", "bash"] }

  state showHeader = false
  onTap: showHeader = true

  state autoLocation = true persist
  state lastLocation = null persist
  state locationStarted = false
  state locating = true
  state locationResponse = ""
  let geo = locationResponse == "" ? null : parseJson(locationResponse)
  let detected = geo.success && geo.latitude != null && geo.longitude != null ? geo : null
  // One lookup per widget startup; ordinary taps and setting changes do not run it.
  when !locationStarted { locationStarted = true; locationResponse = run("""curl --silent --fail --max-time 15 'https://ipwho.is/?fields=success,city,country,latitude,longitude' || printf '{"success":false}'""") }
  on locationResponse {
    lastLocation = detected ?? lastLocation
    locating = value == ""
  }

  state latitude = 0 persist
  state longitude = 0 persist
  state colorful = true persist
  state unicode = true persist
  state constellations = true persist
  state grid = false persist
  state metadata = false persist
  state magnitude = 5 persist
  state labels = 0.25 persist
  state speed = 1 persist
  state fps = 10 persist

  let location = lastLocation
  let activeLatitude = autoLocation ? num(location.latitude) : latitude
  let activeLongitude = autoLocation ? num(location.longitude) : longitude
  let locationReady = activeLatitude != null && activeLongitude != null
  let locationLabel = autoLocation ? (locationReady ? "≈ ${location.city ?? location.country ?? 'Network location'}" : "Location unavailable") : "${fixed(latitude, 2)}°, ${fixed(longitude, 2)}°"


  Box {
    fill: true
    Column {
      fill: true
      gap: showHeader ? 6 : 0
      Row {
        visible: showHeader
        Column {
          weight: 1
          gap: 0
          Text { text: "astroterm"; style: label }
          Text { text: locationLabel; style: small; maxLines: 1 }
        }
        Button { text: "settings"; onTap: screen() }
        Button { text: "hide"; onTap: showHeader = false }
      }
      if locationReady {
        Terminal { command: """set -- --latitude ${sh(activeLatitude)} --longitude ${sh(activeLongitude)} --threshold ${sh(magnitude)} --label-thresh ${sh(labels)} --speed ${sh(speed)} --fps ${sh(fps)}
if [ ${sh(colorful)} = true ]; then set -- "$@" --color; fi
if [ ${sh(unicode)} = true ]; then set -- "$@" --unicode; fi
if [ ${sh(constellations)} = true ]; then set -- "$@" --constellations; fi
if [ ${sh(unicode)} = true ] && [ ${sh(constellations)} = true ]; then set -- "$@" --braille; fi
if [ ${sh(grid)} = true ]; then set -- "$@" --grid; fi
if [ ${sh(metadata)} = true ]; then set -- "$@" --metadata; fi
exec astroterm "$@"
"""; fontSize: 6; weight: 1; fill: width }
      } else {
        Text { text: locating ? "Finding your location…" : "Location unavailable. Tap for settings to retry or enter coordinates."; weight: 1; fill: width }
      }
    }
    // Catch the first tap above the terminal, which handles its own touches.
    Box { fill: true; visible: !showHeader; onTap: showHeader = true }
  }

  screen {
    title: "Astroterm settings"
    Column {
      scroll: true
      fill: true
      gap: 12
      Text { text: "Observing location"; style: title }
      Button { text: autoLocation ? "Location: automatic" : "Location: manual"; onTap: autoLocation = !autoLocation }
      Text { text: locationLabel; style: body }
      Text { text: "Automatic location is approximate, based on your phone's public IP through ipwho.is. A VPN can change it. For precise positioning, enter coordinates below."; style: small; color: muted }
      Button { text: locating ? "Locating…" : "Re-locate now"; onTap: { locating = true; autoLocation = true; locationResponse = ""; locationResponse = run("""curl --silent --fail --max-time 15 'https://ipwho.is/?fields=success,city,country,latitude,longitude' || printf '{"success":false}'""") } }
      Text { text: "Location is assigned once at startup. Re-locate now updates it on demand; a failed lookup keeps the previous location."; style: small; color: muted }
      Text { text: "Coordinates in degrees. North and east are positive; south and west are negative."; style: small }
      Text { text: "Latitude: ${latitude}°  (−90 to 90)"; style: label }
      Input { text: str(latitude); placeholder: "latitude"; onSubmit: { latitude = clamp(num(value, latitude), -90, 90); autoLocation = false } }
      Text { text: "Longitude: ${longitude}°  (−180 to 180)"; style: label }
      Input { text: str(longitude); placeholder: "longitude"; onSubmit: { longitude = clamp(num(value, longitude), -180, 180); autoLocation = false } }
      Text { text: "Press the keyboard's send key to save each coordinate."; style: small; color: muted }

      Text { text: "Display"; style: title }
      Button { text: "Colors: ${colorful ? 'on' : 'off'}"; color: colorful ? accent : muted; onTap: colorful = !colorful }
      Button { text: "Unicode symbols: ${unicode ? 'on' : 'off'}"; color: unicode ? accent : muted; onTap: unicode = !unicode }
      Button { text: "Constellation lines: ${constellations ? 'on' : 'off'}"; color: constellations ? accent : muted; onTap: constellations = !constellations }
      Button { text: "Azimuth grid: ${grid ? 'on' : 'off'}"; color: grid ? accent : muted; onTap: grid = !grid }
      Button { text: "Observation details: ${metadata ? 'on' : 'off'}"; color: metadata ? accent : muted; onTap: metadata = !metadata }

      Text { text: "Stars"; style: title }
      Text { text: "Magnitude limit: ${fixed(magnitude, 1)}" }
      Slider { value: magnitude; min: 0; max: 8; step: 0.5; onChange: magnitude = value }
      Text { text: "Higher values show more faint stars and constellation lines."; style: small; color: muted }
      Text { text: "Label magnitude limit: ${fixed(labels, 2)}" }
      Slider { value: labels; min: -2; max: 5; step: 0.25; onChange: labels = value }
      Text { text: "Higher values label more stars and can crowd the view."; style: small; color: muted }

      Text { text: "Time and animation"; style: title }
      Text { text: "Time speed: ${speed}×" }
      Row {
        wrap: true
        for rate in [0, 1, 60, 3600] {
          Button { text: rate == 0 ? "pause" : "${rate}×"; color: speed == rate ? accent : muted; onTap: speed = rate }
        }
      }
      Text { text: "Refresh rate: ${fps} FPS" }
      Slider { value: fps; min: 1; max: 24; step: 1; onChange: fps = value }
      Text { text: "Lower refresh rates use less power. Settings are saved and update the tile's sky view."; style: small; color: muted }
      Button { text: "Open larger sky view"; visible: locationReady; onTap: terminal("""set -- --latitude ${sh(activeLatitude)} --longitude ${sh(activeLongitude)} --threshold ${sh(magnitude)} --label-thresh ${sh(labels)} --speed ${sh(speed)} --fps ${sh(fps)}
if [ ${sh(colorful)} = true ]; then set -- "$@" --color; fi
if [ ${sh(unicode)} = true ]; then set -- "$@" --unicode; fi
if [ ${sh(constellations)} = true ]; then set -- "$@" --constellations; fi
if [ ${sh(unicode)} = true ] && [ ${sh(constellations)} = true ]; then set -- "$@" --braille; fi
if [ ${sh(grid)} = true ]; then set -- "$@" --grid; fi
if [ ${sh(metadata)} = true ]; then set -- "$@" --metadata; fi
exec astroterm "$@"
""", "Astroterm") }
      Text { text: "Tap the terminal to interact. Press q or Escape to exit; tap restart to return to the sky."; style: small; color: muted }
      Button { text: "Back to sky tile"; onTap: close() }
    }
  }
}
