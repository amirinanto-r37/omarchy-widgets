widget "Spreedy" {
  size: 6x3
  minSize: 4x2
  padding: 12
  meta { owl: 6; description: "One-word speed reader for EPUB and text files, with adjustable WPM."; version: "1.13"; license: "MIT"; category: "productivity" }
  requires { pacman: ["python"] }
  state path = "" persist
  state draft = ""
  state wpm = 300 persist
  state swipeSeconds = 5 persist
  state bookmark = 0 persist
  state chunk = 0
  state playing = false
  state started = 0
  state origin = 0
  state settings = true
  state resume = false
  state swipeDistance = 0
  state swipeLast = 0
  state skipRequested = 0
  state skipDirection = 0
  state skipFeedbackUntil = 0
  state swipeHandled = false
  // Offline default: Lewis Carroll, Alice’s Adventures in Wonderland, Chapter I.
  // Source: https://www.gutenberg.org/files/11/11-h/11-h.htm
  let reader = """
import sys,json,pathlib,zipfile,posixpath,re,xml.etree.ElementTree as ET
def tokenize(text):
 slash=chr(92)
 return re.sub(f"(?<=[^{slash}W_])(?:[^{slash}w{slash}s]|_)+(?=[^{slash}W_])", " ", text).split()
def context(words,offset):
 return dict(before=words[offset-1] if offset>0 and offset<=len(words) else "",after=words[offset+600] if offset+600<len(words) else "")
from html.parser import HTMLParser
class Text(HTMLParser):
 def __init__(self): super().__init__(); self.parts=[]; self.skip=0
 def handle_starttag(self,t,a):
  if t in ('script','style'): self.skip+=1
  if t in ('p','div','br','li','h1','h2','h3'): self.parts.append(' ')
 def handle_endtag(self,t):
  if t in ('script','style'): self.skip=max(0,self.skip-1)
  self.parts.append(' ')
 def handle_data(self,s):
  if not self.skip: self.parts.append(s)
try:
 p=pathlib.Path(sys.argv[1]).expanduser(); offset=max(0,int(sys.argv[2]))*600
 if not sys.argv[1]:
  import base64,zlib
  words=zlib.decompress(base64.b64decode('')).decode()
  words=tokenize(words)
  print(json.dumps(dict(words=words[offset:offset+600],total=len(words),title='Alice · Down the Rabbit-Hole',chunk=offset//600,**context(words,offset)))); sys.exit()
 if p.suffix.lower()=='.epub':
  with zipfile.ZipFile(p) as z:
   container=ET.fromstring(z.read('META-INF/container.xml'))
   opf=next(e.attrib['full-path'] for e in container.iter() if e.tag.endswith('rootfile'))
   root=ET.fromstring(z.read(opf)); base=posixpath.dirname(opf)
   manifest={e.attrib['id']:e.attrib for e in root.iter() if e.tag.endswith('}item')}
   sections=[]
   for e in root.iter():
    if e.tag.endswith('}itemref') and e.attrib.get('linear','yes')!='no':
     item=manifest[e.attrib['idref']]
     if item.get('media-type') in ('application/xhtml+xml','text/html'):
      from urllib.parse import unquote
      parser=Text(); parser.feed(z.read(posixpath.normpath(posixpath.join(base,unquote(item['href'].split('#')[0])))).decode('utf-8-sig',errors='replace')); sections.append(''.join(parser.parts))
   text=' '.join(sections)
 else:
  if p.suffix.lower() not in ('.txt','.text','.md'): raise ValueError('Choose an .epub or .txt file')
  raw=p.read_bytes(); text=raw.decode('utf-16' if raw[:2] in (b'\\xff\\xfe',b'\\xfe\\xff') else 'utf-8-sig',errors='replace')
 words=tokenize(text)
 if not words: raise ValueError('No readable text found')
 print(json.dumps(dict(words=words[offset:offset+600],total=len(words),title=p.stem,chunk=offset//600,**context(words,offset))))
except Exception as e: print(json.dumps(dict(error=str(e),words=[],total=0,title='Unable to load',chunk=0)))
"""
  source book = cmd("python -c " + sh(reader) + " " + sh(path) + " " + sh(chunk)) every 1h json
  let total = book.total ?? 0
  let ready = book != null && book.chunk == chunk && len(book.words) > 0
  let local = bookmark - chunk * 600
  // One deadline per loaded chunk; no recurring timer while paused.
  let boundary = min(total - 1, (chunk + 1) * 600)
  let boundaryAt = playing && ready ? started + max(0, boundary - origin) * 60 / wpm : 0
  at boundaryAt {
    bookmark = boundary; playing = false
    resume = bookmark < total - 1
    chunk = floor(bookmark / 600)
    refresh()
  }
  on book {
    origin = resume && ready ? bookmark : origin; started = resume && ready ? time : started; playing = resume && ready; resume = false
  }
  when skipRequested != 0 {
    skipDirection = skipRequested
    skipFeedbackUntil = time + 0.8
    bookmark = clamp((playing && ready ? min(total - 1, origin + floor(max(0, time - started) * wpm / 60)) : bookmark) + skipRequested * round(wpm * swipeSeconds / 60), 0, max(0, total - 1))
    resume = playing; playing = false
    origin = bookmark; started = time
    chunk = floor(bookmark / 600)
    skipRequested = 0; refresh()
  }
  component WordDrawing(animated = false) {
    Canvas {
      fill: true
      let position = animated ? min(total - 1, origin + floor(max(0, time - started) * wpm / 60)) : bookmark
      let local = position - chunk * 600
      let word = ready ? (book.words[local] ?? "…") : "…"
      // Focus moves toward the first third as words grow; opening punctuation is skipped.
      let opening = startsWith(word, "“") || startsWith(word, "\"") || startsWith(word, "'") || startsWith(word, "(") ? 1 : 0
      let letters = max(1, len(word) - opening)
      let focus = min(len(word) - 1, opening + (letters <= 1 ? 0 : letters <= 5 ? 1 : letters <= 9 ? 2 : letters <= 13 ? 3 : 4))
      let previousWord = ready ? (local > 0 ? book.words[local - 1] : book.before) : ""
      let nextWord = ready ? (local + 1 < len(book.words) ? book.words[local + 1] : book.after) : ""
      let shown = len(word) > 80 ? sub(word, 0, 79) + "…" : word
      let anchor = width * 0.42
      let font = min(36, min(36, height * 0.4), min((anchor - 12) / max(1, focus + 0.5), (width - anchor - 12) / max(1, len(shown) - focus - 0.5)) / 0.61)
      let advance = font * 0.61
      let middle = height / 2
      let gap = font * 0.85
      let wordLeft = anchor - (focus + 0.5) * advance
      let wordRight = anchor + (len(shown) - focus - 0.5) * advance
      // Context shares the reading line; overflow disappears at the tile edges.
      clip(12, 0, max(0, width - 24), height) {
        text(previousWord, wordLeft - advance, middle, size: font, align: end, color: alpha(muted, 0.65), bold: true)
        text(nextWord, wordRight + advance, middle, size: font, align: start, color: alpha(muted, 0.65), bold: true)
      }
      // A stable target above and below the focus character, away from the word.
      line(12, middle - gap - 8, width - 12, middle - gap - 8, stroke: alpha(muted, 0.25), width: 1)
      line(12, middle + gap + 8, width - 12, middle + gap + 8, stroke: alpha(muted, 0.25), width: 1)
      line(anchor, middle - gap - 8, anchor, middle - gap, stroke: accent, width: 2)
      line(anchor, middle + gap, anchor, middle + gap + 8, stroke: accent, width: 2)
      for i in range(len(shown)) {
        text(sub(shown, i, i + 1), anchor + (i - focus) * advance, middle, size: font, align: center, color: i == focus ? accent : foreground, bold: true)
      }
      line(anchor - advance * 0.42, middle + font * 0.65, anchor + advance * 0.42, middle + font * 0.65, stroke: accent, width: 2, cap: round)
      // No feedback frame clock while paused.
      let feedback = playing ? clamp((skipFeedbackUntil - time) / 0.3, 0, 1) : 0
      let badgeY = max(17, middle - gap - 29)
      if feedback > 0 {
        rect(width / 2 - 86, badgeY - 15, 172, 30, radius: 6 * corners, fill: alpha(accent, feedback))
        text(skipDirection > 0 ? "← Forward ${swipeSeconds}s" : "Back ${swipeSeconds}s →", width / 2, badgeY, size: 14, align: center, color: alpha(background, feedback), bold: true)
      }
    }
  }
  component Reader(availableHeight = 0, availableWidth = 0) {
    let expanded = availableHeight > 420
    let passageCount = min(240, max(40, floor((availableHeight - 250) / 22) * max(1, floor((availableWidth - 24) / 65))))
    let passageStart = floor(local / passageCount) * passageCount
    let passage = ready ? book.words.drop(passageStart).take(passageCount) : []
    Column {
      fill: true; gap: 8
      Row {
        Text { text: book.title ?? "Spreedy"; style: small; maxLines: 1; weight: 1 }
        Text { text: "${wpm} wpm · ${swipeSeconds}s"; style: muted; width: 130; align: end }
        Button { text: "⚙"; onTap: { bookmark = playing && ready ? min(total - 1, origin + floor(max(0, time - started) * wpm / 60)) : bookmark; playing = false; resume = false; settings = true; screen() } }
      }
      Box {
        weight: 1; fill: width; align: center
        onTap: { bookmark = playing && ready ? min(total - 1, origin + floor(max(0, time - started) * wpm / 60)) : bookmark; origin = bookmark; started = time; resume = false; playing = ready && !playing }
        onDrag: {
          swipeDistance = time - swipeLast > 0.25 ? 0 : swipeDistance
          swipeHandled = time - swipeLast > 0.25 ? false : swipeHandled
          swipeLast = time
          swipeDistance = swipeDistance + (abs(dx) > abs(dy) ? dx : 0)
          skipRequested = ready && !swipeHandled && abs(swipeDistance) >= 48 ? (swipeDistance > 0 ? -1 : 1) : 0
          swipeHandled = swipeHandled || skipRequested != 0
        }
        if book.error {
          Text { text: book.error; fontSize: 20; align: center; maxLines: 3; color: red; fill: width }
        } else {
          if playing {
            WordDrawing { animated: true }
          } else {
            WordDrawing { animated: false }
          }
        }
      }
      if expanded && ready {
        Column {
          weight: 3; fill: width; gap: 8; clip: true
          Text { text: "Reading passage"; style: label; color: muted }
          Flow {
            fill: width; weight: 1; gap: 0; clip: true
            for entry, i in passage {
              Text {
                text: entry
                font: mono; fontSize: 12; maxLines: 1
                width: min(availableWidth - 24, len(entry) * 7.32 + 8)
                height: 22; padding: [4, 2]
                color: passageStart + i == (playing ? min(total - 1, origin + floor(max(0, time - started) * wpm / 60)) - chunk * 600 : local) ? background : alpha(foreground, 0.8)
                background: passageStart + i == (playing ? min(total - 1, origin + floor(max(0, time - started) * wpm / 60)) - chunk * 600 : local) ? accent : alpha(surface, 0)
                bold: passageStart + i == local
                onTap: { bookmark = chunk * 600 + passageStart + i; playing = false }
              }
            }
          }
        }
      }
      Canvas {
        fill: width; height: 18
        let position = playing && ready ? min(total - 1, origin + floor(max(0, time - started) * wpm / 60)) : bookmark
        let percent = total > 0 ? (position + 1) / total * 100 : 0
        let labelWidth = min(220, availableWidth * 0.64)
        let trackWidth = max(0, width - labelWidth - 10)
        rect(0, height / 2 - 1.5, trackWidth, 3, fill: surface)
        rect(0, height / 2 - 1.5, trackWidth * percent / 100, 3, fill: accent)
        text("${min(position + 1, total)} / ${total} words · ${round(percent)}%", width, height / 2, size: availableWidth < 350 ? 10 : 12, align: end, color: muted)
      }
    }
  }
  Reader { availableHeight: tileHeight ?? 0; availableWidth: tileWidth ?? 0 }
  screen {
    title: "Spreedy"
    if settings {
      Column {
        fill: true; gap: 16; scroll: true
        Text { text: "Spreedy settings"; style: title }
        Text { text: "${wpm} words per minute"; style: body }
        Slider { value: wpm; min: 60; max: 1000; step: 10; onChange: wpm = value }
        Text { text: "${swipeSeconds} seconds per swipe"; style: body }
        Slider { value: swipeSeconds; min: 1; max: 60; step: 1; onChange: swipeSeconds = value }
        Text { text: "The highlighted, underlined letter stays on the guides as words change."; style: muted; maxLines: 3 }
        Text { text: "EPUB or text file"; style: label }
        Input { text: path; placeholder: "/root/Downloads/book.epub"; onChange: draft = value; onSubmit: { path = trim(value); bookmark = 0; chunk = 0; playing = false; resume = false; refresh(); settings = false } }
        Text { text: "Enter a Linux file path (.epub, .txt, .text or .md). Press the keyboard’s send key or Load file."; style: muted; maxLines: 4 }
        Button { text: "Load file"; onTap: { path = trim(draft == "" ? path : draft); bookmark = 0; chunk = 0; playing = false; resume = false; refresh(); settings = false } }
        Text { text: path == "" ? "Default: Alice’s Adventures in Wonderland, Chapter I, by Lewis Carroll." : path; style: small; maxLines: 3 }
        Button { text: "Use Alice"; onTap: { path = ""; draft = ""; bookmark = 0; chunk = 0; playing = false; resume = false; refresh(); settings = false } }
        Button { text: "Text source · Project Gutenberg"; onTap: url("https://www.gutenberg.org/ebooks/11") }
        if book.error { Text { text: book.error; color: red; maxLines: 4 } }
        Row {
          Button { text: "Read"; onTap: settings = false }
          Button { text: "Restart"; onTap: { bookmark = 0; chunk = 0; playing = false; resume = false; refresh(); settings = false } }
        }
        Spacer { weight: 1 }
      }
    } else { Reader { availableHeight: screenHeight ?? 0; availableWidth: screenWidth ?? 0 } }
  }
  onTap: { settings = false; screen() }
  when !playing && ready && bookmark >= total { bookmark = 0 }
  when !playing && chunk != floor(bookmark / 600) { chunk = floor(bookmark / 600); refresh() }
}
