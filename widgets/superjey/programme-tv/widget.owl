widget "programme tv" {
  size: 3x4
  minSize: 3x3
  meta { description: "What's on every French TNT channel right now, or tonight's prime time from 21:00. Tap it for the full schedule"; version: "1.1"; license: "MIT"; category: "media"; owl: 5 }

  source now = clock every 30s
  // EPG from epg.pw: one small JSON per channel, no key. Times come as UTC ISO.
  source tf1 = http("https://epg.pw/api/epg.json?channel_id=443174") every 30m json timeout 20s
  source f2 = http("https://epg.pw/api/epg.json?channel_id=55812") every 30m json timeout 20s
  source f3 = http("https://epg.pw/api/epg.json?channel_id=55715") every 30m json timeout 20s
  source f4 = http("https://epg.pw/api/epg.json?channel_id=55005") every 30m json timeout 20s
  source f5 = http("https://epg.pw/api/epg.json?channel_id=54935") every 30m json timeout 20s
  source m6 = http("https://epg.pw/api/epg.json?channel_id=485681") every 30m json timeout 20s
  source arte = http("https://epg.pw/api/epg.json?channel_id=55730") every 30m json timeout 20s
  source lcp = http("https://epg.pw/api/epg.json?channel_id=448577") every 30m json timeout 20s
  source w9 = http("https://epg.pw/api/epg.json?channel_id=55815") every 30m json timeout 20s
  source tmc = http("https://epg.pw/api/epg.json?channel_id=55851") every 30m json timeout 20s
  source tfx = http("https://epg.pw/api/epg.json?channel_id=55777") every 30m json timeout 20s
  source gulli = http("https://epg.pw/api/epg.json?channel_id=55873") every 30m json timeout 20s
  source bfmtv = http("https://epg.pw/api/epg.json?channel_id=443114") every 30m json timeout 20s
  source cnews = http("https://epg.pw/api/epg.json?channel_id=51767") every 30m json timeout 20s
  source lci = http("https://epg.pw/api/epg.json?channel_id=459208") every 30m json timeout 20s
  source finfo = http("https://epg.pw/api/epg.json?channel_id=459183") every 30m json timeout 20s
  source cstar = http("https://epg.pw/api/epg.json?channel_id=55905") every 30m json timeout 20s
  source t18 = http("https://epg.pw/api/epg.json?channel_id=435552") every 30m json timeout 20s
  source novo = http("https://epg.pw/api/epg.json?channel_id=443122") every 30m json timeout 20s
  source tf1sf = http("https://epg.pw/api/epg.json?channel_id=459284") every 30m json timeout 20s
  source lequipe = http("https://epg.pw/api/epg.json?channel_id=55938") every 30m json timeout 20s
  source sixter = http("https://epg.pw/api/epg.json?channel_id=54986") every 30m json timeout 20s
  source rmcstory = http("https://epg.pw/api/epg.json?channel_id=54996") every 30m json timeout 20s
  source rmcd = http("https://epg.pw/api/epg.json?channel_id=54916") every 30m json timeout 20s
  source cherie = http("https://epg.pw/api/epg.json?channel_id=443110") every 30m json timeout 20s

  // Which list the screen shows: the programs on air now, or tonight's prime time.
  state view = "now"
  // Tonight's prime time, 21:00 local. `fmtTime` gives local wall-clock parts, so
  // subtracting the time of day from `now` lands on local midnight, whatever the zone.
  let tod = num(fmtTime(now, "H")) * 3600 + num(fmtTime(now, "m")) * 60 + num(fmtTime(now, "s"))
  let tonight = now - tod + 21 * 3600

  let defs = [
    {n: "TF1", s: tf1}, {n: "France 2", s: f2}, {n: "France 3", s: f3},
    {n: "France 4", s: f4}, {n: "France 5", s: f5}, {n: "M6", s: m6},
    {n: "Arte", s: arte}, {n: "LCP", s: lcp}, {n: "W9", s: w9},
    {n: "TMC", s: tmc}, {n: "TFX", s: tfx}, {n: "Gulli", s: gulli},
    {n: "BFM TV", s: bfmtv}, {n: "CNEWS", s: cnews}, {n: "LCI", s: lci},
    {n: "Franceinfo", s: finfo}, {n: "CStar", s: cstar}, {n: "T18", s: t18},
    {n: "NOVO19", s: novo}, {n: "TF1 Séries Films", s: tf1sf}, {n: "L'Équipe", s: lequipe},
    {n: "6ter", s: sixter}, {n: "RMC Story", s: rmcstory}, {n: "RMC Découverte", s: rmcd},
    {n: "Chérie 25", s: cherie}
  ]

  // Each program's ISO date is split into fields, then, in per-channel passes,
  // into a Unix time, so it can be compared with `now`. The JSON has no end
  // time, so the program on air is the last one that started. Parsing per
  // channel (and keeping only a now-4h..now+24h window) keeps every list small,
  // while still holding tonight's 21:00 prime time from any hour of the day.
  let programs = flatten(defs.map(d => (d.s.epg_list ?? [])
    .map(p => { ch: d.n, title: p.title ?? "", desc: p.desc ?? "", g: match(p.start_date ?? "", "(\\d+)-(\\d+)-(\\d+)T(\\d+):(\\d+):(\\d+)") })
    .map(p => { ch: p.ch, title: p.title, desc: p.desc, y: num(p.g[0]), mo: num(p.g[1]), d: num(p.g[2]), H: num(p.g[3]), mi: num(p.g[4]), se: num(p.g[5]) })
    .map(p => { ch: p.ch, title: p.title, desc: p.desc, mo: p.mo, d: p.d, H: p.H, mi: p.mi, se: p.se, y2: p.mo <= 2 ? p.y - 1 : p.y })
    .map(p => { ch: p.ch, title: p.title, desc: p.desc, era: floor(p.y2 / 400), yoe: p.y2 - floor(p.y2 / 400) * 400, mo: p.mo, d: p.d, H: p.H, mi: p.mi, se: p.se })
    .map(p => {
      ch: p.ch, title: p.title, desc: p.desc,
      start: (p.era * 146097 + p.yoe * 365 + floor(p.yoe / 4) - floor(p.yoe / 100) + floor((153 * (p.mo > 2 ? p.mo - 3 : p.mo + 9) + 2) / 5) + p.d - 1 - 719468) * 86400 + p.H * 3600 + p.mi * 60 + p.se
    })
    .filter(p => p.start >= now - 14400 && p.start <= now + 86400)
  ))

  let board = defs.map(d => {
    name: d.n,
    cur: last(programs.filter(p => p.ch == d.n && p.start <= now)),
    next: first(programs.filter(p => p.ch == d.n && p.start > now))
  })
  let offline = all(defs, d => d.s == null)

  onTap: screen()

  component Chan(name, cur, next) {
    Row {
      gap: 8
      align: center
      Text { text: name; style: label; color: red; width: 56; maxLines: 2 }
      Column {
        gap: 1
        weight: 1
        Text { text: cur == null ? "…" : cur.title; style: small; maxLines: 1 }
        if next != null {
          Text { text: "puis ${fmtTime(next.start, "HH:mm")} · ${next.title}"; style: label; color: muted; maxLines: 1 }
        }
      }
    }
  }

  Column {
    gap: 6
    Row {
      fill: width
      align: center
      Text { text: "programme tv"; style: label; color: muted; weight: 1 }
      Text { text: fmtTime(now, "HH:mm"); style: title; color: accent; width: 64 }
    }
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
    if offline {
      Text { text: "guide offline"; style: small; color: muted }
    } else {
      Column {
        gap: 5
        weight: 1
        scroll: true
        for b in board key b.name { Chan { name: b.name; cur: b.cur; next: b.next } }
      }
    }
  }

  screen {
    title: "programme tv"
    Column {
      scroll: true
      gap: 12
      Text { text: fmtTime(now, "EEEE d MMMM"); style: body; maxLines: 1 }
      Row {
        gap: 6
        align: center
        Button { text: "maintenant"; color: view == "now" ? accent : muted; onTap: view = "now" }
        Button { text: "ce soir"; color: view == "soir" ? accent : muted; onTap: view = "soir" }
        Spacer { weight: 1 }
        Text { text: view == "soir" ? "dès 21:00" : ""; style: label; color: accent; width: 70 }
        Button { text: "refresh"; color: muted; onTap: refresh() }
      }
      for d in defs key d.n {
        // "now" starts from the program on air; "soir" from the one on air at 21:00.
        let edge = view == "soir" ? tonight : now
        let cur = last(programs.filter(p => p.ch == d.n && p.start <= edge))
        let list = programs.filter(p => p.ch == d.n && p.start >= (cur == null ? edge : cur.start)).take(6)
        Column {
          gap: 6
          Row {
            gap: 8
            align: center
            Text { text: d.n; style: body; color: red; weight: 1 }
            if d.s == null { Text { text: "offline"; style: label; color: muted; width: 50 } }
          }
          for p, i in list key i {
            let live = p.start <= now
            Column {
              gap: 1
              padding: [0, 2]
              Row {
                gap: 10
                align: top
                Text { text: fmtTime(p.start, "HH:mm"); style: small; font: mono; color: live ? accent : muted; width: 44 }
                Column {
                  gap: 1
                  weight: 1
                  Text { text: p.title; style: small; maxLines: 1; color: live ? foreground : muted; bold: live }
                  if live && p.desc != "" {
                    Text { text: p.desc; style: label; color: muted; maxLines: 2 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
