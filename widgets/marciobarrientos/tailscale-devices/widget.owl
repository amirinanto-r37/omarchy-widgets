widget "tailscale-devices" {
  meta {
    owl: 6
    description: "Lists connected and disconnected Tailscale devices with copy buttons for IP and MagicDNS, plus auto-refresh. Requires a Tailscale API key."
    version: "1.0"
    license: "MIT"
    category: "system"
  }
  asset macOSLogo = base64""
  asset androidLogo = base64""
  asset windowsLogo = base64""
  asset linuxLogo = base64""
  size: 4x4
  minSize: 3x3

  state authorization = "" persist
  state configuring = false
  state updatedAt = 0 persist
  state interval = 0 persist
  state draftInterval = 0
  state draftKey = ""
  state refreshFlash = false
  let configured = authorization != ""
  let authorizationHeader = startsWith(authorization, "Bearer ") || startsWith(authorization, "Basic ") ? authorization : "Bearer ${authorization}"
  source devices = http("https://api.tailscale.com/api/v2/tailnet/-/devices?fields=all", {Authorization: authorizationHeader}) every 24h json timeout 20s status
  source now = clock every 30s
  when interval > 0 && now - updatedAt >= interval {
    updatedAt = now
    refresh()
  }
  on devices { refreshFlash = false }
  on now { refreshFlash = false }
  let data = devices != null && devices.ok ? devices.out : null
  let allDevices = data == null ? [] : (data.devices ?? []).sortBy(device => lower(device.hostname ?? device.name ?? ""))
  let connectedDevices = allDevices.filter(device => device.connectedToControl == true)
  let disconnectedDevices = allDevices.filter(device => device.connectedToControl != true)

  component PeerSummary(device, showDetails = false) {
    let ip = first(device.addresses ?? []) ?? "no IP"
    let hostname = device.hostname ?? ""
    let name = device.name ?? ""
    let machineName = trim(hostname) != "" ? hostname : device.name ?? "unknown device"
    let os = lower(device.os ?? "")
    Column {
      fill: width
      padding: 8
      background: alpha(surface, 0.75)
      radius: 8 * corners
      Row {
        fill: width
        gap: 8
        align: center
        if os == "linux" {
          Image { src: linuxLogo; width: 20; height: 20; fit: contain }
        } else if os == "macos" || os == "ios" {
          Image { src: macOSLogo; width: 20; height: 20; fit: contain; tint: foreground }
        } else if os == "android" {
          Image { src: androidLogo; width: 20; height: 20; fit: contain }
        } else if os == "windows" {
          Image { src: windowsLogo; width: 20; height: 20; fit: contain }
        } else {
          Text { text: "◌"; width: 20; align: center; style: label; color: foreground }
        }
        Column {
          weight: 1
          gap: 2
          Text { text: machineName; style: label; color: foreground; maxLines: 1 }
          if showDetails {
            Text { text: ip; font: mono; style: small; color: muted; maxLines: 1 }
            Text { text: name; style: small; color: muted; maxLines: 2 }
          }
        }
        Box {
          width: 36
          height: 36
          align: center
          background: alpha(accent, 0.12)
          radius: 6 * corners
          onTap: copy(ip)
          Text { text: "IP"; style: small; align: center }
        }
        Box {
          width: 72
          height: 36
          align: center
          background: alpha(accent, 0.12)
          radius: 6 * corners
          onTap: copy(name)
          Text { text: "MagicDNS"; style: small; align: center }
        }
      }
    }
  }

  Column {
    gap: 8
    onTap: screen()
    Row {
      align: center
      Image { src: "app:com.tailscale.ipn"; width: 24; height: 24; fit: contain }
      Text { text: "Tailscale devices"; fontSize: 18; color: foreground; weight: 1; maxLines: 1 }
      Box {
        width: 32
        height: 32
        align: center
        onTap: screen()
        Text { text: "⛶"; fontSize: 18; color: accent; align: center }
      }
    }
    if !configured {
      Box {
        weight: 1
        align: center
        Column {
          fill: width
          gap: 8
          align: center
          Text {
            text: "configuration required"
            style: title
            color: muted
            align: center
            maxLines: 2
          }
          Text { text: "Tap Settings to add your Tailscale credential."; style: small; color: muted; align: center; maxLines: 2 }
          Button { text: "Settings"; onTap: { draftInterval = interval; draftKey = ""; configuring = true; screen() } }
        }
      }
    } else if data != null {
      if len(connectedDevices) == 0 {
        Box {
          weight: 1
          align: center
          Text { text: "No connected devices."; style: small; color: muted; align: center }
        }
      } else {
        Column {
          gap: 6
          weight: 1
          scroll: true
          for device in connectedDevices key device.id {
            PeerSummary { device: device }
          }
        }
      }
    } else {
      Box {
        weight: 1
        align: center
        Column {
          fill: width
          gap: 8
          align: center
          Text {
            text: devices == null ? "checking..." : "API access unavailable"
            style: title
            color: devices == null ? muted : red
            align: center
            maxLines: 2
          }
          Text { text: "Check your credential and tap Refresh."; style: small; color: muted; align: center; maxLines: 2 }
          Button { text: "Settings"; onTap: { draftInterval = interval; draftKey = ""; configuring = true; screen() } }
        }
      }
    }
    Row {
      fill: width
      align: center
      Text { text: updatedAt == 0 ? "Updated at --:--" : "Updated at ${fmtTime(updatedAt, "hh:mm a")}"; style: small; color: muted; weight: 1; maxLines: 1 }
      Box {
        width: 72
        align: center
        padding: [8, 4]
        background: alpha(accent, 0.12)
        radius: 8 * corners
        onTap: androidApp("com.tailscale.ipn")
        Text { text: "Open app"; style: small; color: accent; align: center; maxLines: 1 }
      }
      Box {
        width: 72
        align: center
        padding: [8, 4]
        background: refreshFlash ? alpha(accent, 0.42) : alpha(accent, 0.12)
        radius: 8 * corners
        animate background: tween(160ms, "out")
        onTap: { refreshFlash = true; updatedAt = now; refresh() }
        Text { text: "Refresh"; style: small; color: accent; align: center; maxLines: 1 }
      }
    }
  }

  screen {
    title: "Tailscale devices"
    Column {
      gap: 8
      fill: height
      if !configured || configuring {
        Column {
          weight: 1
          gap: 10
          scroll: true
          Text { text: "Settings"; style: title }
          Text { text: "API key"; style: label }
          Text { text: "Generate an API key in the Tailscale console and paste it here. If you paste only the key, Bearer is added automatically. It is stored only in this launcher."; style: small; color: muted; maxLines: 5 }
          Button { text: "Open Tailscale keys"; onTap: url("https://login.tailscale.com/admin/settings/keys") }
          Input {
            text: draftKey
            placeholder: configured ? "Leave empty to keep the current key" : "tskey-api-... or Bearer ..."
            focus: true
            onChange: draftKey = value
          }
          if configured {
            Button {
              text: "Remove API key"
              color: red
              onTap: { authorization = ""; draftKey = ""; refresh() }
            }
          }
          Text { text: "Auto refresh"; style: label }
          Flow {
            gap: 8
            for opt in [{label: "Manual", value: 0}, {label: "1 min", value: 60}, {label: "5 min", value: 300}, {label: "15 min", value: 900}, {label: "30 min", value: 1800}, {label: "1 hour", value: 3600}] key opt.value {
              Button {
                text: draftInterval == opt.value ? "● ${opt.label}" : opt.label
                color: draftInterval == opt.value ? accent : muted
                onTap: draftInterval = opt.value
              }
            }
          }
        }
        Row {
          fill: width
          gap: 8
          if configured {
            Button { text: "Cancel"; weight: 1; onTap: configuring = false }
          }
          Button {
            text: "Save"
            weight: 1
            onTap: {
              authorization = trim(draftKey) != "" ? trim(draftKey) : authorization
              interval = draftInterval
              configuring = false
              refresh()
            }
          }
        }
      } else {
        Column {
          weight: 1
          gap: 10
          scroll: true
          if data == null {
            Text { text: "Unable to query the API"; style: title; color: red }
            Text { text: "The credential may have expired or lack access to this tailnet."; color: muted; maxLines: 2 }
          } else if len(allDevices) == 0 {
            Text { text: "There are no devices in this tailnet."; color: muted }
          } else {
            Column {
              gap: 24
              if len(connectedDevices) > 0 {
                Column {
                  gap: 8
                  Text { text: "Connected"; style: label; color: green }
                  for device in connectedDevices key device.id {
                    PeerSummary { device: device; showDetails: true }
                  }
                }
              }
              if len(disconnectedDevices) > 0 {
                Column {
                  gap: 8
                  Text { text: "Disconnected"; style: label; color: muted }
                  for device in disconnectedDevices key device.id {
                    PeerSummary { device: device; showDetails: true }
                  }
                }
              }
            }
          }
        }
        Text { text: updatedAt == 0 ? "Updated at --:--" : "Updated at ${fmtTime(updatedAt, "hh:mm a")}"; style: small; color: muted; maxLines: 1 }
        Row {
          fill: width
          gap: 8
          Button { text: "Open app"; weight: 1; onTap: androidApp("com.tailscale.ipn") }
          Button { text: "Refresh"; weight: 1; onTap: { updatedAt = now; refresh() } }
          Button { text: "Settings"; weight: 1; onTap: { draftInterval = interval; draftKey = ""; configuring = true } }
        }
      }
    }
  }
}
