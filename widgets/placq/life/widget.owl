widget "every day counts" {
  size: 6x1
  minSize: 2x1
  padding: [10, 6]

  meta { owl: 5; description: "Life elapsed and remaining as a pixel-segment timeline."; version: "1.1"; license: "MIT"; category: "time" }
  requires { pacman: [] }

  // No shell commands or additional packages.
  state birthYear = "" persist
  state lifespan = "80" persist
  source now = clock every 1m
  let thisYear = num(fmtTime(now, "yyyy"))
  let year = num(birthYear, 0)
  let limit = num(lifespan, 0)
  let valid = year >= 1900 && year <= thisYear && limit > 0 && limit <= 150
  let current = thisYear + (num(fmtTime(now, "MM")) - 1) / 12 + (num(fmtTime(now, "dd")) - 1) / 365.2425
  let elapsed = max(0, current - year)
  let percent = clamp(elapsed / max(1, limit) * 100, 0, 100)

  onTap: screen()

  Column {
    fill: true
    gap: 3
    justify: center
    if valid {
      Canvas {
        fill: width
        height: 30
        let labelSize = width < 180 ? 10 : 13
        let mottoSize = clamp((width - 68) / 12, 4, 11)
        text("${fixed(percent, 1)}%", 0, 8, size: labelSize, color: foreground)
        text("Every day counts", width / 2, 8, size: mottoSize, align: center, color: muted)
        text("${fixed(100 - percent, 1)}%", width, 8, size: labelSize, align: end, color: accent)
        let segments = max(1, floor(width / 7))
        let step = width / segments
        let filled = round(percent / 100 * segments)
        for i in range(segments) {
          rect(i * step, 24, step - 2, 5, fill: i < filled ? accent : surface)
        }
      }
    } else {
      Text { text: "Life · tap to set up"; fontSize: 12; maxLines: 2 }
    }
  }

  screen {
    title: "Life settings"
    Column {
      fill: true
      scroll: true
      gap: 16
      Text { text: "Birth year"; style: label }
      Input { text: birthYear; placeholder: "e.g. 1995"; onChange: birthYear = value }
      Text { text: "Expected lifespan (years)"; style: label }
      Input { text: lifespan; placeholder: "e.g. 80"; onChange: lifespan = value }
      if !valid {
        Text { text: "Birth year: 1900–${thisYear}. Lifespan: 1–150."; color: yellow; maxLines: 3 }
      }
      Button { text: "Done"; onTap: close() }
    }
  }
}
