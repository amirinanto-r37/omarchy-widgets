widget "snes" {
  // Your SNES ROM folder: put .sfc/.smc games in ~/roms/snes, or use the
  // screen's "add games" to receive them from the phone. The helper programs
  // live under ~/.cache/owl-snes/tools and are written by this widget itself.
  page: 1
  order: 5
  size: 4x4
  minSize: 3x3
  meta { owl: 6; description: "Your SNES games: finds .sfc/.smc ROMs in ~/roms/snes and opens one in RetroArch with the Snes9x core, on a portrait handheld with the game centred and touch buttons below. Send games from your phone"; version: "1.3"; license: "MIT"; category: "games" }

  requires { pacman: ["retroarch", "libretro-snes9x", "python", "python-pillow", "curl", "util-linux", "xdg-utils", "ttf-dejavu"] }

  // List the ROMs one per line as "name|bytes|path"; keep it listable without jq.
  source lib = cmd("""
    shopt -s globstar nullglob
    for p in ~/roms/snes/**/*.{sfc,smc,fig,swc} ~/ROMs/snes/**/*.{sfc,smc,fig,swc} ~/.local/share/roms/snes/**/*.{sfc,smc,fig,swc}; do
      [ -f "$p" ] || continue
      b=$(basename "$p")
      n=$(echo "$b" | sed 's/[.][^.]*$//')
      echo "$n|$(stat -c %s "$p")|$p"
    done
  """) every 5m

  let roms = lines(lib).filter(l => l != "").map(l => { name: split(l, "|")[0], size: num(split(l, "|")[1]), path: split(l, "|")[2] }).sortBy(r => lower(r.name))
  let count = len(roms)

  // The helper programs live under ~/.cache/owl-snes/tools. This widget
  // writes them, in full and fixed, so this file is all the widget needs and
  // a reviewer reads exactly what runs. Nothing here is personal.
  source helpers = cmd("""
d="$HOME/.cache/owl-snes/tools"; mkdir -p "$d"
if [ ! -s "$d/romget" ]; then cat > "$d/romget.tmp" <<'OWL_ROMGET_END'
#!/bin/sh
# omalauncher: download a game file from a URL into a widget's folder.
#   romget <url> [dest_dir] [name]
# dest_dir defaults to ~/roms/snes. Prints the saved path.
url="$1"
dest="${2:-$HOME/roms/snes}"
[ -n "$url" ] || { echo "usage: romget <url> [dest_dir] [name]" >&2; exit 2; }
mkdir -p "$dest" || exit 1
name="$3"
[ -n "$name" ] || name=$(basename "${url%%\?*}")
[ -n "$name" ] || name=download.bin
case "$name" in */*|"") name=download.bin ;; esac
out="$dest/$name"
i=1
while [ -e "$out" ]; do
  base="${name%.*}"; ext="${name##*.}"
  [ "$ext" = "$name" ] && out="$dest/$base.$i" || out="$dest/$base.$i.$ext"
  i=$((i + 1))
done
if curl -fL --retry 3 --connect-timeout 15 -o "$out.part" "$url"; then
  mv "$out.part" "$out"
  echo "saved $out"
else
  rm -f "$out.part"
  echo "download failed: $url" >&2
  exit 1
fi
OWL_ROMGET_END
chmod +x "$d/romget.tmp"; mv -f "$d/romget.tmp" "$d/romget"; fi
if [ ! -s "$d/romupload" ]; then cat > "$d/romupload.tmp" <<'OWL_ROMUPLOAD_END'
#!/usr/bin/env python3
'''omalauncher: receive game files into the folder a widget scans.

Run it in the guest, open the printed URL in the phone's browser, pick the files
with Android's own picker (it can browse internal storage), and they land in the
destination folder. The guest shares the phone's loopback, so this crosses the
sandbox without adb, a server app, or the internet.

The loopback is shared with every other app, so the server also defends itself:
it mints a random token per run, only answers / and /upload when the link carries
it, and stops after a spell with no request.

Config (environment):
  ROMUPLOAD_DEST        where uploads are saved   (default ~/roms/snes)
  ROMUPLOAD_PORT        TCP port to listen on     (default 8123)
  ROMUPLOAD_BIND        address to bind           (default 127.0.0.1)
  ROMUPLOAD_TITLE       heading on the page       (default "add game files to Linux")
  ROMUPLOAD_TOKEN       fixed access token        (default: random, one per run)
  ROMUPLOAD_TOKEN_FILE  write the token here      (default: none)
  ROMUPLOAD_IDLE        stop after this many idle seconds (default 900, 0 = never)
'''
import hmac
import http.server
import os
import secrets
import signal
import sys
import threading
import time
import urllib.parse
from pathlib import Path

DEST = Path(os.environ.get("ROMUPLOAD_DEST") or "~/roms/snes").expanduser()
PORT = int(os.environ.get("ROMUPLOAD_PORT", "8123"))
BIND = os.environ.get("ROMUPLOAD_BIND", "127.0.0.1")
TITLE = os.environ.get("ROMUPLOAD_TITLE", "add game files to Linux")
TOKEN = os.environ.get("ROMUPLOAD_TOKEN") or secrets.token_urlsafe(16)
TOKEN_FILE = os.environ.get("ROMUPLOAD_TOKEN_FILE")
IDLE = int(os.environ.get("ROMUPLOAD_IDLE", "900"))

_last = time.monotonic()


def touch():
    global _last
    _last = time.monotonic()


PAGE = '''<!doctype html>
<html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<style>
 body{{font-family:ui-monospace,monospace;background:#1a1b26;color:#c0caf5;margin:0;padding:24px;line-height:1.5}}
 h1{{font-size:18px;color:#7aa2f7;margin:0 0 4px}}
 .p{{color:#565f89;font-size:13px;word-break:break-all;margin-bottom:20px}}
 label{{display:block;background:#24283b;border:1px dashed #7aa2f7;border-radius:12px;
        padding:28px 16px;text-align:center;font-size:16px;color:#7aa2f7}}
 input{{display:none}}
 ul{{list-style:none;padding:0;font-size:13px}}
 li{{padding:8px 4px;border-bottom:1px solid #24283b;word-break:break-all}}
 .ok{{color:#9ece6a}} .err{{color:#f7768e}} .wait{{color:#e0af68}}
</style></head><body>
<h1>{title}</h1>
<div class="p">saving into <b>{dest}</b> &nbsp;&middot;&nbsp; {existing} file(s) there now</div>
<label for="f">tap to choose files<br><small>pick from Internal storage</small></label>
<input id="f" type="file" multiple>
<ul id="list"></ul>
<script>
const token = new URLSearchParams(location.search).get('t') || '';
const list = document.getElementById('list');
document.getElementById('f').onchange = async (e) => {{
  for (const file of e.target.files) {{
    const li = document.createElement('li');
    li.className = 'wait';
    li.textContent = file.name + ' \u2014 uploading\u2026';
    list.append(li);
    try {{
      const r = await fetch('/upload?t=' + encodeURIComponent(token) + '&name=' + encodeURIComponent(file.name), {{method:'POST', body:file}});
      const t = await r.text();
      li.className = r.ok ? 'ok' : 'err';
      li.textContent = file.name + ' \u2014 ' + t;
    }} catch (err) {{
      li.className = 'err';
      li.textContent = file.name + ' \u2014 failed: ' + err;
    }}
  }}
  e.target.value = '';
}};
</script>
</body></html>
'''


def unique(name: str) -> Path:
    name = os.path.basename(name).replace("/", "_").strip() or "unnamed"
    target = DEST / name
    if not target.exists():
        return target
    base, ext = os.path.splitext(name)
    i = 1
    while target.exists():
        target = DEST / f"{base}.{i}{ext}"
        i += 1
    return target


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _send(self, code: int, body: bytes, ctype="text/plain; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self, query: str) -> bool:
        given = (urllib.parse.parse_qs(query).get("t") or [""])[0]
        return hmac.compare_digest(given, TOKEN)

    def _forbidden(self):
        self._send(403, b"forbidden: open the link the widget gave you, and don't share it")

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        if u.path != "/":
            self._send(404, b"not found")
            return
        if not self._authorized(u.query):
            self._forbidden()
            return
        touch()
        existing = len([p for p in DEST.iterdir() if p.is_file()]) if DEST.is_dir() else 0
        self._send(200, PAGE.format(title=TITLE, dest=DEST, existing=existing).encode(), "text/html; charset=utf-8")

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        if u.path != "/upload":
            self._send(404, b"not found")
            return
        if not self._authorized(u.query):
            self._forbidden()
            return
        touch()
        name = (urllib.parse.parse_qs(u.query).get("name") or [""])[0]
        total = int(self.headers.get("Content-Length") or 0)
        target = unique(name)
        written = 0
        with open(target, "wb") as out:
            left = total
            while left > 0:
                chunk = self.rfile.read(min(65536, left))
                if not chunk:
                    break
                out.write(chunk)
                written += len(chunk)
                left -= len(chunk)
        print(f"+ {target.name} ({written} bytes)", flush=True)
        self._send(200, f"saved {target.name}".encode())


def main():
    DEST.mkdir(parents=True, exist_ok=True)
    try:
        server = http.server.ThreadingHTTPServer((BIND, PORT), Handler)
    except OSError as e:
        print(f"can't listen on {BIND}:{PORT}: {e}", file=sys.stderr, flush=True)
        return 1

    pid = Path(f"/tmp/romupload-{PORT}.pid")
    pid.write_text(str(os.getpid()))
    token_path = Path(TOKEN_FILE).expanduser() if TOKEN_FILE else None
    if token_path:
        token_path.parent.mkdir(parents=True, exist_ok=True)
        tmp = token_path.with_name(token_path.name + ".tmp")
        tmp.write_text(TOKEN)
        os.chmod(tmp, 0o600)
        tmp.replace(token_path)
    print(f"serving on http://{BIND}:{PORT}/?t={TOKEN}  ->  {DEST}", flush=True)

    def watchdog():
        while True:
            time.sleep(min(IDLE, 30))
            if time.monotonic() - _last > IDLE:
                print(f"no request for {IDLE}s, stopping", flush=True)
                server.shutdown()
                return

    def stop(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    if IDLE > 0:
        threading.Thread(target=watchdog, daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        for f in (pid, token_path):
            if f is not None:
                try:
                    f.unlink()
                except OSError:
                    pass
    print("stopped", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
OWL_ROMUPLOAD_END
chmod +x "$d/romupload.tmp"; mv -f "$d/romupload.tmp" "$d/romupload"; fi
if [ ! -s "$d/play" ]; then cat > "$d/play.tmp" <<'OWL_PLAY_END'
#!/usr/bin/env bash
# Launch a game in RetroArch with the handheld overlay.
#
# A widget cannot frame a Linux game (it runs as its own Android task), so
# RetroArch draws the handheld shell and touch buttons from assets/handheld.
# Video/audio are forced through an appendconfig because this compositor has
# no Vulkan and RetroArch would otherwise pick it.
#
# Usage: play <snes|gba> <rom-path>
set -euo pipefail

kind="${1:?usage: play <snes|gba> <rom-path>}"
rom="${2:?usage: play <snes|gba> <rom-path>}"

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
case "$kind" in
  snes) core=/usr/lib/libretro/snes9x_libretro.so ;;
  gba)  core=/usr/lib/libretro/mgba_libretro.so ;;
  *)    echo "play: unknown kind: $kind" >&2; exit 2 ;;
esac

ovl="$(dirname "$here")/assets/handheld/$kind.overlay.cfg"
[ -f "$ovl" ] || python3 "$here/handheldgen" "$kind" >/dev/null

# The Linux game window is 540x1114 logical pixels (1080x2228 at the
# compositor's wl_output scale 2; the system bars take the rest of the
# 1080x2392 screen). Without this RetroArch reads the 1080x2392 mode as
# logical and renders at 2x, which looks massively zoomed in.
FS_W="${RETROARCH_FS_W:-540}"
FS_H="${RETROARCH_FS_H:-1114}"

cfg="$HOME/.cache/omalauncher/retroarch-$kind.cfg"
mkdir -p "$(dirname "$cfg")"
cat > "$cfg" <<EOF
video_driver = "gl"
audio_driver = "pulse"
config_save_on_exit = "false"
video_fullscreen = "true"
video_fullscreen_x = "$FS_W"
video_fullscreen_y = "$FS_H"
aspect_ratio_index = "22"
input_overlay_enable = "true"
input_overlay = "$ovl"
input_overlay_opacity = "1.0"
input_overlay_hide_in_menu = "true"
input_overlay_scale_landscape = "1.0"
input_overlay_scale_portrait = "1.0"
EOF

# app() runs this under `exec` with no timeout, so the game lives until closed.
# Keep RetroArch's noisy log out of the launcher's pipe.
exec retroarch --appendconfig "$cfg" -L "$core" "$rom" >"$HOME/.cache/omalauncher/retroarch-$kind.log" 2>&1 </dev/null
OWL_PLAY_END
chmod +x "$d/play.tmp"; mv -f "$d/play.tmp" "$d/play"; fi
if [ ! -s "$d/handheldgen" ]; then cat > "$d/handheldgen.tmp" <<'OWL_HANDHELD_END'
#!/usr/bin/env python3
'''Generate a portrait handheld-bezel overlay for a RetroArch core.

A widget cannot draw a frame around a Linux game (the game runs as its own
Android task), so RetroArch draws the "handheld" shell itself: we emit a
transparent-centred PNG plus a RetroArch overlay .cfg whose touch buttons sit
over the printed controls.  tools/play points RetroArch at the result.

Sizing: the game window is the launcher's Linux-window area, 540x1114 logical
pixels at wl_output scale 2, i.e. a 1080x2228 pixel render surface (the system
bars take the rest of the 1080x2392 screen).  tools/play sets
video_fullscreen_x/y to that logical size, so RetroArch's framebuffer is
1080x2228 and this overlay, stretched full-screen by overlay0_full_screen, maps
1:1 onto it.

The game keeps its core aspect and RetroArch centres it and fits it to the
width, so the transparent hole is a full-width band in the vertical middle and
the touch controls sit in the strip below it.

Usage: handheldgen <snes|gba>
Writes assets/handheld/<kind>.png and <kind>.overlay.cfg inside this widget's cache dir.
'''
import os
import sys

from PIL import Image, ImageDraw, ImageFont

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "assets", "handheld")

# The Linux game window's render surface (see module docstring).
W, H = 1080, 2228

BODY = (22, 24, 30, 255)
BODY_HI = (38, 41, 50, 255)
BEZEL = (5, 6, 9, 255)
INK = (205, 210, 220, 255)
DIM = (120, 126, 140, 255)
FACE = (58, 62, 72, 255)
FACE_HI = (86, 91, 104, 255)
ACCENT = (232, 88, 88, 255)

# kind -> core aspect (width / height) and label
LAYOUTS = {
    "snes": {"aspect": 4 / 3, "label": "SUPER NES", "accent": ACCENT},
    "gba": {"aspect": 240 / 160, "label": "GAME BOY ADVANCE", "accent": (120, 92, 220, 255)},
}


def font(size, bold=True):
    name = "DejaVuSans-Bold.ttf" if bold else "DejaVuSans.ttf"
    path = os.path.join("/usr/share/fonts/TTF", name)
    try:
        return ImageFont.truetype(path, size)
    except Exception:  # pragma: no cover
        return ImageFont.load_default()


def controls(kind):
    '''Control geometry, shared between the art and the touch descriptors.

    Positions are pixels of the 1080x2228 overlay image (== the framebuffer).
    '''
    aspect = LAYOUTS[kind]["aspect"]
    hole_h = int(round(W / aspect))
    y0 = (H - hole_h) // 2
    y1 = y0 + hole_h
    mid = (y1 + H) // 2
    c = {
        "hole": (0, y0, W, y1),
        "dpad": (250, mid, 200, 76),  # cx, cy, s, bar
        "l": (190, y1 + 70, 240, 116),  # cx, cy, w, h
        "r": (890, y1 + 70, 240, 116),
        "select": (370, H - 86, 250, 104),
        "start": (710, H - 86, 250, 104),
    }
    if kind == "snes":
        c["snes_btn"] = (830, mid, 118, 82)  # cx, cy, offset, radius
    else:
        c["gba_a"] = (955, mid + 95, 96)  # cx, cy, radius
        c["gba_b"] = (805, mid - 55, 96)
    return c


def pill(draw, cx, cy, w, h, label=None, fill=FACE):
    box = (cx - w // 2, cy - h // 2, cx + w // 2, cy + h // 2)
    draw.rounded_rectangle(box, radius=h // 2, fill=fill)
    draw.rounded_rectangle(box, radius=h // 2, outline=FACE_HI, width=4)
    if label:
        f = font(44)
        bb = draw.textbbox((0, 0), label, font=f)
        draw.text((cx - (bb[2] - bb[0]) / 2 - bb[0], cy - (bb[3] - bb[1]) / 2 - bb[1]),
                  label, font=f, fill=INK)


def circle(draw, cx, cy, r, label=None, fill=FACE):
    draw.ellipse((cx - r, cy - r, cx + r, cy + r), fill=fill)
    draw.ellipse((cx - r, cy - r, cx + r, cy + r), outline=FACE_HI, width=5)
    if label:
        f = font(int(r * 1.2))
        bb = draw.textbbox((0, 0), label, font=f)
        draw.text((cx - (bb[2] - bb[0]) / 2 - bb[0], cy - (bb[3] - bb[1]) / 2 - bb[1]),
                  label, font=f, fill=INK)


def dpad(draw, cx, cy, s, bar):
    h = (cx - s, cy - bar, cx + s, cy + bar)
    v = (cx - bar, cy - s, cx + bar, cy + s)
    for box in (h, v):
        draw.rounded_rectangle(box, radius=26, fill=FACE)
        draw.rounded_rectangle(box, radius=26, outline=FACE_HI, width=4)


def descriptors(kind):
    '''Return (key, value) pairs, key relative to `overlay0_`.'''
    c = controls(kind)
    out = []

    def desc(name, value):
        idx = sum(1 for k, _ in out if k.startswith("desc") and "_" not in k)
        out.append((f"desc{idx}", f'"{name},{value}"'))
        return idx

    # For rect, range is the distance from the centre to the edge (half-size).
    dx, dy, ds, _ = c["dpad"]
    desc("dpad_area", f"{dx},{dy},rect,{ds},{ds}")

    if kind == "snes":
        cx, cy, off, r = c["snes_btn"]
        i = desc("abxy_area", f"{cx},{cy},rect,{off + r},{off + r}")
        out.append((f"desc{i}_up", '"x"'))
        out.append((f"desc{i}_down", '"b"'))
        out.append((f"desc{i}_left", '"y"'))
        out.append((f"desc{i}_right", '"a"'))
    else:
        ax, ay, ar = c["gba_a"]
        bx, by, br = c["gba_b"]
        # radial range is the radius; radial circles are fine for digital buttons.
        desc("a", f"{ax},{ay},radial,{ar},{ar}")
        desc("b", f"{bx},{by},radial,{br},{br}")

    lx, ly, lw, lh = c["l"]
    rx, ry, rw, rh = c["r"]
    sx, sy, sw, sh = c["select"]
    tx, ty, tw, th = c["start"]
    desc("l", f"{lx},{ly},rect,{lw // 2},{lh // 2}")
    desc("r", f"{rx},{ry},rect,{rw // 2},{rh // 2}")
    desc("select", f"{sx},{sy},rect,{sw // 2},{sh // 2}")
    desc("start", f"{tx},{ty},rect,{tw // 2},{th // 2}")
    return out


def build(kind):
    spec = LAYOUTS[kind]
    c = controls(kind)
    x0, y0, x1, y1 = c["hole"]
    img = Image.new("RGBA", (W, H), BODY)
    draw = ImageDraw.Draw(img)

    # vertical gradient shell
    for y in range(H):
        t = y / H
        col = tuple(int(BODY_HI[i] * (1 - t) + BODY[i] * t) for i in range(3))
        draw.line([(0, y), (W, y)], fill=col + (255,))

    # punch the transparent game window and hug it with a black bezel
    mask = Image.new("L", (W, H), 255)
    ImageDraw.Draw(mask).rectangle((x0, y0, x1, y1), fill=0)
    img.putalpha(mask)
    draw = ImageDraw.Draw(img)
    draw.rectangle((x0 - 10, y0 - 40, x1 + 10, y0), fill=BEZEL)
    draw.rectangle((x0 - 10, y1, x1 + 10, y1 + 40), fill=BEZEL)

    # brand in the top strip, speaker dots under it
    f = font(46)
    label = spec["label"]
    bb = draw.textbbox((0, 0), label, font=f)
    draw.text(((W - (bb[2] - bb[0])) / 2 - bb[0], y0 * 0.55), label, font=f, fill=DIM)
    for i in range(-3, 4):
        draw.ellipse((W / 2 + i * 34 - 7, y0 * 0.82 - 7, W / 2 + i * 34 + 7, y0 * 0.82 + 7), fill=BODY_HI)

    dx, dy, ds, dbar = c["dpad"]
    dpad(draw, dx, dy, ds, dbar)
    lx, ly, lw, lh = c["l"]
    rx, ry, rw, rh = c["r"]
    pill(draw, lx, ly, lw, lh, "L")
    pill(draw, rx, ry, rw, rh, "R")
    sx, sy, sw, sh = c["select"]
    tx, ty, tw, th = c["start"]
    pill(draw, sx, sy, sw, sh, "SELECT")
    pill(draw, tx, ty, tw, th, "START")
    if kind == "snes":
        cx, cy, off, r = c["snes_btn"]
        circle(draw, cx, cy - off, r, "X")
        circle(draw, cx - off, cy, r, "Y")
        circle(draw, cx + off, cy, r, "A")
        circle(draw, cx, cy + off, r, "B")
    else:
        ax, ay, ar = c["gba_a"]
        bx, by, br = c["gba_b"]
        circle(draw, ax, ay, ar, "A", fill=spec["accent"])
        circle(draw, bx, by, br, "B")

    return img, (x0, y0, x1, y1)


def write(kind):
    img, hole = build(kind)
    os.makedirs(OUT, exist_ok=True)
    png = os.path.join(OUT, f"{kind}.png")
    img.save(png)
    cfg = os.path.join(OUT, f"{kind}.overlay.cfg")
    descs = descriptors(kind)
    n = sum(1 for k, _ in descs if k.startswith("desc") and "_" not in k)
    with open(cfg, "w") as fh:
        fh.write("overlays = 1\n")
        fh.write(f'overlay0_overlay = "{png}"\n')
        fh.write('overlay0_full_screen = "true"\n')
        fh.write(f"overlay0_descs = {n}\n")
        for k, v in descs:
            fh.write(f"overlay0_{k} = {v}\n")
    print(f"{kind}: {png} ({img.size[0]}x{img.size[1]}), hole {hole}, {n} controls")


if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in LAYOUTS:
        sys.exit(f"usage: {os.path.basename(sys.argv[0])} <{'|'.join(LAYOUTS)}>")
    write(sys.argv[1])
OWL_HANDHELD_END
chmod +x "$d/handheldgen.tmp"; mv -f "$d/handheldgen.tmp" "$d/handheldgen"; fi
""") every 1h

  state urlText = ""

  component Play(path) {
    Button { text: "▶ play"; color: accent; onTap: app("""exec "$HOME/.cache/owl-snes/tools/play" snes """ + sh(path)) }
  }

  onTap: screen()

  Column {
    gap: 8
    Row {
      align: center
      gap: 8
      Text { text: "SNES"; style: title; weight: 1 }
      Text { text: count == 0 ? "" : count == 1 ? "1 game" : "${count} games"; style: label; color: muted }
    }
    Canvas {
      fill: width
      height: 118
      let w = width
      let h = height
      let hx = w * 0.16
      let hy = h * 0.16
      let hw = w * 0.68
      let hh = h * 0.46
      let dx = w * 0.22
      let dy = h * 0.80
      let dt = min(w, h) * 0.055
      let da = min(w, h) * 0.11
      rect(2, 2, w - 4, h - 4, radius: 8 * corners, fill: surface, stroke: border, width: 2)
      rect(hx, hy, hw, hh, radius: 4 * corners, fill: background, stroke: border, width: 1.5)
      rect(hx + hw * 0.06, hy + hh * 0.12, hw * 0.88, hh * 0.76, radius: 2 * corners, fill: color0)
      text("SNES", hx + hw / 2, hy + hh / 2, size: h * 0.16, align: center, color: muted)
      rect(dx - da, dy - dt, da * 2, dt * 2, radius: dt, fill: muted)
      rect(dx - dt, dy - da, dt * 2, da * 2, radius: dt, fill: muted)
      rect(w * 0.44, h * 0.72, w * 0.07, h * 0.035, radius: 6 * corners, fill: muted)
      rect(w * 0.52, h * 0.72, w * 0.07, h * 0.035, radius: 6 * corners, fill: muted)
      circle(w * 0.72, h * 0.86, min(w, h) * 0.055, fill: cyan)
      circle(w * 0.84, h * 0.78, min(w, h) * 0.055, fill: red)
    }
    if count == 0 {
      Column {
        weight: 1
        justify: center
        gap: 8
        Text { text: "no games yet"; style: body; color: muted }
        Button { text: "add games from the phone"; color: accent; onTap: screen() }
      }
    } else {
      Column {
        weight: 1
        gap: 6
        scroll: true
        for r in roms key r.path {
          Row {
            align: center
            gap: 8
            padding: [8, 8]
            radius: 8 * corners
            background: alpha(surface, 0.55)
            Text { text: r.name; fontSize: 14; maxLines: 1; weight: 1 }
            Button { text: "play"; color: accent; onTap: app("""exec "$HOME/.cache/owl-snes/tools/play" snes """ + sh(r.path)) }
            onTap: app("""exec "$HOME/.cache/owl-snes/tools/play" snes """ + sh(r.path))
          }
        }
      }
    }
  }

  screen {
    title: "SNES"
    Column {
      scroll: true
      gap: 10
      Row {
        align: center
        gap: 8
        Text { text: "SNES"; style: title; weight: 1 }
        Text { text: count == 0 ? "no games" : count == 1 ? "1 game" : "${count} games"; style: muted }
        Button { text: "rescan"; color: muted; onTap: refresh() }
      }
      Canvas {
        fill: width
        height: 220
        let w = width
        let h = height
        let hx = w * 0.15
        let hy = h * 0.16
        let hw = w * 0.70
        let hh = h * 0.44
        let dx = w * 0.22
        let dy = h * 0.82
        let dt = min(w, h) * 0.09
        let da = min(w, h) * 0.14
        rect(4, 4, w - 8, h - 8, radius: 12 * corners, fill: surface, stroke: border, width: 2)
        rect(hx, hy, hw, hh, radius: 6 * corners, fill: background, stroke: border, width: 1.5)
        rect(hx + hw * 0.06, hy + hh * 0.12, hw * 0.88, hh * 0.76, radius: 3 * corners, fill: color0)
        text("SNES", hx + hw / 2, hy + hh / 2, size: h * 0.16, align: center, color: muted)
        rect(dx - da, dy - dt, da * 2, dt * 2, radius: dt, fill: muted)
        rect(dx - dt, dy - da, dt * 2, da * 2, radius: dt, fill: muted)
        rect(w * 0.44, h * 0.72, w * 0.07, h * 0.04, radius: 6 * corners, fill: muted)
        rect(w * 0.53, h * 0.72, w * 0.07, h * 0.04, radius: 6 * corners, fill: muted)
        circle(w * 0.72, h * 0.86, min(w, h) * 0.08, fill: cyan)
        circle(w * 0.86, h * 0.78, min(w, h) * 0.08, fill: red)
      }
      Text { text: "retroarch + the snes9x core. tap play on a game: the game shows centred on a portrait handheld with touch controls below it."; style: small; color: muted; maxLines: 3 }

      if count == 0 {
        Text { text: "no games found. add some below."; style: small; color: muted; maxLines: 3 }
      } else {
        for r in roms key r.path {
          Row {
            align: center
            gap: 10
            padding: 12
            radius: 8 * corners
            background: alpha(surface, 0.5)
            Column {
              weight: 1
              gap: 2
              Text { text: r.name; fontSize: 15; maxLines: 1 }
              Text { text: fmtBytes(r.size); fontSize: 11; color: muted }
            }
            Play { path: r.path }
          }
        }
      }

      // Add games from the phone: the browser picker can browse Internal storage.
      Text { text: "add games"; style: label; color: accent; padding: [0, 10, 0, 0] }
      Button { text: "pick files in the browser"; color: accent; onTap: run("""url=http://127.0.0.1:8123
tok="$HOME/.cache/owl-snes/romupload-token"
if ! curl -s -o /dev/null --max-time 1 "$url/"; then
  ROMUPLOAD_DEST="$HOME/roms/snes" ROMUPLOAD_PORT=8123 ROMUPLOAD_TITLE='add SNES games' ROMUPLOAD_TOKEN_FILE="$tok" setsid "$HOME/.cache/owl-snes/tools/romupload" >"$HOME/.cache/owl-snes/romupload.log" 2>&1 &
  n=0; until [ -s "$tok" ] || [ "$n" -ge 30 ]; do sleep 0.5; n=$((n+1)); done
fi
xdg-open "$url/?t=$(cat "$tok" 2>/dev/null)"
""") }
      Text { text: "the phone's file picker can browse Internal storage; pick .sfc/.smc files."; style: small; color: muted; maxLines: 3 }
      Text { text: "or download from a link"; style: small; color: muted; padding: [0, 6, 0, 0] }
      Row {
        gap: 6
        Input { weight: 1; placeholder: "https://…/game.sfc"; onChange: urlText = value }
        if urlText != "" {
          Button { text: "get"; onTap: run("""exec "$HOME/.cache/owl-snes/tools/romget" """ + sh(urlText) + " $HOME/roms/snes") }
        }
      }
      Button { text: "close"; color: muted; onTap: close() }
    }
  }
}
