widget "dog of the day" {
  page: 1
  order: 3
  size: 3x4
  minSize: 2x3
  padding: 0

  meta { owl: 6; description: "A random dog every day from the dog.ceo collection, with its breed. Tap the tile for another dog, or open it for the dogs of past days."; version: "1.1"; license: "MIT"; category: "fun" }

  // dog.ceo is free, key-less and covers ~165 breeds with many photos each.
  // curl fetches one dog a day into ~/.cache/dogapi and keeps it until tomorrow,
  // so the phone wakes up to the same dog; tapping the tile (`seed`) fetches a
  // new one. Past dogs are kept in `hist` for the screen.
  requires { pacman: ["curl", "jq"] }

  state seed = 0 persist
  state hist = [] persist

  source dog = cmd("c=$HOME/.cache/dogapi; mkdir -p \"$c\"; find \"$c\" -maxdepth 1 \\( -name '*.jpg' -o -name '*.json' \\) -mtime +1 -delete 2>/dev/null; day=$(date +%F); tag=\"$day-${int(seed)}\"; f=\"$c/$tag.jpg\"; meta=\"$c/$tag.json\"; if [ ! -s \"$f\" ] || [ \"$(cat \"$c/tag\" 2>/dev/null)\" != \"$tag\" ]; then got=$(curl -fsm 10 \"https://dog.ceo/api/breeds/image/random\" 2>/dev/null); url=$(printf '%s' \"$got\" | jq -r '.message // empty' 2>/dev/null); if [ -n \"$url\" ] && curl -fsm 25 -o \"$f\" \"$url\" 2>/dev/null; then b=$(printf '%s' \"$url\" | sed -n 's#.*/breeds/\\([^/]*\\)/.*#\\1#p' | tr '-' ' '); printf '%s' \"$tag\" > \"$c/tag\"; jq -nc --arg breed \"$b\" --arg path \"$f\" --arg url \"$url\" --arg day \"$day\" '{day:$day, breed:$breed, path:$path, url:$url}' > \"$meta\"; fi; fi; [ -s \"$meta\" ] || meta=$(ls -t \"$c\"/*.json 2>/dev/null | head -1); cat \"$meta\" 2>/dev/null; true") every 30m json timeout 40s

  // Remember each day's dog once. `when` catches the first one, `on` the rest;
  // one entry per day, newest first.
  when dog != null { hist = ([{d: dog.day, b: dog.breed, u: dog.url}] + hist.filter(h => h.d != dog.day)).take(60) }
  on dog { hist = ([{d: value.day, b: value.breed, u: value.url}] + hist.filter(h => h.d != value.day)).take(60) }

  let has = dog != null && dog.path != null
  // Title-case "terrier yorkshire" to "Terrier Yorkshire"; close enough.
  let pretty = has ? split(lower(dog.breed ?? ""), " ").map(w => upper(sub(w, 0, 1)) + sub(w, 1)).join(" ") : "finding a dog…"

  // Tap the tile to open the history; "another" there fetches a new dog.
  onTap: screen()

  Box {
    fill: true
    radius: 8 * corners
    clip: true
    background: surface

    if has {
      Image { src: dog.path; fit: cover; fill: true }
    } else {
      Box {
        fill: true
        align: center
        Text { text: "fetching a dog…"; style: muted; align: center }
      }
    }

    // A scrim so the breed stays readable on any photo.
    Canvas {
      let h = 96
      rect(0, height - h, width, h, fill: linear(0, height - h, 0, height, [alpha(background, 0), alpha(background, 0.88)]))
    }

    Column {
      fill: true
      justify: end
      padding: 12
      gap: 2
      Text { text: pretty; style: title; maxLines: 1 }
      Text { text: "dog of the day${has ? " · " + dog.day : ""}"; style: small; color: muted; maxLines: 1 }
    }
  }

  component Heading(text) { Text { text: text; style: label; color: accent } }

  screen {
    title: "dog of the day"
    Column {
      gap: 10
      fill: true

      Box {
        fill: width
        height: 280
        radius: 8 * corners
        clip: true
        background: surface
        align: center
        if has {
          Image { src: dog.path; fit: contain; fill: true }
        } else {
          Text { text: "fetching a dog…"; style: muted }
        }
      }

      Row {
        align: center
        gap: 8
        Column {
          weight: 1
          gap: 0
          Text { text: pretty; style: title; maxLines: 1 }
          Text { text: has ? "dog of the day · " + dog.day : "dog of the day"; style: small; color: muted; maxLines: 1 }
        }
        Button { text: "another"; onTap: seed = seed + 1 }
      }

      Column {
        scroll: true
        weight: 1
        gap: 6
        Heading { text: "recent dogs" }
        if len(hist) == 0 {
          Text { text: "no history yet"; style: small; color: muted }
        }
        for h in hist key h.d {
          Row {
            align: center
            gap: 8
            onTap: url(h.u)
            Text { text: h.d; fontSize: 11; color: muted; width: 84 }
            Text { text: split(lower(h.b ?? ""), " ").map(w => upper(sub(w, 0, 1)) + sub(w, 1)).join(" "); fontSize: 12; weight: 1; maxLines: 1 }
          }
        }
      }
    }
  }
}
